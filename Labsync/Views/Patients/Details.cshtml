@model LabSync.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>LabSync - Patient Details</title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" />


    <style>

            /* =====================================================
                       TOPBAR
                    ====================================================== */

            .topbar {
                height: 85px;
                background: #ffffff;
                border-bottom: 1px solid #e8e5ef;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                padding: 0 28px;
            }

            .topbar-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                justify-content: flex-end;
            }


            /* =====================================================
                       PROFILE
                    ====================================================== */

            .profile {
                border: none;
                background: transparent;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 0 5px 8px;
                cursor: pointer;
            }

                .profile:focus {
                    box-shadow: none;
                }

                .profile::after {
                    margin-left: 5px;
                    color: #8f899d;
                }

            .profile-avatar {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                font-weight: 700;
                box-shadow: 0 7px 18px rgba(139, 92, 246, 0.28);
            }

            .profile-info {
                display: flex;
                flex-direction: column;
                text-align: left;
                line-height: 1.2;
            }

                .profile-info strong {
                    color: #29243a;
                    font-size: 15px;
                    font-weight: 700;
                }

                .profile-info small {
                    color: #9993a8;
                    font-size: 12px;
                    margin-top: 3px;
                }


            /* =====================================================
                       PROFILE DROPDOWN
                    ====================================================== */

            .profile-dropdown {
                margin-top: 10px !important;
                min-width: 220px;
                border: 1px solid #eeeaf5;
                border-radius: 12px;
                padding: 8px;
                box-shadow: 0 12px 30px rgba(30, 20, 50, 0.12);
            }

                .profile-dropdown .dropdown-item {
                    border-radius: 8px;
                    padding: 10px 12px;
                    color: #514b61;
                    font-size: 14px;
                }

                    .profile-dropdown .dropdown-item:hover {
                        background: #f5efff;
                        color: #7c3aed;
                    }

                    .profile-dropdown .dropdown-item i {
                        width: 22px;
                        margin-right: 6px;
                    }

                .profile-dropdown .logout-item {
                    color: #dc2626;
                }

                    .profile-dropdown .logout-item:hover {
                        background: #fef2f2;
                        color: #dc2626;
                    }


            /* =====================================================
                       PATIENT DETAILS CONTENT
                    ====================================================== */

            .patient-details-content {
                padding: 30px;
            }


            /* =====================================================
                       PAGE HEADER
                    ====================================================== */

            .patient-details-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 28px;
            }

            .patient-details-header-left {
                display: flex;
                flex-direction: column;
            }

            .patient-details-small-title {
                margin: 0 0 4px;
                color: #9b96a8;
                font-size: 13px;
                font-weight: 600;
            }

            .patient-details-title {
                margin: 0;
                color: #18213a;
                font-size: 36px;
                font-weight: 700;
                line-height: 1.15;
                letter-spacing: -0.6px;
            }

            .patient-details-subtitle {
                margin: 7px 0 0;
                color: #9296aa;
                font-size: 16px;
                line-height: 1.5;
            }
            /* Brand */
            .brand-icon {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                border-radius: 0;
                flex-shrink: 0;
            }

                .brand-icon img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }

            /* =====================================================
                       BACK BUTTON
                    ====================================================== */

            .patient-header-actions {
                display: flex;
                align-items: center;
            }

            .patient-back-button {
                min-height: 46px;
                padding: 0 17px;
                border-radius: 10px;
                border: 1px solid #dedbe6;
                background: #ffffff;
                color: #5f596c;
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                transition: .2s ease;
            }

                .patient-back-button:hover {
                    background: #f7f4fb;
                    color: #7c3aed;
                    border-color: #d5c5f5;
                }


            /* =====================================================
                       MAIN PATIENT CARD
                    ====================================================== */

            .patient-main-card {
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(30, 20, 50, .04);
            }


            /* =====================================================
                       PATIENT CARD HEADER
                    ====================================================== */

            .patient-card-header {
                padding: 23px 25px;
                border-bottom: 1px solid #eeeaf3;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .patient-card-header-left {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .patient-main-avatar {
                width: 52px;
                height: 52px;
                border-radius: 14px;
                background: linear-gradient( 135deg, #f0e8ff, #f6efff );
                color: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 23px;
                flex-shrink: 0;
            }

            .patient-card-name {
                color: #29243a;
                font-size: 19px;
                font-weight: 700;
                margin: 0 0 4px;
            }

            .patient-card-code {
                color: #9993a8;
                font-size: 13px;
                margin: 0;
            }

            .patient-code-highlight {
                color: #7c3aed;
                font-weight: 700;
            }


            /* =====================================================
                       DETAIL GRID
                    ====================================================== */

            .patient-details-body {
                padding: 25px;
            }

            .patient-detail-box {
                height: 100%;
                padding: 17px 18px;
                background: #ffffff;
                border: 1px solid #e9e5ef;
                border-radius: 12px;
                transition: .2s ease;
            }

                .patient-detail-box:hover {
                    border-color: #d8caf2;
                    box-shadow: 0 4px 14px rgba(139, 92, 246, .05);
                }

            .patient-detail-label {
                display: block;
                margin-bottom: 6px;
                color: #9892a6;
                font-size: 12px;
                font-weight: 600;
            }

            .patient-detail-value {
                margin: 0;
                color: #302b40;
                font-size: 14px;
                font-weight: 600;
                line-height: 1.4;
                word-break: break-word;
            }


            /* =====================================================
                       SPECIAL VALUE
                    ====================================================== */

            .patient-detail-code {
                color: #7c3aed;
                font-weight: 700;
            }

            .patient-detail-blood {
                display: inline-flex;
                align-items: center;
                padding: 6px 10px;
                background: #fff0f0;
                color: #d83f4b;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 700;
            }


            /* =====================================================
                       SECTION TITLE
                    ====================================================== */

            .details-section-title {
                margin: 3px 0 18px;
                color: #302b40;
                font-size: 15px;
                font-weight: 700;
            }


            /* =====================================================
                       MOBILE
                    ====================================================== */

            @@media (max-width: 900px) {

                .patient-details-header {
                    flex-direction: column;
                    gap: 18px;
                }

                .patient-header-actions {
                    align-self: flex-start;
                }
            }


            @@media (max-width: 700px) {

                .topbar {
                    padding: 0 15px;
                }

                .profile-info {
                    display: none;
                }

                .patient-details-content {
                    padding: 20px 15px;
                }

                .patient-details-title {
                    font-size: 28px;
                }

                .patient-details-subtitle {
                    font-size: 14px;
                }

                .patient-header-actions {
                    width: 100%;
                }

                .patient-back-button {
                    width: 100%;
                }

                .patient-card-header {
                    align-items: flex-start;
                }
            }

    </style>

</head>


<body>

    <div class="dashboard-page">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- BRAND -->

            <div class="brand">

                <div class="brand-icon">
                    <img src="~/images/Logo.png"
                         alt="LabSync Logo" />
                </div>

                <div>

                    <h4>
                        LabSync
                    </h4>

                    <small>
                        Diagnostic Management
                    </small>

                </div>

            </div>


            <!-- SIDEBAR MENU -->

            <div class="sidebar-menu">


                <!-- MAIN MENU -->

                <p class="menu-title">
                    MAIN MENU
                </p>


                <!-- DASHBOARD -->

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- USERS -->

                <a asp-controller="Users"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <!-- PATIENTS -->

                <a asp-controller="Patients"
                   asp-action="Index"
                   class="menu-item active">

                    <i class="bi bi-person-vcard-fill"></i>

                    <span>
                        Patients
                    </span>

                </a>


                <!-- APPOINTMENTS -->

                <a asp-controller="Admin"
                   asp-action="AppointmentDetails"
                   class="menu-item">

                    <i class="bi bi-calendar-check-fill"></i>

                    <span>
                        Appointments
                    </span>

                </a>


                <!-- TESTS -->

                <a asp-controller="Tests"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-eyedropper"></i>

                    <span>
                        Tests
                    </span>

                </a>


                <!-- REFERRAL DOCTORS -->

                <a asp-controller="ReferralDoctors"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-person-badge-fill"></i>

                    <span>
                        Referral Doctors
                    </span>

                </a>


                <!-- OPERATIONS -->

                <p class="menu-title mt-4">
                    OPERATIONS
                </p>


                <!-- REPORTS -->

                <a asp-controller="Reports"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-file-earmark-medical-fill"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <!-- INVOICES -->

                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-receipt-cutoff"></i>

                    <span>
                        Invoices
                    </span>

                </a>


                <!-- PAYMENTS -->

                <a asp-controller="Payments"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-credit-card-fill"></i>

                    <span>
                        Payments
                    </span>

                </a>


                <!-- ANALYTICS -->

                <a asp-controller="Admin"
                   asp-action="Analytics"
                   class="menu-item">

                    <i class="bi bi-bar-chart-fill"></i>

                    <span>
                        Analytics
                    </span>

                </a>


                <!-- AUDIT LOGS -->

                <a asp-controller="Admin"
                   asp-action="AuditLogs"
                   class="menu-item">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


              

            </div>

        </aside>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <main class="dashboard-main">


            <!-- =================================================
                 TOPBAR
            ================================================== -->

            <header class="topbar">


                <!-- ADMIN PROFILE -->

                <div class="topbar-right">


                    <div class="dropdown">


                        <button class="profile dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">


                            <!-- AVATAR -->

                            <div class="profile-avatar">
                                A
                            </div>


                            <!-- ADMIN INFO -->

                            <div class="profile-info">

                                <strong>
                                    Admin
                                </strong>

                                <small>
                                    Administrator
                                </small>

                            </div>

                        </button>


                        <!-- PROFILE DROPDOWN -->

                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">


                            

                            <!-- LOGOUT -->

                            <li>

                                <form asp-controller="Admin"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item logout-item">

                                        <i class="bi bi-box-arrow-right"></i>

                                        Logout

                                    </button>

                                </form>

                            </li>


                        </ul>

                    </div>

                </div>

            </header>


            <!-- =================================================
                 PATIENT DETAILS CONTENT
            ================================================== -->

            <div class="patient-details-content">


                <!-- =================================================
                     PAGE HEADER
                ================================================== -->

                <div class="patient-details-header">


                    <div class="patient-details-header-left">

                        <p class="patient-details-small-title">
                            Patient Management
                        </p>

                        <h1 class="patient-details-title">
                            Patient Details
                        </h1>

                        <p class="patient-details-subtitle">
                            View complete information about this patient.
                        </p>

                    </div>


                    <!-- BACK BUTTON ONLY -->

                    <div class="patient-header-actions">

                        <a asp-controller="Patients"
                           asp-action="Index"
                           class="patient-back-button">

                            <i class="bi bi-arrow-left"></i>

                            Back to Patients

                        </a>

                    </div>

                </div>


                <!-- =================================================
                     MAIN PATIENT CARD
                ================================================== -->

                <div class="patient-main-card">


                    <!-- =================================================
                         CARD HEADER
                    ================================================== -->

                    <div class="patient-card-header">


                        <div class="patient-card-header-left">


                            <div class="patient-main-avatar">

                                <i class="bi bi-person-fill"></i>

                            </div>


                            <div>

                                <h5 class="patient-card-name">

                                    @Model.FirstName @Model.LastName

                                </h5>


                                <p class="patient-card-code">

                                    Patient Code:

                                    <span class="patient-code-highlight">

                                        @(Model.PatientCode ?? "-")

                                    </span>

                                </p>

                            </div>


                        </div>


                    </div>


                    <!-- =================================================
                         DETAILS BODY
                    ================================================== -->

                    <div class="patient-details-body">


                        <!-- PERSONAL INFORMATION -->

                        <h6 class="details-section-title">
                            Personal Information
                        </h6>


                        <div class="row g-3 mb-4">


                            <!-- FULL NAME -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Full Name
                                    </span>

                                    <p class="patient-detail-value">

                                        @Model.FirstName @Model.LastName

                                    </p>

                                </div>

                            </div>


                            <!-- PATIENT CODE -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Patient Code
                                    </span>

                                    <p class="patient-detail-value patient-detail-code">

                                        @(Model.PatientCode ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- PHONE -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Phone
                                    </span>

                                    <p class="patient-detail-value">

                                        @(Model.Phone ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- EMAIL -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Email
                                    </span>

                                    <p class="patient-detail-value">

                                        @(Model.Email ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- GENDER -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Gender
                                    </span>

                                    <p class="patient-detail-value">

                                        @(Model.Gender ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- DATE OF BIRTH -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Date of Birth
                                    </span>

                                    <p class="patient-detail-value">

                                        @(
                                            Model.DateOfBirth.HasValue
                                                ? Model.DateOfBirth.Value.ToString("dd MMM yyyy")
                                                : "-"
                                        )

                                    </p>

                                </div>

                            </div>


                            <!-- BLOOD GROUP -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Blood Group
                                    </span>

                                    <p class="patient-detail-value">

                                        @if (!string.IsNullOrWhiteSpace(
                                            Model.BloodGroup))
                                        {

                                            <span class="patient-detail-blood">

                                                @Model.BloodGroup

                                            </span>

                                        }
                                        else
                                        {

                                            <span>
                                                -
                                            </span>

                                        }

                                    </p>

                                </div>

                            </div>


                            <!-- MARITAL STATUS -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Marital Status
                                    </span>

                                    <p class="patient-detail-value">

                                        @(Model.MaritalStatus ?? "-")

                                    </p>

                                </div>

                            </div>


                        </div>


                        <!-- ADDITIONAL INFORMATION -->

                        <h6 class="details-section-title">
                            Additional Information
                        </h6>


                        <div class="row g-3">


                            <!-- RELIGION -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Religion
                                    </span>

                                    <p class="patient-detail-value">

                                        @(Model.Religion ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- OCCUPATION -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Occupation
                                    </span>

                                    <p class="patient-detail-value">

                                        @(Model.Occupation ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- FATHER NAME -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Father Name
                                    </span>

                                    <p class="patient-detail-value">

                                        @(Model.FatherName ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- MOTHER NAME -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Mother Name
                                    </span>

                                    <p class="patient-detail-value">

                                        @(Model.MotherName ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- NID -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        NID
                                    </span>

                                    <p class="patient-detail-value">

                                        @(Model.NID ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- REGISTERED DATE -->

                            <div class="col-md-6">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Registered Date
                                    </span>

                                    <p class="patient-detail-value">

                                        @(
                                            Model.CreatedAt.HasValue
                                                ? Model.CreatedAt.Value.ToString("dd MMM yyyy")
                                                : "-"
                                        )

                                    </p>

                                </div>

                            </div>


                            <!-- ADDRESS -->

                            <div class="col-12">

                                <div class="patient-detail-box">

                                    <span class="patient-detail-label">
                                        Address
                                    </span>

                                    <p class="patient-detail-value">

                                        @(Model.Address ?? "-")

                                    </p>

                                </div>

                            </div>


                        </div>


                    </div>

                </div>

            </div>

        </main>

    </div>


    <!-- =====================================================
         BOOTSTRAP JS
    ====================================================== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>