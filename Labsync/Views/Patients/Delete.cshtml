@model LabSync.Models.Patient

@{
    ViewData["Title"] = "Delete Patient";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>LabSync - Delete Patient</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>
    <div class="dashboard-page">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="brand">
                <div class="brand-icon">
                    <i class="bi bi-beaker-fill"></i>
                </div>

                <div>
                    <h4>LabSync</h4>
                    <small>Diagnostic Management</small>
                </div>
            </div>

            <div class="sidebar-menu">

                <p class="menu-title">MAIN MENU</p>

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Users"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-people-fill"></i>
                    <span>Users</span>
                </a>

                <a asp-controller="Patients"
                   asp-action="Index"
                   class="menu-item active">
                    <i class="bi bi-person-vcard-fill"></i>
                    <span>Patients</span>
                </a>

                <a asp-controller="Appointments"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-calendar-check-fill"></i>
                    <span>Appointments</span>
                </a>

                <a asp-controller="Tests"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-eyedropper"></i>
                    <span>Tests</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Referral Doctors</span>
                </a>

                <p class="menu-title mt-4">OPERATIONS</p>

                <a asp-controller="Reports"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-file-earmark-medical-fill"></i>
                    <span>Reports</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>Invoices</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="bi bi-credit-card-fill"></i>
                    <span>Payments</span>
                </a>

                <a asp-controller="Admin"
                   asp-action="Analytics"
                   class="menu-item">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>Analytics</span>
                </a>

            </div>
        </aside>

        <!-- Main Content -->
        <main class="dashboard-main">

            <!-- Topbar -->
            <header class="topbar">

                <div></div>

                <div class="topbar-right">

                    <div class="profile-avatar">
                        A
                    </div>

                    <div class="profile-info">
                        <strong>Admin</strong>
                        <small>Administrator</small>
                    </div>

                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="dashboard-content">

                <!-- Welcome Section -->
                <div class="welcome-section">

                    <div>
                        <p class="welcome-small">
                            Patient Management
                        </p>

                        <h1>
                            Delete Patient
                        </h1>

                        <p class="welcome-description">
                            Remove a patient record from the system.
                        </p>
                    </div>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to Patients
                    </a>

                </div>

                <!-- Delete Confirmation Card -->
                <div class="dashboard-card mt-4">

                    <div class="p-5 text-center">

                        <!-- Warning Icon -->
                        <div class="mb-4">

                            <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle"
                                 style="width:80px;height:80px;background:#fff1f2;">

                                <i class="bi bi-exclamation-triangle-fill text-danger"
                                   style="font-size:35px;">
                                </i>

                            </div>

                        </div>

                        <h3>
                            Are you sure?
                        </h3>

                        <p class="text-muted">
                            You are about to delete this patient.
                            This action cannot be undone.
                        </p>

                        <!-- Patient Information -->
                        <div class="border rounded p-4 mt-4 mb-4 text-start">

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <small class="text-muted">
                                        Patient Name
                                    </small>

                                    <h6 class="mb-0">
                                        @Model.FirstName @Model.LastName
                                    </h6>

                                </div>

                                <div class="col-md-6">

                                    <small class="text-muted">
                                        Patient Code
                                    </small>

                                    <h6 class="mb-0">
                                        @(Model.PatientCode ?? "-")
                                    </h6>

                                </div>

                                <div class="col-md-6">

                                    <small class="text-muted">
                                        Phone
                                    </small>

                                    <h6 class="mb-0">
                                        @(Model.Phone ?? "-")
                                    </h6>

                                </div>

                                <div class="col-md-6">

                                    <small class="text-muted">
                                        Gender
                                    </small>

                                    <h6 class="mb-0">
                                        @(Model.Gender ?? "-")
                                    </h6>

                                </div>

                            </div>
                        </div>

                        <!-- Delete Form -->
                        <form asp-action="DeleteConfirmed" method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4 me-2">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4">
                                <i class="bi bi-trash me-2"></i>
                                Yes, Delete Patient
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </main>

    </div>
</body>
</html>