@model LabSync.Models.Patient

@{
    ViewData["Title"] = "Add Patient";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>LabSync - Add Patient</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />
</head>

<body>

    <div class="dashboard-page">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                <div class="brand-icon">
                    <i class="bi bi-beaker-fill"></i>
                </div>

                <div>
                    <h4>LabSync</h4>
                    <small>Diagnostic Management</small>
                </div>
            </div>

            <div class="sidebar-menu">

                <p class="menu-title">MAIN MENU</p>

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Users"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-people-fill"></i>
                    <span>Users</span>
                </a>

                <a asp-controller="Patients"
                   asp-action="Index"
                   class="menu-item active">
                    <i class="bi bi-person-vcard-fill"></i>
                    <span>Patients</span>
                </a>

                <a asp-controller="Appointments"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-calendar-check-fill"></i>
                    <span>Appointments</span>
                </a>

                <a asp-controller="Tests"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-eyedropper"></i>
                    <span>Tests</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Referral Doctors</span>
                </a>

                <p class="menu-title mt-4">OPERATIONS</p>

                <a asp-controller="Reports"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-file-earmark-medical-fill"></i>
                    <span>Reports</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>Invoices</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="bi bi-credit-card-fill"></i>
                    <span>Payments</span>
                </a>

                <a asp-controller="Admin"
                   asp-action="Analytics"
                   class="menu-item">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>Analytics</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="bi bi-clock-history"></i>
                    <span>Audit Logs</span>
                </a>

            </div>

            

        </aside>


        <!-- MAIN -->
        <main class="dashboard-main">

            <header class="topbar">

                <div></div>

                <div class="topbar-right">

                    <div class="profile-avatar">
                        A
                    </div>

                    <div class="profile-info">
                        <strong>Admin</strong>
                        <small>Administrator</small>
                    </div>

                </div>

            </header>


            <div class="dashboard-content">

                <!-- HEADER -->

                <div class="welcome-section">

                    <div>

                        <p class="welcome-small">
                            Patient Management
                        </p>

                        <h1>
                            Add New Patient
                        </h1>

                        <p class="welcome-description">
                            Register a new patient in the LabSync system.
                        </p>

                    </div>

                    <div>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-2"></i>
                            Back to Patients

                        </a>

                    </div>

                </div>


                <!-- FORM CARD -->

                <div class="dashboard-card mt-4">

                    <div class="card-header-custom">

                        <div>

                            <h5>
                                Patient Information
                            </h5>

                            <span>
                                Enter the patient's information below.
                            </span>

                        </div>

                    </div>


                    <div class="p-4">

                        <form asp-action="Create"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>


                            <!-- BASIC INFORMATION -->

                            <h6 class="mb-3">
                                <i class="bi bi-person-fill me-2"></i>
                                Basic Information
                            </h6>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label asp-for="FirstName"
                                           class="form-label">
                                        First Name *
                                    </label>

                                    <input asp-for="FirstName"
                                           class="form-control"
                                           placeholder="Enter first name" />

                                    <span asp-validation-for="FirstName"
                                          class="text-danger">
                                    </span>

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="LastName"
                                           class="form-label">
                                        Last Name *
                                    </label>

                                    <input asp-for="LastName"
                                           class="form-control"
                                           placeholder="Enter last name" />

                                    <span asp-validation-for="LastName"
                                          class="text-danger">
                                    </span>

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="PatientCode"
                                           class="form-label">
                                        Patient Code
                                    </label>

                                    <input asp-for="PatientCode"
                                           class="form-control"
                                           placeholder="Leave empty for auto generation" />

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="DateOfBirth"
                                           class="form-label">
                                        Date of Birth
                                    </label>

                                    <input asp-for="DateOfBirth"
                                           type="date"
                                           class="form-control" />

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="Gender"
                                           class="form-label">
                                        Gender
                                    </label>

                                    <select asp-for="Gender"
                                            class="form-select">

                                        <option value="">
                                            Select Gender
                                        </option>

                                        <option value="Male">
                                            Male
                                        </option>

                                        <option value="Female">
                                            Female
                                        </option>

                                        <option value="Other">
                                            Other
                                        </option>

                                    </select>

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="BloodGroup"
                                           class="form-label">
                                        Blood Group
                                    </label>

                                    <select asp-for="BloodGroup"
                                            class="form-select">

                                        <option value="">
                                            Select Blood Group
                                        </option>

                                        <option value="A+">A+</option>
                                        <option value="A-">A-</option>
                                        <option value="B+">B+</option>
                                        <option value="B-">B-</option>
                                        <option value="AB+">AB+</option>
                                        <option value="AB-">AB-</option>
                                        <option value="O+">O+</option>
                                        <option value="O-">O-</option>

                                    </select>

                                </div>

                            </div>


                            <hr class="my-4" />


                            <!-- CONTACT -->

                            <h6 class="mb-3">
                                <i class="bi bi-telephone-fill me-2"></i>
                                Contact Information
                            </h6>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label asp-for="Phone"
                                           class="form-label">
                                        Phone
                                    </label>

                                    <input asp-for="Phone"
                                           class="form-control"
                                           placeholder="01XXXXXXXXX" />

                                    <span asp-validation-for="Phone"
                                          class="text-danger">
                                    </span>

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="Email"
                                           class="form-label">
                                        Email
                                    </label>

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="example@gmail.com" />

                                    <span asp-validation-for="Email"
                                          class="text-danger">
                                    </span>

                                </div>


                                <div class="col-12">

                                    <label asp-for="Address"
                                           class="form-label">
                                        Address
                                    </label>

                                    <textarea asp-for="Address"
                                              class="form-control"
                                              rows="3"
                                              placeholder="Enter address"></textarea>

                                </div>

                            </div>


                            <hr class="my-4" />


                            <!-- PERSONAL INFORMATION -->

                            <h6 class="mb-3">
                                <i class="bi bi-info-circle-fill me-2"></i>
                                Personal Information
                            </h6>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label asp-for="Religion"
                                           class="form-label">
                                        Religion
                                    </label>

                                    <input asp-for="Religion"
                                           class="form-control"
                                           placeholder="Enter religion" />

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="MaritalStatus"
                                           class="form-label">
                                        Marital Status
                                    </label>

                                    <select asp-for="MaritalStatus"
                                            class="form-select">

                                        <option value="">
                                            Select Status
                                        </option>

                                        <option value="Single">
                                            Single
                                        </option>

                                        <option value="Married">
                                            Married
                                        </option>

                                        <option value="Divorced">
                                            Divorced
                                        </option>

                                        <option value="Widowed">
                                            Widowed
                                        </option>

                                    </select>

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="FatherName"
                                           class="form-label">
                                        Father Name
                                    </label>

                                    <input asp-for="FatherName"
                                           class="form-control" />

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="MotherName"
                                           class="form-label">
                                        Mother Name
                                    </label>

                                    <input asp-for="MotherName"
                                           class="form-control" />

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="NID"
                                           class="form-label">
                                        NID
                                    </label>

                                    <input asp-for="NID"
                                           class="form-control"
                                           placeholder="National ID number" />

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="Occupation"
                                           class="form-label">
                                        Occupation
                                    </label>

                                    <input asp-for="Occupation"
                                           class="form-control"
                                           placeholder="Enter occupation" />

                                </div>

                            </div>


                            <!-- BUTTONS -->

                            <div class="d-flex justify-content-end gap-2 mt-4">

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary">

                                    Cancel

                                </a>

                                <button type="submit"
                                        class="btn btn-primary">

                                    <i class="bi bi-person-plus-fill me-2"></i>
                                    Add Patient

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>