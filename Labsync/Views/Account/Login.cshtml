@model LabSync.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - LabSync</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body>

    <div class="login-page">

        <div class="login-container">

            <!-- ================= LEFT SIDE ================= -->

            <div class="login-form-section">

                <div class="login-box">

                    <!-- TITLE -->

                    <div class="login-title">

                        <div class="login-logo">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>

                        <h3>Welcome Back</h3>

                        <p>
                            Sign in to continue to LabSync
                        </p>

                    </div>


                    <!-- LOGIN FORM -->

                    <form asp-action="Login"
                          asp-controller="Account"
                          method="post">


                        <!-- EMAIL -->

                        <div class="input-group-custom">

                            <i class="bi bi-envelope-fill input-icon"></i>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Email"
                                   autocomplete="email" />

                        </div>

                        <span asp-validation-for="Email"
                              class="validation-text">
                        </span>


                        <!-- PASSWORD -->

                        <div class="input-group-custom">

                            <i class="bi bi-lock-fill input-icon"></i>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Password"
                                   autocomplete="current-password" />

                        </div>

                        <span asp-validation-for="Password"
                              class="validation-text">
                        </span>


                        <!-- ROLE -->

                        <div class="input-group-custom role-group">

                            <i class="bi bi-person-badge-fill input-icon"></i>

                            <select asp-for="Role"
                                    class="form-select">

                                <option value="">
                                    Select your role
                                </option>

                                <option value="Admin">
                                    Admin
                                </option>

                                <option value="Receptionist">
                                    Receptionist
                                </option>

                                <option value="LabTechnician">
                                    Lab Technician
                                </option>

                            </select>

                        </div>

                        <span asp-validation-for="Role"
                              class="validation-text">
                        </span>


                        <!-- ERROR -->

                        <div asp-validation-summary="ModelOnly"
                             class="validation-text mb-3">
                        </div>


                        <!-- LOGIN BUTTON -->

                        <button type="submit"
                                class="btn login-btn">

                            <i class="bi bi-box-arrow-in-right me-2"></i>

                            LOGIN

                        </button>

                    </form>

                </div>

            </div>


            <!-- ================= RIGHT SIDE ================= -->

            <div class="login-image-section">

                <img src="~/images/login-image.jpg"
                     alt="LabSync"
                     class="login-image" />


                <!-- IMAGE CONTENT -->

                <div class="image-overlay">

                    <span class="welcome-badge">

                        <i class="bi bi-stars"></i>

                        LabSync

                    </span>

                    <h2>
                        Smarter Diagnostic<br />
                        Management
                    </h2>

                    <p>
                        Manage patients, appointments,
                        laboratory tests and reports
                        with ease.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
