@model LabSync.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
    Layout = null;

    var displayDue = Math.Max(0, Model.DueAmount);
    var paidAmount = Model.PaidAmount ?? 0;

    var invoiceStatus =
        displayDue <= 0
            ? "Paid"
            : paidAmount > 0
                ? "Partial"
                : "Unpaid";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>LabSync - Invoice Details</title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" />


    <style>

            /* =====================================================
                       PAGE / MAIN
                    ====================================================== */

            .dashboard-page {
                min-height: 100vh;
            }

            .dashboard-main {
                min-height: 100vh;
            }

            /* Brand */
            .brand-icon {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                border-radius: 0;
                flex-shrink: 0;
            }

                .brand-icon img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }
            /* =====================================================
                       TOPBAR
                    ====================================================== */

            .topbar {
                height: 85px;
                background: #ffffff;
                border-bottom: 1px solid #e8e5ef;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                padding: 0 28px;
            }

            .topbar-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                justify-content: flex-end;
            }


            /* =====================================================
                       PROFILE
                    ====================================================== */

            .profile {
                border: none;
                background: transparent;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 0 5px 8px;
                cursor: pointer;
            }

                .profile:focus {
                    box-shadow: none;
                }

                .profile::after {
                    margin-left: 5px;
                    color: #8f899d;
                }

            .profile-avatar {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                font-weight: 700;
                box-shadow: 0 7px 18px rgba(139, 92, 246, 0.28);
            }

            .profile-info {
                display: flex;
                flex-direction: column;
                text-align: left;
                line-height: 1.2;
            }

                .profile-info strong {
                    color: #29243a;
                    font-size: 15px;
                    font-weight: 700;
                }

                .profile-info small {
                    color: #9993a8;
                    font-size: 12px;
                    margin-top: 3px;
                }


            /* =====================================================
                       PROFILE DROPDOWN
                    ====================================================== */

            .profile-dropdown {
                margin-top: 10px !important;
                min-width: 220px;
                border: 1px solid #eeeaf5;
                border-radius: 12px;
                padding: 8px;
                box-shadow: 0 12px 30px rgba(30, 20, 50, 0.12);
            }

                .profile-dropdown .dropdown-item {
                    border-radius: 8px;
                    padding: 10px 12px;
                    color: #514b61;
                    font-size: 14px;
                }

                    .profile-dropdown .dropdown-item:hover {
                        background: #f5efff;
                        color: #7c3aed;
                    }

                    .profile-dropdown .dropdown-item i {
                        width: 22px;
                        margin-right: 6px;
                    }

                .profile-dropdown .logout-item {
                    color: #dc2626;
                }

                    .profile-dropdown .logout-item:hover {
                        background: #fef2f2;
                        color: #dc2626;
                    }


            /* =====================================================
                       INVOICE DETAILS CONTENT
                    ====================================================== */

            .invoice-details-content {
                padding: 30px;
            }


            /* =====================================================
                       PAGE HEADER
                    ====================================================== */

            .invoice-details-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 28px;
            }

            .invoice-details-title {
                margin: 0;
                color: #18213a;
                font-size: 36px;
                font-weight: 700;
                line-height: 1.15;
                letter-spacing: -0.6px;
            }

            .invoice-details-subtitle {
                margin: 7px 0 0;
                color: #9296aa;
                font-size: 16px;
                line-height: 1.5;
            }


            /* =====================================================
                       BACK BUTTON
                    ====================================================== */

            .invoice-back-button {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 11px 16px;
                border: 1px solid #e8e5ef;
                border-radius: 10px;
                background: #ffffff;
                color: #514b61;
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                transition: .2s ease;
            }

                .invoice-back-button:hover {
                    background: #f5efff;
                    border-color: #d8c7f8;
                    color: #7c3aed;
                }


            /* =====================================================
                       MAIN DETAILS CARD
                    ====================================================== */

            .invoice-details-card {
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(30, 20, 50, 0.04);
            }


            /* =====================================================
                       CARD HEADER
                    ====================================================== */

            .invoice-details-card-header {
                padding: 22px 24px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid #eeeaf3;
            }

            .invoice-card-title-area {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .invoice-card-icon {
                width: 50px;
                height: 50px;
                border-radius: 14px;
                background: #f1eaff;
                color: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 21px;
                flex-shrink: 0;
            }

            .invoice-card-title-area h5 {
                margin: 0 0 5px;
                color: #29243a;
                font-size: 18px;
                font-weight: 700;
            }

            .invoice-card-title-area span {
                color: #9993a8;
                font-size: 13px;
            }


            /* =====================================================
                       STATUS
                    ====================================================== */

            .invoice-status {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 7px 11px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 700;
            }

                .invoice-status.paid {
                    background: #dcfce7;
                    color: #159447;
                }

                .invoice-status.partial {
                    background: #fff7df;
                    color: #b98100;
                }

                .invoice-status.unpaid {
                    background: #fee2e2;
                    color: #dc2626;
                }


            /* =====================================================
                       CARD BODY
                    ====================================================== */

            .invoice-details-card-body {
                padding: 24px;
            }


            /* =====================================================
                       BASIC INFORMATION
                    ====================================================== */

            .invoice-info-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 18px;
            }

            .invoice-info-box {
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 12px;
                padding: 18px;
                min-height: 92px;
                box-shadow: 0 3px 12px rgba(30, 20, 50, 0.025);
            }

                .invoice-info-box span {
                    display: block;
                    color: #9993a8;
                    font-size: 13px;
                    font-weight: 600;
                    margin-bottom: 7px;
                }

                .invoice-info-box strong {
                    color: #29243a;
                    font-size: 15px;
                    font-weight: 700;
                    word-break: break-word;
                }


            /* =====================================================
                       SECTION
                    ====================================================== */

            .invoice-section {
                margin-top: 28px;
                padding-top: 25px;
                border-top: 1px solid #eeeaf3;
            }

            .invoice-section-title {
                margin: 0 0 16px;
                color: #29243a;
                font-size: 18px;
                font-weight: 700;
            }


            /* =====================================================
                       TABLE
                    ====================================================== */

            .invoice-items-wrapper {
                overflow-x: auto;
            }

            .invoice-items-table {
                width: 100%;
                min-width: 700px;
                border-collapse: collapse;
            }

                .invoice-items-table thead {
                    background: #faf9fc;
                }

                .invoice-items-table th {
                    padding: 15px 18px;
                    text-align: left;
                    border-bottom: 1px solid #ebe8f0;
                    color: #6f6a7d;
                    font-size: 12px;
                    font-weight: 700;
                    white-space: nowrap;
                }

                .invoice-items-table td {
                    padding: 17px 18px;
                    border-bottom: 1px solid #f0edf4;
                    color: #514b61;
                    font-size: 14px;
                    vertical-align: middle;
                    white-space: nowrap;
                }

                .invoice-items-table tbody tr:hover {
                    background: #fcfbff;
                }

                .invoice-items-table tbody tr:last-child td {
                    border-bottom: none;
                }

            .test-name {
                color: #29243a !important;
                font-weight: 700;
            }

            .item-total {
                color: #302b40 !important;
                font-weight: 700;
            }


            /* =====================================================
                       SUMMARY
                    ====================================================== */

            .invoice-summary-wrapper {
                display: flex;
                justify-content: flex-end;
            }

            .invoice-summary {
                width: 400px;
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 14px;
                padding: 20px;
                box-shadow: 0 4px 16px rgba(30, 20, 50, 0.035);
            }

            .invoice-summary-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                margin-bottom: 13px;
                color: #8b8798;
                font-size: 14px;
            }

                .invoice-summary-row strong {
                    color: #302b40;
                    font-weight: 700;
                }

            .invoice-summary-divider {
                border: 0;
                border-top: 1px solid #eeeaf3;
                margin: 16px 0;
            }

            .invoice-summary-row.net span,
            .invoice-summary-row.net strong {
                color: #29243a;
                font-size: 16px;
                font-weight: 700;
            }

            .invoice-summary-row.paid span,
            .invoice-summary-row.paid strong {
                color: #159447;
            }

            .invoice-summary-row.due span,
            .invoice-summary-row.due strong {
                color: #dc2626;
            }


            /* =====================================================
                       EMPTY STATE
                    ====================================================== */

            .invoice-items-empty {
                padding: 60px 20px;
                text-align: center;
            }

            .invoice-items-empty-icon {
                width: 64px;
                height: 64px;
                border-radius: 16px;
                background: #f1eaff;
                color: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 16px;
                font-size: 29px;
            }

            .invoice-items-empty h5 {
                margin-bottom: 7px;
                color: #302b40;
                font-size: 16px;
                font-weight: 700;
            }

            .invoice-items-empty p {
                margin: 0;
                color: #9993a8;
                font-size: 13px;
            }


            /* =====================================================
                       BOTTOM BACK
                    ====================================================== */

            .invoice-bottom-back {
                margin-top: 22px;
            }

                .invoice-bottom-back a {
                    display: inline-flex;
                    align-items: center;
                    gap: 5px;
                    color: #7c3aed;
                    font-size: 14px;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .invoice-bottom-back a:hover {
                        color: #6d28d9;
                        text-decoration: underline;
                    }


            /* =====================================================
                       MOBILE
                    ====================================================== */

            @@media (max-width: 1100px) {

                .invoice-info-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
            }


            @@media (max-width: 900px) {

                .invoice-details-header {
                    flex-direction: column;
                    gap: 18px;
                }
            }


            @@media (max-width: 700px) {

                .topbar {
                    padding: 0 15px;
                }

                .profile-info {
                    display: none;
                }

                .invoice-details-content {
                    padding: 20px 15px;
                }

                .invoice-details-title {
                    font-size: 28px;
                }

                .invoice-details-subtitle {
                    font-size: 14px;
                }

                .invoice-details-card-header {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 15px;
                }

                .invoice-info-grid {
                    grid-template-columns: 1fr;
                }

                .invoice-summary-wrapper {
                    justify-content: stretch;
                }

                .invoice-summary {
                    width: 100%;
                }
            }

    </style>

</head>


<body>

    <div class="dashboard-page">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- BRAND -->

            <div class="brand">

                <div class="brand-icon">
                    <img src="~/images/Logo.png"
                         alt="LabSync Logo" />
                </div>

                <div>

                    <h4>
                        LabSync
                    </h4>

                    <small>
                        Diagnostic Management
                    </small>

                </div>

            </div>


            <!-- MENU -->

            <div class="sidebar-menu">


                <p class="menu-title">
                    MAIN MENU
                </p>


                <!-- DASHBOARD -->

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- USERS -->

                <a asp-controller="Users"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <!-- PATIENTS -->

                <a asp-controller="Patients"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-person-vcard-fill"></i>

                    <span>
                        Patients
                    </span>

                </a>


                <!-- APPOINTMENTS -->

                <a asp-controller="Admin"
                   asp-action="AppointmentDetails"
                   class="menu-item">

                    <i class="bi bi-calendar-check-fill"></i>

                    <span>
                        Appointments
                    </span>

                </a>


                <!-- TESTS -->

                <a asp-controller="Tests"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-eyedropper"></i>

                    <span>
                        Tests
                    </span>

                </a>


                <!-- REFERRAL DOCTORS -->

                <a asp-controller="ReferralDoctors"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-person-badge-fill"></i>

                    <span>
                        Referral Doctors
                    </span>

                </a>


                <!-- OPERATIONS -->

                <p class="menu-title mt-4">
                    OPERATIONS
                </p>


                <!-- REPORTS -->

                <a asp-controller="Reports"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-file-earmark-medical-fill"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <!-- INVOICES -->

                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="menu-item active">

                    <i class="bi bi-receipt-cutoff"></i>

                    <span>
                        Invoices
                    </span>

                </a>


                <!-- PAYMENTS -->

                <a asp-controller="Payments"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-credit-card-fill"></i>

                    <span>
                        Payments
                    </span>

                </a>


                <!-- ANALYTICS -->

                <a asp-controller="Admin"
                   asp-action="Analytics"
                   class="menu-item">

                    <i class="bi bi-bar-chart-fill"></i>

                    <span>
                        Analytics
                    </span>

                </a>


                <!-- AUDIT LOGS -->

                <a asp-controller="Admin"
                   asp-action="AuditLogs"
                   class="menu-item">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


                

            </div>

        </aside>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <main class="dashboard-main">


            <!-- =================================================
                 TOPBAR
            ================================================== -->

            <header class="topbar">


                <div class="topbar-right">


                    <div class="dropdown">


                        <!-- PROFILE -->

                        <button class="profile dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">


                            <div class="profile-avatar">
                                A
                            </div>


                            <div class="profile-info">

                                <strong>
                                    Admin
                                </strong>

                                <small>
                                    Administrator
                                </small>

                            </div>


                        </button>


                        <!-- PROFILE DROPDOWN -->

                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">


                           


                            <li>

                                <form asp-controller="Admin"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item logout-item">

                                        <i class="bi bi-box-arrow-right"></i>

                                        Logout

                                    </button>

                                </form>

                            </li>


                        </ul>


                    </div>


                </div>


            </header>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="invoice-details-content">


                <!-- =================================================
                     PAGE HEADER
                ================================================== -->

                <div class="invoice-details-header">


                    <div>

                        <h1 class="invoice-details-title">
                            Invoice Details
                        </h1>

                        <p class="invoice-details-subtitle">
                            View complete invoice information.
                        </p>

                    </div>


                    <a asp-action="Index"
                       class="invoice-back-button">

                        <i class="bi bi-arrow-left"></i>

                        Back to Invoices

                    </a>


                </div>


                <!-- =================================================
                     DETAILS CARD
                ================================================== -->

                <div class="invoice-details-card">


                    <!-- CARD HEADER -->

                    <div class="invoice-details-card-header">


                        <div class="invoice-card-title-area">


                            <div class="invoice-card-icon">

                                <i class="bi bi-receipt"></i>

                            </div>


                            <div>

                                <h5>

                                    @(Model.InvoiceNumber
                                        ?? "Invoice")

                                </h5>

                                <span>
                                    Invoice Information
                                </span>

                            </div>


                        </div>


                        <!-- STATUS -->
                        @if (invoiceStatus == "Paid")
                        {

                            <span class="invoice-status paid">

                                <i class="bi bi-check-circle"></i>

                                Paid

                            </span>

                        }
                        else if (invoiceStatus == "Partial")
                        {

                            <span class="invoice-status partial">

                                <i class="bi bi-clock"></i>

                                Partial

                            </span>

                        }
                        else
                        {

                            <span class="invoice-status unpaid">

                                <i class="bi bi-x-circle"></i>

                                Unpaid

                            </span>

                        }


                    </div>


                    <!-- CARD BODY -->

                    <div class="invoice-details-card-body">


                        <!-- =================================================
                             BASIC INFORMATION
                        ================================================== -->

                        <div class="invoice-info-grid">


                            <!-- INVOICE NUMBER -->

                            <div class="invoice-info-box">

                                <span>
                                    Invoice Number
                                </span>

                                <strong>

                                    @(Model.InvoiceNumber
                                        ?? "N/A")

                                </strong>

                            </div>


                            <!-- PATIENT ID -->

                            <div class="invoice-info-box">

                                <span>
                                    Patient ID
                                </span>

                                <strong>
                                    @Model.PatientId
                                </strong>

                            </div>


                            <!-- APPOINTMENT ID -->

                            <div class="invoice-info-box">

                                <span>
                                    Appointment ID
                                </span>

                                <strong>
                                    @Model.AppointmentId
                                </strong>

                            </div>


                            <!-- INVOICE DATE -->

                            <div class="invoice-info-box">

                                <span>
                                    Invoice Date
                                </span>

                                <strong>

                                    @(
                                        Model.InvoiceDate.HasValue
                                            ? Model.InvoiceDate.Value.ToString(
                                                "dd MMM yyyy"
                                              )
                                            : "N/A"
                                    )

                                </strong>

                            </div>


                        </div>


                        <!-- =================================================
                             INVOICE ITEMS
                        ================================================== -->

                        <div class="invoice-section">


                            <h3 class="invoice-section-title">
                                Invoice Items
                            </h3>


                            <div class="invoice-items-wrapper">


                                <table class="invoice-items-table">


                                    <thead>

                                        <tr>

                                            <th>
                                                #
                                            </th>

                                            <th>
                                                Test
                                            </th>

                                            <th>
                                                Quantity
                                            </th>

                                            <th>
                                                Unit Price
                                            </th>

                                            <th>
                                                Total Price
                                            </th>

                                        </tr>

                                    </thead>


                                    <tbody>


                                        @if (Model.InvoiceItems != null &&
                                             Model.InvoiceItems.Any())
                                        {

                                            int serial = 1;


                                            foreach (var item in Model.InvoiceItems)
                                            {

                                                var quantity =
                                                    item.Quantity ?? 1;

                                                var totalPrice =
                                                    item.TotalPrice ??
                                                    (
                                                        item.UnitPrice
                                                        * quantity
                                                    );


                                                <tr>


                                                    <td>
                                                        @serial
                                                    </td>


                                                    <td class="test-name">

                                                        @(item.Test?.TestName
                                                            ?? $"Test #{item.TestId}")

                                                    </td>


                                                    <td>
                                                        @quantity
                                                    </td>


                                                    <td>
                                                        ৳ @item.UnitPrice.ToString("N2")
                                                    </td>


                                                    <td class="item-total">
                                                        ৳ @totalPrice.ToString("N2")
                                                    </td>


                                                </tr>


                                                serial++;

                                            }

                                        }
                                        else
                                        {

                                            <tr>

                                                <td colspan="5">


                                                    <div class="invoice-items-empty">


                                                        <div class="invoice-items-empty-icon">

                                                            <i class="bi bi-receipt"></i>

                                                        </div>


                                                        <h5>
                                                            No invoice items found
                                                        </h5>


                                                        <p>
                                                            There are no invoice items available for this invoice.
                                                        </p>


                                                    </div>


                                                </td>

                                            </tr>

                                        }


                                    </tbody>


                                </table>


                            </div>


                        </div>


                        <!-- =================================================
                             SUMMARY
                        ================================================== -->

                        <div class="invoice-section">


                            <div class="invoice-summary-wrapper">


                                <div class="invoice-summary">


                                    <!-- SUBTOTAL -->

                                    <div class="invoice-summary-row">

                                        <span>
                                            Subtotal
                                        </span>

                                        <strong>
                                            ৳ @Model.Subtotal.ToString("N2")
                                        </strong>

                                    </div>


                                    <!-- DISCOUNT -->

                                    <div class="invoice-summary-row">

                                        <span>
                                            Discount
                                        </span>

                                        <strong>
                                            ৳ @((Model.Discount ?? 0).ToString("N2"))
                                        </strong>

                                    </div>


                                    <!-- TAX -->

                                    <div class="invoice-summary-row">

                                        <span>
                                            Tax
                                        </span>

                                        <strong>
                                            ৳ @((Model.Tax ?? 0).ToString("N2"))
                                        </strong>

                                    </div>


                                    <hr class="invoice-summary-divider" />


                                    <!-- NET -->

                                    <div class="invoice-summary-row net">

                                        <span>
                                            Net Amount
                                        </span>

                                        <strong>
                                            ৳ @Model.NetAmount.ToString("N2")
                                        </strong>

                                    </div>


                                    <!-- PAID -->

                                    <div class="invoice-summary-row paid">

                                        <span>
                                            Paid Amount
                                        </span>

                                        <strong>
                                            ৳ @paidAmount.ToString("N2")
                                        </strong>

                                    </div>


                                    <!-- DUE -->

                                    <div class="invoice-summary-row due mb-0">

                                        <span>
                                            Due Amount
                                        </span>

                                        <strong>
                                            ৳ @displayDue.ToString("N2")
                                        </strong>

                                    </div>


                                </div>


                            </div>


                        </div>


                    </div>


                </div>


                <!-- =================================================
                     BACK TO DASHBOARD
                ================================================== -->

                <div class="invoice-bottom-back">

                    <a asp-controller="Admin"
                       asp-action="Index">

                        <i class="bi bi-arrow-left"></i>

                        Back to Dashboard

                    </a>

                </div>


            </div>


        </main>


    </div>


    <!-- =====================================================
         BOOTSTRAP JS
    ====================================================== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>