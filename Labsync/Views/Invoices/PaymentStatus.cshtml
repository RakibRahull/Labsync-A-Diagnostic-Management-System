@model List<LabSync.Models.Invoice>

@{
    ViewData["Title"] = "Payment Status";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Payment Status</h2>
            <p class="text-muted mb-0">
                Track invoice payment status
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            All Invoices
        </a>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-credit-card me-2"></i>
                Payment Status List
            </h5>
        </div>

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Invoice Number</th>
                                <th>Patient ID</th>
                                <th>Net Amount</th>
                                <th>Paid Amount</th>
                                <th>Due Amount</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int serial = 1;
                            }

                            @foreach (var invoice in Model)
                            {
                                <tr>

                                    <td>@serial</td>

                                    <td>
                                        @(invoice.InvoiceNumber ?? "N/A")
                                    </td>

                                    <td>@invoice.PatientId</td>

                                    <td>
                                        @invoice.NetAmount.ToString("N2")
                                    </td>

                                    <td class="text-success">
                                        @((invoice.PaidAmount ?? 0)
                                            .ToString("N2"))
                                    </td>

                                    <td class="text-danger">
                                        @invoice.DueAmount.ToString("N2")
                                    </td>

                                    <td>
                                        @if (invoice.DueAmount <= 0)
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else if ((invoice.PaidAmount ?? 0) > 0)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Partial
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Unpaid
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@invoice.Id"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>

                                </tr>

                                serial++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-credit-card fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No payment records found
                    </h5>

                    <p class="text-muted">
                        Payment information will appear here.
                    </p>
                </div>
            }

        </div>
    </div>

</div>