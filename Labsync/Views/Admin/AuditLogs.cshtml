@model List<LabSync.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
    Layout = null;

    var totalLogs = Model?.Count ?? 0;

    var selectedDate =
        ViewBag.SelectedDate as string
        ?? DateTime.Today.ToString("yyyy-MM-dd");

    var selectedDateDisplay =
        ViewBag.SelectedDateDisplay as string
        ?? DateTime.Today.ToString("dd MMM yyyy");
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>LabSync - Audit Logs</title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" />


    <style>

            /* =====================================================
                       TOPBAR
                    ====================================================== */

            .topbar {
                height: 85px;
                background: #ffffff;
                border-bottom: 1px solid #e8e5ef;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                padding: 0 28px;
            }

            .topbar-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                justify-content: flex-end;
            }


            /* =====================================================
                       PROFILE
                    ====================================================== */

            .profile {
                border: none;
                background: transparent;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 0 5px 8px;
                cursor: pointer;
            }

                .profile:focus {
                    box-shadow: none;
                }

                .profile::after {
                    margin-left: 5px;
                    color: #8f899d;
                }

            .profile-avatar {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                font-weight: 700;
                box-shadow: 0 7px 18px rgba(139, 92, 246, 0.28);
            }

            .profile-info {
                display: flex;
                flex-direction: column;
                text-align: left;
                line-height: 1.2;
            }

                .profile-info strong {
                    color: #29243a;
                    font-size: 15px;
                    font-weight: 700;
                }

                .profile-info small {
                    color: #9993a8;
                    font-size: 12px;
                    margin-top: 3px;
                }


            /* =====================================================
                       PROFILE DROPDOWN
                    ====================================================== */

            .profile-dropdown {
                margin-top: 10px !important;
                min-width: 220px;
                border: 1px solid #eeeaf5;
                border-radius: 12px;
                padding: 8px;
                box-shadow: 0 12px 30px rgba(30, 20, 50, 0.12);
            }

                .profile-dropdown .dropdown-item {
                    border-radius: 8px;
                    padding: 10px 12px;
                    color: #514b61;
                    font-size: 14px;
                }

                    .profile-dropdown .dropdown-item:hover {
                        background: #f5efff;
                        color: #7c3aed;
                    }

                    .profile-dropdown .dropdown-item i {
                        width: 22px;
                        margin-right: 6px;
                    }

                .profile-dropdown .logout-item {
                    color: #dc2626;
                }

                    .profile-dropdown .logout-item:hover {
                        background: #fef2f2;
                        color: #dc2626;
                    }


            /* =====================================================
                       AUDIT CONTENT
                    ====================================================== */

            .audit-content {
                padding: 30px;
            }


            /* =====================================================
                       PAGE HEADER
                    ====================================================== */

            .audit-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 28px;
            }

            .audit-title {
                margin: 0;
                color: #18213a;
                font-size: 36px;
                font-weight: 700;
                line-height: 1.15;
                letter-spacing: -0.6px;
            }

            .audit-subtitle {
                margin: 7px 0 0;
                color: #9296aa;
                font-size: 16px;
                line-height: 1.5;
            }

            /* Brand */
            .brand-icon {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                border-radius: 0;
                flex-shrink: 0;
            }

                .brand-icon img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }
            /* =====================================================
                       BACK BUTTON
                    ====================================================== */

            .audit-back-button {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 11px 16px;
                border: 1px solid #e8e5ef;
                border-radius: 10px;
                background: #ffffff;
                color: #514b61;
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                transition: .2s ease;
            }

                .audit-back-button:hover {
                    background: #f5efff;
                    border-color: #d8c7f8;
                    color: #7c3aed;
                }


            /* =====================================================
                       DATE FILTER CARD
                    ====================================================== */

            .audit-filter-card {
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 16px;
                padding: 20px 22px;
                margin-bottom: 24px;
                box-shadow: 0 5px 20px rgba(30, 20, 50, 0.04);
            }

            .audit-filter-wrapper {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 20px;
            }

            .audit-date-area {
                flex: 1;
                max-width: 360px;
            }

            .audit-date-label {
                display: block;
                margin-bottom: 8px;
                color: #514b61;
                font-size: 13px;
                font-weight: 700;
            }

            .audit-date-input {
                width: 100%;
                height: 46px;
                border: 1px solid #e8e5ef;
                border-radius: 10px;
                padding: 0 13px;
                background: #ffffff;
                color: #29243a;
                font-size: 14px;
                outline: none;
                transition: .2s ease;
            }

                .audit-date-input:focus {
                    border-color: #a78bfa;
                    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.10);
                }

            .audit-filter-actions {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .audit-filter-button {
                height: 46px;
                padding: 0 17px;
                border: none;
                border-radius: 10px;
                background: #7c3aed;
                color: #ffffff;
                font-size: 14px;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                transition: .2s ease;
            }

                .audit-filter-button:hover {
                    background: #6d28d9;
                    color: #ffffff;
                }

            .audit-today-button {
                height: 46px;
                padding: 0 17px;
                border: 1px solid #e8e5ef;
                border-radius: 10px;
                background: #ffffff;
                color: #514b61;
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                transition: .2s ease;
            }

                .audit-today-button:hover {
                    background: #f5efff;
                    border-color: #d8c7f8;
                    color: #7c3aed;
                }

            .audit-selected-date {
                margin-top: 12px;
                color: #9993a8;
                font-size: 12px;
            }

                .audit-selected-date strong {
                    color: #7c3aed;
                }


            /* =====================================================
                       SUMMARY CARD
                    ====================================================== */

            .audit-stat-card {
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 16px;
                padding: 22px;
                display: flex;
                align-items: center;
                gap: 16px;
                box-shadow: 0 5px 20px rgba(30, 20, 50, 0.04);
                margin-bottom: 24px;
            }

            .audit-stat-icon {
                width: 50px;
                height: 50px;
                border-radius: 14px;
                background: #f1eaff;
                color: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 21px;
                flex-shrink: 0;
            }

            .audit-stat-info span {
                display: block;
                color: #8b8798;
                font-size: 13px;
                font-weight: 600;
                margin-bottom: 4px;
            }

            .audit-stat-info h2 {
                margin: 0;
                color: #29243a;
                font-size: 24px;
                font-weight: 700;
                line-height: 1.1;
            }

            .audit-stat-info small {
                display: block;
                margin-top: 4px;
                color: #9993a8;
                font-size: 12px;
            }


            /* =====================================================
                       AUDIT TABLE CARD
                    ====================================================== */

            .audit-table-card {
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(30, 20, 50, 0.04);
            }


            /* =====================================================
                       CARD HEADER
                    ====================================================== */

            .audit-card-header {
                padding: 22px 24px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid #eeeaf3;
            }

                .audit-card-header h5 {
                    margin: 0 0 5px;
                    color: #29243a;
                    font-size: 18px;
                    font-weight: 700;
                }

                .audit-card-header span {
                    color: #9993a8;
                    font-size: 13px;
                }


            /* =====================================================
                       TABLE
                    ====================================================== */

            .audit-table-wrapper {
                overflow-x: auto;
            }

            .audit-table {
                width: 100%;
                min-width: 1250px;
                border-collapse: collapse;
            }

                .audit-table thead {
                    background: #faf9fc;
                }

                .audit-table th {
                    padding: 15px 18px;
                    text-align: left;
                    border-bottom: 1px solid #ebe8f0;
                    color: #6f6a7d;
                    font-size: 12px;
                    font-weight: 700;
                    white-space: nowrap;
                }

                .audit-table td {
                    padding: 17px 18px;
                    border-bottom: 1px solid #f0edf4;
                    color: #514b61;
                    font-size: 14px;
                    vertical-align: middle;
                }

                .audit-table tbody tr:hover {
                    background: #fcfbff;
                }

                .audit-table tbody tr:last-child td {
                    border-bottom: none;
                }


            /* =====================================================
                       USER ID
                    ====================================================== */

            .audit-user {
                color: #7c3aed;
                font-size: 14px;
                font-weight: 700;
                white-space: nowrap;
            }


            /* =====================================================
                       EMAIL
                    ====================================================== */

            .audit-email {
                color: #514b61;
                font-size: 13px;
                font-weight: 600;
                white-space: nowrap;
            }


            /* =====================================================
                       ACTION BADGES
                    ====================================================== */

            .audit-action {
                display: inline-flex;
                align-items: center;
                padding: 6px 10px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
            }

                .audit-action.create {
                    background: #eaf8ef;
                    color: #159447;
                }

                .audit-action.update {
                    background: #e9f2ff;
                    color: #4385dd;
                }

                .audit-action.delete {
                    background: #fee2e2;
                    color: #dc2626;
                }

                .audit-action.login {
                    background: #f1eaff;
                    color: #7c3aed;
                }

                .audit-action.logout {
                    background: #f5f1eb;
                    color: #806b52;
                }

                .audit-action.approve {
                    background: #eaf8ef;
                    color: #159447;
                }

                .audit-action.reject {
                    background: #fff0f0;
                    color: #dc4a55;
                }

                .audit-action.default {
                    background: #f3f2f6;
                    color: #6f6a7d;
                }


            /* =====================================================
                       ENTITY
                    ====================================================== */

            .audit-entity {
                color: #29243a;
                font-weight: 600;
            }

            .audit-entity-id {
                color: #7c3aed;
                font-weight: 600;
            }


            /* =====================================================
                       TIMESTAMP
                    ====================================================== */

            .audit-timestamp {
                color: #6f6a7d;
                font-size: 13px;
                white-space: nowrap;
            }


            /* =====================================================
                       DETAILS
                    ====================================================== */

            .audit-details {
                max-width: 350px;
                color: #6f6a7d;
                line-height: 1.5;
                word-break: break-word;
            }


            /* =====================================================
                       EMPTY STATE
                    ====================================================== */

            .audit-empty {
                padding: 70px 25px;
                text-align: center;
            }

            .audit-empty-icon {
                width: 64px;
                height: 64px;
                border-radius: 16px;
                background: #f1eaff;
                color: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 16px;
                font-size: 29px;
            }

            .audit-empty h5 {
                color: #302b40;
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 7px;
            }

            .audit-empty p {
                color: #9993a8;
                font-size: 13px;
                margin: 0;
            }


            /* =====================================================
                       BOTTOM BACK
                    ====================================================== */

            .audit-bottom-back {
                margin-top: 22px;
            }

                .audit-bottom-back a {
                    display: inline-flex;
                    align-items: center;
                    gap: 5px;
                    color: #7c3aed;
                    font-size: 14px;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .audit-bottom-back a:hover {
                        color: #6d28d9;
                        text-decoration: underline;
                    }


            /* =====================================================
                       MOBILE
                    ====================================================== */

            @@media (max-width: 900px) {

                .audit-header {
                    flex-direction: column;
                    gap: 18px;
                }

                .audit-filter-wrapper {
                    flex-direction: column;
                    align-items: stretch;
                }

                .audit-date-area {
                    max-width: none;
                }

                .audit-filter-actions {
                    justify-content: flex-start;
                }
            }


            @@media (max-width: 700px) {

                .topbar {
                    padding: 0 15px;
                }

                .profile-info {
                    display: none;
                }

                .audit-content {
                    padding: 20px 15px;
                }

                .audit-title {
                    font-size: 28px;
                }

                .audit-subtitle {
                    font-size: 14px;
                }

                .audit-filter-actions {
                    flex-direction: column;
                    align-items: stretch;
                }

                .audit-filter-button,
                .audit-today-button {
                    width: 100%;
                }
            }

    </style>

</head>


<body>

    <div class="dashboard-page">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- BRAND -->

            <div class="brand">
                <div class="brand-icon">
                    <img src="~/images/Logo.png"
                         alt="LabSync Logo" />
                </div>

                <div>

                    <h4>
                        LabSync
                    </h4>

                    <small>
                        Diagnostic Management
                    </small>

                </div>

            </div>


            <!-- MENU -->

            <div class="sidebar-menu">


                <p class="menu-title">
                    MAIN MENU
                </p>


                <!-- DASHBOARD -->

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- USERS -->

                <a asp-controller="Users"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <!-- PATIENTS -->

                <a asp-controller="Patients"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-person-vcard-fill"></i>

                    <span>
                        Patients
                    </span>

                </a>


                <!-- APPOINTMENTS -->

                <a asp-controller="Admin"
                   asp-action="AppointmentDetails"
                   class="menu-item">

                    <i class="bi bi-calendar-check-fill"></i>

                    <span>
                        Appointments
                    </span>

                </a>


                <!-- TESTS -->

                <a asp-controller="Tests"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-eyedropper"></i>

                    <span>
                        Tests
                    </span>

                </a>


                <!-- REFERRAL DOCTORS -->

                <a asp-controller="ReferralDoctors"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-person-badge-fill"></i>

                    <span>
                        Referral Doctors
                    </span>

                </a>


                <!-- OPERATIONS -->

                <p class="menu-title mt-4">
                    OPERATIONS
                </p>


                <!-- REPORTS -->

                <a href="@Url.Action(
                                                             "Index",
                                                             "AdminReports",
                                                             new
                                                             {
                                                                 area = ""
                                                             })"
                   class="menu-item">

                    <i class="bi bi-file-earmark-medical-fill"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <!-- INVOICES -->

                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-receipt-cutoff"></i>

                    <span>
                        Invoices
                    </span>

                </a>


                <!-- PAYMENTS -->

                <a asp-controller="Payments"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-credit-card-fill"></i>

                    <span>
                        Payments
                    </span>

                </a>


                <!-- ANALYTICS -->

                <a asp-controller="Admin"
                   asp-action="Analytics"
                   class="menu-item">

                    <i class="bi bi-bar-chart-fill"></i>

                    <span>
                        Analytics
                    </span>

                </a>


                <!-- AUDIT LOGS -->

                <a asp-controller="Admin"
                   asp-action="AuditLogs"
                   class="menu-item active">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


                


            </div>

        </aside>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <main class="dashboard-main">


            <!-- =================================================
                 TOPBAR
            ================================================== -->

            <header class="topbar">


                <div class="topbar-right">


                    <div class="dropdown">


                        <!-- PROFILE -->

                        <button class="profile dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">


                            <div class="profile-avatar">
                                A
                            </div>


                            <div class="profile-info">

                                <strong>
                                    Admin
                                </strong>

                                <small>
                                    Administrator
                                </small>

                            </div>


                        </button>


                        <!-- PROFILE DROPDOWN -->

                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">


                            

                            <li>

                                <form asp-controller="Admin"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item logout-item">

                                        <i class="bi bi-box-arrow-right"></i>

                                        Logout

                                    </button>

                                </form>

                            </li>


                        </ul>


                    </div>


                </div>


            </header>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="audit-content">


                <!-- PAGE HEADER -->

                <div class="audit-header">


                    <div>

                        <h1 class="audit-title">
                            Audit Logs
                        </h1>

                        <p class="audit-subtitle">
                            Track important activities and changes made in the system.
                        </p>

                    </div>


                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="audit-back-button">

                        <i class="bi bi-arrow-left"></i>

                        Back to Dashboard

                    </a>


                </div>


                <!-- =================================================
                     CALENDAR FILTER
                ================================================== -->

                <div class="audit-filter-card">


                    <form asp-controller="Admin"
                          asp-action="AuditLogs"
                          method="get">


                        <div class="audit-filter-wrapper">


                            <div class="audit-date-area">

                                <label class="audit-date-label"
                                       for="selectedDate">

                                    Select Date

                                </label>


                                <input type="date"
                                       id="selectedDate"
                                       name="selectedDate"
                                       value="@selectedDate"
                                       class="audit-date-input" />


                                <div class="audit-selected-date">

                                    Showing logs for:

                                    <strong>
                                        @selectedDateDisplay
                                    </strong>

                                </div>

                            </div>


                            <div class="audit-filter-actions">


                                <button type="submit"
                                        class="audit-filter-button">

                                    <i class="bi bi-search"></i>

                                    View Logs

                                </button>


                                <a asp-controller="Admin"
                                   asp-action="AuditLogs"
                                   class="audit-today-button">

                                    <i class="bi bi-calendar-event"></i>

                                    Today

                                </a>


                            </div>


                        </div>


                    </form>


                </div>


                <!-- =================================================
                     SUMMARY
                ================================================== -->

                <div class="audit-stat-card">


                    <div class="audit-stat-icon">

                        <i class="bi bi-clock-history"></i>

                    </div>


                    <div class="audit-stat-info">

                        <span>
                            Audit Logs
                        </span>

                        <h2>
                            @totalLogs
                        </h2>

                        <small>
                            Records on @selectedDateDisplay
                        </small>

                    </div>


                </div>


                <!-- =================================================
                     AUDIT TABLE
                ================================================== -->

                <div class="audit-table-card">


                    <!-- CARD HEADER -->

                    <div class="audit-card-header">

                        <div>

                            <h5>
                                Activity History
                            </h5>

                            <span>
                                System activities for @selectedDateDisplay
                            </span>

                        </div>

                    </div>


                    <!-- TABLE -->

                    <div class="audit-table-wrapper">


                        <table class="audit-table">


                            <thead>

                                <tr>

                                    

                                    <th>
                                        User ID
                                    </th>

                                    <th>
                                        Email Address
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                    <th>
                                        Entity
                                    </th>

                                  

                                    <th>
                                        Timestamp
                                    </th>

                                    <th>
                                        Details
                                    </th>

                                </tr>

                            </thead>


                            <tbody>


                                @if (Model != null &&
                                     Model.Any())
                                {

                                    int serial = 1;


                                    foreach (var log in Model)
                                    {

                                        var action =
                                            log.Action?
                                                .Trim()
                                                .ToLowerInvariant()
                                            ?? "";

                                        var actionClass =
                                            "default";


                                        if (action.Contains("create") ||
                                            action.Contains("add"))
                                        {
                                            actionClass = "create";
                                        }
                                        else if (action.Contains("update") ||
                                                 action.Contains("edit"))
                                        {
                                            actionClass = "update";
                                        }
                                        else if (action.Contains("delete"))
                                        {
                                            actionClass = "delete";
                                        }
                                        else if (action.Contains("login"))
                                        {
                                            actionClass = "login";
                                        }
                                        else if (action.Contains("logout"))
                                        {
                                            actionClass = "logout";
                                        }
                                        else if (action.Contains("approve"))
                                        {
                                            actionClass = "approve";
                                        }
                                        else if (action.Contains("reject"))
                                        {
                                            actionClass = "reject";
                                        }


                                        <tr>


                                            


                                            <!-- USER ID -->

                                            <td>

                                                <span class="audit-user">
                                                    @log.UserId
                                                </span>

                                            </td>


                                            <!-- EMAIL -->

                                            <td>

                                                <span class="audit-email">

                                                    @(log.User?.Email ?? "N/A")

                                                </span>

                                            </td>


                                            <!-- ACTION -->

                                            <td>

                                                <span class="audit-action @actionClass">

                                                    @log.Action

                                                </span>

                                            </td>


                                            <!-- ENTITY -->

                                            <td>

                                                <span class="audit-entity">

                                                    @(log.EntityName ?? "N/A")

                                                </span>

                                            </td>


                                            

                                            <!-- TIMESTAMP -->

                                            <td>

                                                <span class="audit-timestamp">

                                                    @(log.Timestamp.HasValue
                                                        ? log.Timestamp.Value.ToString(
                                                            "dd MMM yyyy hh:mm tt"
                                                          )
                                                        : "N/A")

                                                </span>

                                            </td>


                                            <!-- DETAILS -->

                                            <td>

                                                <div class="audit-details">

                                                    @(log.Details
                                                        ?? "No details available")

                                                </div>

                                            </td>


                                        </tr>


                                        serial++;

                                    }

                                }
                                else
                                {

                                    <!-- EMPTY STATE -->

                                    <tr>

                                        <td colspan="8">


                                            <div class="audit-empty">


                                                <div class="audit-empty-icon">

                                                    <i class="bi bi-calendar-x"></i>

                                                </div>


                                                <h5>
                                                    No audit logs found
                                                </h5>


                                                <p>
                                                    No system activities were recorded on @selectedDateDisplay.
                                                </p>


                                            </div>


                                        </td>

                                    </tr>

                                }


                            </tbody>


                        </table>


                    </div>


                </div>


                <!-- =================================================
                     BACK TO DASHBOARD
                ================================================== -->

                <div class="audit-bottom-back">


                    <a asp-controller="Admin"
                       asp-action="Index">

                        <i class="bi bi-arrow-left"></i>

                        Back to Dashboard

                    </a>


                </div>


            </div>


        </main>


    </div>


    <!-- Bootstrap JS -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>