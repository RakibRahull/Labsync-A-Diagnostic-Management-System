@model List<LabSync.Models.RecentActivityViewModel>

@{
    ViewData["Title"] = "Recent Activity";
    ViewData["ActiveMenu"] = "Dashboard";

    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="page-title">
            Recent Activity
        </h1>

        <p class="page-subtitle">
            Latest activities in LabSync
        </p>

    </div>


    <!-- BACK TO DASHBOARD -->

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Back to Dashboard

    </a>

</div>



<!-- =====================================================
     ACTIVITY CARD
====================================================== -->

<div class="lab-card">


    <!-- =================================================
         CARD HEADER
    ================================================== -->

    <div class="p-4 border-bottom">


        <div>

            <h5 class="mb-1"
                style="color:#18213a; font-weight:700;">

                All Recent Activities

            </h5>


            <span style="color:#9993a8; font-size:12px;">

                Patient registrations and generated reports

            </span>

        </div>


    </div>



    <!-- =================================================
         ACTIVITY LIST
    ================================================== -->

    <div class="activity-list">


        @if (Model != null && Model.Any())
        {

            foreach (var activity in Model)
            {

                <div class="activity-item">


                    <!-- =====================================
                         ICON
                    ====================================== -->

                    <div class="activity-icon @activity.IconClass">

                        <i class="bi @activity.Icon"></i>

                    </div>



                    <!-- =====================================
                         CONTENT
                    ====================================== -->

                    <div class="activity-content">

                        <strong>
                            @activity.Title
                        </strong>


                        <small>
                            @activity.Description
                        </small>

                    </div>



                    <!-- =====================================
                         TIME
                    ====================================== -->

                    <span class="activity-time">

                        @activity.TimeAgo

                    </span>


                </div>

            }

        }
        else
        {

            <!-- =========================================
                 EMPTY STATE
            ========================================== -->

            <div class="text-center py-5">


                <div class="mb-3">

                    <i class="bi bi-clock-history"
                       style="
                        font-size:50px;
                        color:#aaa;
                        ">
                    </i>

                </div>


                <h5>
                    No recent activity
                </h5>


                <p class="text-muted">

                    There are no recent activities to display.

                </p>


            </div>

        }


    </div>

</div>



<!-- =====================================================
     PAGE-SPECIFIC CSS
====================================================== -->
@section Styles {

    <style>

        /* =================================================
                   ACTIVITY LIST
                ================================================== */

        .activity-list {
            width: 100%;
        }


        /* =================================================
                   ACTIVITY ITEM
                ================================================== */

        .activity-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 17px 22px;
            border-bottom: 1px solid #f0eef4;
            transition: .2s ease;
        }


            .activity-item:last-child {
                border-bottom: none;
            }


            .activity-item:hover {
                background: #fcfaff;
            }


        /* =================================================
                   ACTIVITY ICON
                ================================================== */

        .activity-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }


            /* =================================================
                   ICON COLORS
                ================================================== */

            .activity-icon.purple {
                background: #f0e9ff;
                color: #8b5cf6;
            }


            .activity-icon.blue {
                background: #eaf3ff;
                color: #3b82f6;
            }


            .activity-icon.pink {
                background: #fcecf5;
                color: #ec4899;
            }


            .activity-icon.cyan {
                background: #e7fafa;
                color: #06b6d4;
            }


            .activity-icon.green {
                background: #eaf8ef;
                color: #159447;
            }


            .activity-icon.orange {
                background: #fff4e6;
                color: #f59e0b;
            }


        /* =================================================
                   CONTENT
                ================================================== */

        .activity-content {
            flex: 1;
            min-width: 0;
        }


            .activity-content strong {
                display: block;
                color: #29243a;
                font-size: 14px;
                font-weight: 700;
                margin-bottom: 4px;
            }


            .activity-content small {
                display: block;
                color: #9993a8;
                font-size: 12px;
                line-height: 1.5;
            }


        /* =================================================
                   TIME
                ================================================== */

        .activity-time {
            color: #9993a8;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }


        /* =================================================
                   MOBILE
                ================================================== */

        @@media (max-width: 700px) {

            .activity-item {
                align-items: flex-start;
                padding: 15px;
            }


            .activity-time {
                font-size: 10px;
            }
        }
        /* TOPBAR */

        .topbar {
            height: 85px;
            background: #ffffff;
            border-bottom: 1px solid #e8e5ef;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 0 28px;
        }


        .topbar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            justify-content: flex-end;
        }


        /* PROFILE */

        .profile {
            border: none;
            background: transparent;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 5px 0 5px 8px;
            cursor: pointer;
        }


            .profile:focus {
                box-shadow: none;
                outline: none;
            }


            .profile::after {
                margin-left: 5px;
                color: #8f899d;
            }


        .profile-avatar {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 700;
            box-shadow: 0 7px 18px rgba(139, 92, 246, 0.28);
        }


        .profile-info {
            display: flex;
            flex-direction: column;
            text-align: left;
            line-height: 1.2;
        }


            .profile-info strong {
                color: #29243a;
                font-size: 15px;
                font-weight: 700;
            }


            .profile-info small {
                color: #9993a8;
                font-size: 12px;
                margin-top: 3px;
            }


        /*  DASHBOARD ACTIVE */

        .sidebar .menu-item.dashboard-active {
            background: linear-gradient( 135deg, #8b5cf6, #a855f7 ) !important;
            color: #ffffff !important;
            border-radius: 11px;
            box-shadow: 0 7px 18px rgba(139, 92, 246, 0.25);
        }


            .sidebar .menu-item.dashboard-active i {
                color: #ffffff !important;
            }


            .sidebar .menu-item.dashboard-active span {
                color: #ffffff !important;
            }


            .sidebar .menu-item.dashboard-active:hover {
                background: linear-gradient( 135deg, #7c3aed, #a855f7 ) !important;
                color: #ffffff !important;
            }


                .sidebar .menu-item.dashboard-active:hover i,
                .sidebar .menu-item.dashboard-active:hover span {
                    color: #ffffff !important;
                }


        /* PROFILE DROPDOWN */

        .profile-dropdown {
            margin-top: 10px !important;
            min-width: 190px;
            border: 1px solid #eeeaf5;
            border-radius: 12px;
            padding: 8px;
            box-shadow: 0 12px 30px rgba(30, 20, 50, 0.12);
        }


            /* LOGOUT FORM */

            .profile-dropdown .logout-form {
                margin: 0;
                padding: 0;
            }


            /* LOGOUT BUTTON */

            .profile-dropdown .logout-item {
                width: 100%;
                border: none;
                background: transparent;
                border-radius: 8px;
                padding: 11px 12px;
                color: #dc2626;
                font-size: 14px;
                font-family: inherit;
                text-align: left;
                cursor: pointer;
                transition: .2s ease;
            }


                .profile-dropdown .logout-item:hover {
                    background: #fef2f2;
                    color: #dc2626;
                }


                .profile-dropdown .logout-item i {
                    width: 22px;
                    margin-right: 7px;
                }

        /* Brand */
        .brand-icon {
            width: 54px;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border-radius: 0;
            flex-shrink: 0;
        }

            .brand-icon img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }
        /* SIDEBAR LOGOUT */

        .sidebar-logout-form {
            margin: 0;
            padding: 0;
        }


        .sidebar-logout-button {
            width: 100%;
            border: none;
            background: transparent;
            text-align: left;
            cursor: pointer;
            font-family: inherit;
        }


            .sidebar-logout-button:hover {
                background: #fef2f2 !important;
                color: #dc2626 !important;
            }


                .sidebar-logout-button:hover i,
                .sidebar-logout-button:hover span {
                    color: #dc2626 !important;
                }


        /* DATE BOX */

        .date-box {
            display: flex;
            align-items: center;
            gap: 14px;
            background: #ffffff;
            border: 1px solid #e8e5ef;
            border-radius: 14px;
            padding: 14px 18px;
            min-width: 215px;
            box-shadow: 0 5px 18px rgba(30, 20, 50, 0.04);
            transition: .2s ease;
        }


            .date-box:hover {
                border-color: #c9b5f7;
                box-shadow: 0 7px 22px rgba(139, 92, 246, 0.10);
            }


            /* DATE ICON */

            .date-box > i {
                width: 42px;
                height: 42px;
                border-radius: 11px;
                background: #f1eaff;
                color: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
            }


        /* DATE CONTENT */

        .date-picker-content {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }


            .date-picker-content small {
                color: #9993a8;
                font-size: 12px;
                margin-bottom: 4px;
            }


        /* DATE INPUT */

        .dashboard-date-picker {
            border: none;
            outline: none;
            background: transparent;
            color: #29243a;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            padding: 0;
            width: 155px;
            font-family: Arial, Helvetica, sans-serif;
        }


            .dashboard-date-picker:focus {
                border: none;
                outline: none;
                box-shadow: none;
            }


            .dashboard-date-picker::-webkit-calendar-picker-indicator {
                cursor: pointer;
                width: 18px;
                height: 18px;
                opacity: .75;
            }


                .dashboard-date-picker::-webkit-calendar-picker-indicator:hover {
                    opacity: 1;
                }


        .dashboard-date-picker {
            color-scheme: light;
        }


        /* APPOINTMENT VIEW ALL */

        .appointments-view-all {
            color: #8b5cf6;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
            transition: .2s ease;
        }


            .appointments-view-all:hover {
                color: #7c3aed;
                text-decoration: underline;
            }


        /* NO APPOINTMENTS */

        .no-appointments p {
            margin-bottom: 0;
        }


        /* MOBILE */

        @@media (max-width: 700px) {

            .topbar {
                padding: 0 15px;
            }


            .profile-info {
                display: none;
            }


            .date-box {
                min-width: 180px;
                padding: 12px 14px;
            }


            .dashboard-date-picker {
                width: 130px;
            }
        }

    </style>

    </style>

}