@model LabSync.Models.ReferralDoctor

@{
    ViewData["Title"] = "Add Referral Doctor";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>LabSync - Add Referral Doctor</title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" />


    <style>

            /* =====================================================
                       TOPBAR
                    ====================================================== */

            .topbar {
                height: 85px;
                background: #ffffff;
                border-bottom: 1px solid #e8e5ef;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                padding: 0 28px;
            }

            .topbar-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                justify-content: flex-end;
            }


            /* =====================================================
                       PROFILE
                    ====================================================== */

            .profile {
                border: none;
                background: transparent;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 0 5px 8px;
                cursor: pointer;
            }

                .profile:focus {
                    box-shadow: none;
                }

                .profile::after {
                    margin-left: 5px;
                    color: #8f899d;
                }

            .profile-avatar {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                font-weight: 700;
                box-shadow: 0 7px 18px rgba(139, 92, 246, 0.28);
            }

            .profile-info {
                display: flex;
                flex-direction: column;
                text-align: left;
                line-height: 1.2;
            }

                .profile-info strong {
                    color: #29243a;
                    font-size: 15px;
                    font-weight: 700;
                }

                .profile-info small {
                    color: #9993a8;
                    font-size: 12px;
                    margin-top: 3px;
                }


            /* =====================================================
                       DROPDOWN
                    ====================================================== */

            .profile-dropdown {
                margin-top: 10px !important;
                min-width: 220px;
                border: 1px solid #eeeaf5;
                border-radius: 12px;
                padding: 8px;
                box-shadow: 0 12px 30px rgba(30, 20, 50, 0.12);
            }

                .profile-dropdown .dropdown-item {
                    border-radius: 8px;
                    padding: 10px 12px;
                    color: #514b61;
                    font-size: 14px;
                }

                    .profile-dropdown .dropdown-item:hover {
                        background: #f5efff;
                        color: #7c3aed;
                    }

                    .profile-dropdown .dropdown-item i {
                        width: 22px;
                        margin-right: 6px;
                    }

                .profile-dropdown .logout-item {
                    color: #dc2626;
                }

                    .profile-dropdown .logout-item:hover {
                        background: #fef2f2;
                        color: #dc2626;
                    }

            /* Brand */
            .brand-icon {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                border-radius: 0;
                flex-shrink: 0;
            }

                .brand-icon img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }
            /* =====================================================
                       CONTENT
                    ====================================================== */

            .create-doctor-content {
                padding: 30px;
            }


            /* =====================================================
                       HEADER
                    ====================================================== */

            .create-doctor-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 28px;
            }

            .create-doctor-title {
                margin: 0;
                color: #18213a;
                font-size: 36px;
                font-weight: 700;
                line-height: 1.15;
                letter-spacing: -0.6px;
            }

            .create-doctor-subtitle {
                margin: 7px 0 0;
                color: #9296aa;
                font-size: 16px;
                line-height: 1.5;
            }


            /* =====================================================
                       BACK
                    ====================================================== */

            .create-doctor-back {
                min-height: 46px;
                padding: 0 17px;
                border: 1px solid #dedbe6;
                border-radius: 10px;
                background: #ffffff;
                color: #5f596c;
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
            }

                .create-doctor-back:hover {
                    background: #f7f4fb;
                    color: #7c3aed;
                    border-color: #d5c5f5;
                }


            /* =====================================================
                       FORM WRAPPER
                    ====================================================== */

            .create-doctor-form-wrapper {
                width: 100%;
                display: flex;
                justify-content: center;
            }

            .create-doctor-card {
                width: 100%;
                max-width: 980px;
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(30, 20, 50, .04);
            }


            /* =====================================================
                       CARD HEADER
                    ====================================================== */

            .create-doctor-card-header {
                padding: 23px 30px;
                border-bottom: 1px solid #eeeaf3;
            }

                .create-doctor-card-header h4 {
                    margin: 0 0 4px;
                    color: #29243a;
                    font-size: 19px;
                    font-weight: 700;
                }

                .create-doctor-card-header p {
                    margin: 0;
                    color: #9993a8;
                    font-size: 13px;
                }


            /* =====================================================
                       FORM BODY
                    ====================================================== */

            .create-doctor-form-body {
                padding: 30px;
            }

            .create-doctor-form-inner {
                max-width: 850px;
                margin: 0 auto;
            }


            /* =====================================================
                       LABEL
                    ====================================================== */

            .create-doctor-label {
                display: block;
                margin-bottom: 7px;
                color: #514b61;
                font-size: 13px;
                font-weight: 700;
            }


            /* =====================================================
                       INPUT
                    ====================================================== */

            .create-doctor-input {
                width: 100%;
                height: 48px;
                border: 1px solid #ddd9e5;
                border-radius: 10px;
                background: #ffffff;
                padding: 0 14px;
                color: #29243a;
                font-size: 14px;
                outline: none;
                transition: .2s ease;
            }

                .create-doctor-input::placeholder {
                    color: #aaa3af;
                }

                .create-doctor-input:focus {
                    border-color: #9b5cff;
                    box-shadow: 0 0 0 3px rgba(139, 92, 246, .08);
                }


            /* =====================================================
                       VALIDATION
                    ====================================================== */

            .create-doctor-validation {
                display: block;
                margin-top: 6px;
                font-size: 12px;
            }


            /* =====================================================
                       BUTTONS
                    ====================================================== */

            .create-doctor-actions {
                display: flex;
                align-items: center;
                gap: 9px;
                padding-top: 22px;
                margin-top: 10px;
                border-top: 1px solid #eeeaf3;
            }

            .create-doctor-submit {
                min-height: 46px;
                padding: 0 19px;
                border: none;
                border-radius: 10px;
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
                color: #ffffff;
                font-size: 14px;
                font-weight: 700;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                cursor: pointer;
                box-shadow: 0 7px 18px rgba(139, 92, 246, .20);
            }

                .create-doctor-submit:hover {
                    opacity: .94;
                    transform: translateY(-1px);
                }

            .create-doctor-cancel {
                min-height: 46px;
                padding: 0 19px;
                border: 1px solid #dedbe6;
                border-radius: 10px;
                background: #ffffff;
                color: #5f596c;
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .create-doctor-cancel:hover {
                    background: #f7f4fb;
                    color: #7c3aed;
                    border-color: #d5c5f5;
                }


            /* =====================================================
                       MOBILE
                    ====================================================== */

            @@media (max-width: 900px) {

                .create-doctor-header {
                    flex-direction: column;
                    gap: 18px;
                }

                .create-doctor-back {
                    align-self: flex-start;
                }

                .create-doctor-card {
                    max-width: 100%;
                }
            }

            @@media (max-width: 700px) {

                .topbar {
                    padding: 0 15px;
                }

                .profile-info {
                    display: none;
                }

                .create-doctor-content {
                    padding: 20px 15px;
                }

                .create-doctor-title {
                    font-size: 28px;
                }

                .create-doctor-subtitle {
                    font-size: 14px;
                }

                .create-doctor-form-body {
                    padding: 20px;
                }

                .create-doctor-form-inner {
                    max-width: 100%;
                }

                .create-doctor-actions {
                    flex-direction: column;
                    align-items: stretch;
                }

                .create-doctor-submit,
                .create-doctor-cancel {
                    width: 100%;
                }
            }

    </style>

</head>


<body>

    <div class="dashboard-page">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- BRAND -->

            <div class="brand">

                <div class="brand-icon">
                    <img src="~/images/Logo.png"
                         alt="LabSync Logo" />
                </div>

                <div>

                    <h4>
                        LabSync
                    </h4>

                    <small>
                        Diagnostic Management
                    </small>

                </div>

            </div>


            <div class="sidebar-menu">

                <p class="menu-title">
                    MAIN MENU
                </p>


                <a asp-controller="Admin"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <a asp-controller="Users"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <a asp-controller="Patients"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-person-vcard-fill"></i>

                    <span>
                        Patients
                    </span>

                </a>


                <a asp-controller="Admin"
                   asp-action="AppointmentDetails"
                   class="menu-item">

                    <i class="bi bi-calendar-check-fill"></i>

                    <span>
                        Appointments
                    </span>

                </a>


                <a asp-controller="Tests"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-eyedropper"></i>

                    <span>
                        Tests
                    </span>

                </a>


                <a asp-controller="ReferralDoctors"
                   asp-action="Index"
                   class="menu-item active">

                    <i class="bi bi-person-badge-fill"></i>

                    <span>
                        Referral Doctors
                    </span>

                </a>


                <p class="menu-title mt-4">
                    OPERATIONS
                </p>


                <a asp-controller="Reports"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-file-earmark-medical-fill"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-receipt-cutoff"></i>

                    <span>
                        Invoices
                    </span>

                </a>


                <a asp-controller="Payments"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-credit-card-fill"></i>

                    <span>
                        Payments
                    </span>

                </a>


                <a asp-controller="Admin"
                   asp-action="Analytics"
                   class="menu-item">

                    <i class="bi bi-bar-chart-fill"></i>

                    <span>
                        Analytics
                    </span>

                </a>


                <a asp-controller="Admin"
                   asp-action="AuditLogs"
                   class="menu-item">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


                

            </div>

        </aside>


        <!-- =====================================================
             MAIN
        ====================================================== -->

        <main class="dashboard-main">


            <!-- TOPBAR -->

            <header class="topbar">

                <div class="topbar-right">

                    <div class="dropdown">

                        <button class="profile dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <div class="profile-avatar">
                                A
                            </div>

                            <div class="profile-info">

                                <strong>
                                    Admin
                                </strong>

                                <small>
                                    Administrator
                                </small>

                            </div>

                        </button>


                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">

                            

                            <li>

                                <form asp-controller="Admin"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item logout-item">

                                        <i class="bi bi-box-arrow-right"></i>

                                        Logout

                                    </button>

                                </form>

                            </li>

                        </ul>

                    </div>

                </div>

            </header>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="create-doctor-content">


                <!-- HEADER -->

                <div class="create-doctor-header">

                    <div>

                        <h1 class="create-doctor-title">
                            Add Referral Doctor
                        </h1>

                        <p class="create-doctor-subtitle">
                            Add a new referral doctor to the system.
                        </p>

                    </div>


                    <a asp-controller="ReferralDoctors"
                       asp-action="Index"
                       class="create-doctor-back">

                        <i class="bi bi-arrow-left"></i>

                        Back to Doctors

                    </a>

                </div>


                <!-- FORM -->

                <div class="create-doctor-form-wrapper">


                    <div class="create-doctor-card">


                        <!-- CARD HEADER -->

                        <div class="create-doctor-card-header">

                            <h4>
                                Doctor Information
                            </h4>

                            <p>
                                Enter the referral doctor's details below.
                            </p>

                        </div>


                        <!-- FORM BODY -->

                        <div class="create-doctor-form-body">


                            <div class="create-doctor-form-inner">


                                <form asp-controller="ReferralDoctors"
                                      asp-action="Create"
                                      method="post">


                                    @Html.AntiForgeryToken()


                                    <div asp-validation-summary="ModelOnly"
                                         class="alert alert-danger mb-4">
                                    </div>


                                    <!-- DOCTOR NAME -->

                                    <div class="mb-4">

                                        <label asp-for="DoctorName"
                                               class="create-doctor-label">

                                            Doctor Name
                                            <span class="text-danger">*</span>

                                        </label>

                                        <input asp-for="DoctorName"
                                               class="create-doctor-input"
                                               placeholder="Enter doctor name" />

                                        <span asp-validation-for="DoctorName"
                                              class="text-danger create-doctor-validation">
                                        </span>

                                    </div>


                                    <!-- SPECIALIZATION -->

                                    <div class="mb-4">

                                        <label asp-for="Specialization"
                                               class="create-doctor-label">

                                            Specialization

                                        </label>

                                        <input asp-for="Specialization"
                                               class="create-doctor-input"
                                               placeholder="e.g. Cardiologist" />

                                        <span asp-validation-for="Specialization"
                                              class="text-danger create-doctor-validation">
                                        </span>

                                    </div>


                                    <!-- HOSPITAL -->

                                    <div class="mb-4">

                                        <label asp-for="HospitalName"
                                               class="create-doctor-label">

                                            Hospital Name

                                        </label>

                                        <input asp-for="HospitalName"
                                               class="create-doctor-input"
                                               placeholder="Enter hospital name" />

                                        <span asp-validation-for="HospitalName"
                                              class="text-danger create-doctor-validation">
                                        </span>

                                    </div>


                                    <!-- PHONE -->

                                    <div class="mb-4">

                                        <label asp-for="Phone"
                                               class="create-doctor-label">

                                            Phone Number

                                        </label>

                                        <input asp-for="Phone"
                                               class="create-doctor-input"
                                               placeholder="Enter phone number" />

                                        <span asp-validation-for="Phone"
                                              class="text-danger create-doctor-validation">
                                        </span>

                                    </div>


                                    <!-- EMAIL -->

                                    <div class="mb-4">

                                        <label asp-for="Email"
                                               class="create-doctor-label">

                                            Email Address

                                        </label>

                                        <input asp-for="Email"
                                               type="email"
                                               class="create-doctor-input"
                                               placeholder="Enter email address" />

                                        <span asp-validation-for="Email"
                                              class="text-danger create-doctor-validation">
                                        </span>

                                    </div>


                                    <!-- ACTIONS -->

                                    <div class="create-doctor-actions">


                                        <button type="submit"
                                                class="create-doctor-submit">

                                            <i class="bi bi-check-lg"></i>

                                            Save Doctor

                                        </button>


                                        <a asp-controller="ReferralDoctors"
                                           asp-action="Index"
                                           class="create-doctor-cancel">

                                            Cancel

                                        </a>


                                    </div>


                                </form>

                            </div>

                        </div>

                    </div>

                </div>


            </div>

        </main>

    </div>


    <!-- Bootstrap JS -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- Validation -->

    <partial name="_ValidationScriptsPartial" />

</body>

</html>