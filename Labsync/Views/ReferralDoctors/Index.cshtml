@model List<LabSync.Models.ReferralDoctor>

@{
    ViewData["Title"] = "Referral Doctors";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>LabSync - Referral Doctors</title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" />


    <style>

            /* =====================================================
                       TOPBAR
                    ====================================================== */

            .topbar {
                height: 85px;
                background: #ffffff;
                border-bottom: 1px solid #e8e5ef;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                padding: 0 28px;
            }

            .topbar-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                justify-content: flex-end;
            }


            /* =====================================================
                       PROFILE
                    ====================================================== */

            .profile {
                border: none;
                background: transparent;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 0 5px 8px;
                cursor: pointer;
            }

                .profile:focus {
                    box-shadow: none;
                }

                .profile::after {
                    margin-left: 5px;
                    color: #8f899d;
                }

            .profile-avatar {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                font-weight: 700;
                box-shadow: 0 7px 18px rgba(139, 92, 246, 0.28);
            }

            .profile-info {
                display: flex;
                flex-direction: column;
                text-align: left;
                line-height: 1.2;
            }

                .profile-info strong {
                    color: #29243a;
                    font-size: 15px;
                    font-weight: 700;
                }

                .profile-info small {
                    color: #9993a8;
                    font-size: 12px;
                    margin-top: 3px;
                }


            /* =====================================================
                       PROFILE DROPDOWN
                    ====================================================== */

            .profile-dropdown {
                margin-top: 10px !important;
                min-width: 220px;
                border: 1px solid #eeeaf5;
                border-radius: 12px;
                padding: 8px;
                box-shadow: 0 12px 30px rgba(30, 20, 50, 0.12);
            }

                .profile-dropdown .dropdown-item {
                    border-radius: 8px;
                    padding: 10px 12px;
                    color: #514b61;
                    font-size: 14px;
                }

                    .profile-dropdown .dropdown-item:hover {
                        background: #f5efff;
                        color: #7c3aed;
                    }

                    .profile-dropdown .dropdown-item i {
                        width: 22px;
                        margin-right: 6px;
                    }

                .profile-dropdown .logout-item {
                    color: #dc2626;
                }

                    .profile-dropdown .logout-item:hover {
                        background: #fef2f2;
                        color: #dc2626;
                    }


            /* =====================================================
                       CONTENT
                    ====================================================== */

            .doctors-content {
                padding: 30px;
            }


            /* =====================================================
                       PAGE HEADER
                    ====================================================== */

            .doctors-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 28px;
            }

            .doctors-title {
                margin: 0;
                color: #18213a;
                font-size: 36px;
                font-weight: 700;
                line-height: 1.15;
                letter-spacing: -0.6px;
            }

            .doctors-subtitle {
                margin: 7px 0 0;
                color: #9296aa;
                font-size: 16px;
                line-height: 1.5;
            }


            /* =====================================================
                       ADD BUTTON
                    ====================================================== */

            .add-doctor-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                min-height: 46px;
                padding: 0 18px;
                border: none;
                border-radius: 10px;
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
                color: #ffffff !important;
                font-size: 14px;
                font-weight: 700;
                text-decoration: none;
                box-shadow: 0 7px 18px rgba(139, 92, 246, 0.22);
                transition: .2s ease;
            }

                .add-doctor-button:hover {
                    color: #ffffff !important;
                    transform: translateY(-1px);
                    box-shadow: 0 9px 22px rgba(139, 92, 246, 0.28);
                }


            /* =====================================================
                       ALERT
                    ====================================================== */

            .doctor-alert {
                border-radius: 11px;
                border: none;
                font-size: 14px;
                margin-bottom: 20px;
            }


            /* =====================================================
                       TABLE CARD
                    ====================================================== */

            .doctors-table-card {
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(30, 20, 50, 0.04);
            }


            /* =====================================================
                       TABLE
                    ====================================================== */

            .doctors-table-wrapper {
                overflow-x: auto;
            }

            .doctors-table {
                width: 100%;
                min-width: 1000px;
                border-collapse: collapse;
            }

                .doctors-table thead {
                    background: #faf9fc;
                }

                .doctors-table th {
                    padding: 15px 18px;
                    text-align: left;
                    border-bottom: 1px solid #ebe8f0;
                    color: #6f6a7d;
                    font-size: 12px;
                    font-weight: 700;
                    white-space: nowrap;
                }

                .doctors-table td {
                    padding: 17px 18px;
                    border-bottom: 1px solid #f0edf4;
                    color: #514b61;
                    font-size: 14px;
                    vertical-align: middle;
                    white-space: nowrap;
                }

                .doctors-table tbody tr:hover {
                    background: #fcfbff;
                }

                .doctors-table tbody tr:last-child td {
                    border-bottom: none;
                }


            /* =====================================================
                       DOCTOR NAME
                    ====================================================== */

            .doctor-name {
                color: #302b40;
                font-size: 14px;
                font-weight: 700;
            }

            .doctor-id {
                display: block;
                margin-top: 3px;
                color: #9c96a7;
                font-size: 12px;
            }


            /* =====================================================
                       SPECIALIZATION
                    ====================================================== */

            .doctor-specialization {
                display: inline-flex;
                align-items: center;
                padding: 7px 10px;
                border-radius: 8px;
                background: #f1eaff;
                color: #7c3aed;
                font-size: 12px;
                font-weight: 700;
            }


            /* =====================================================
                       ACTIONS
                    ====================================================== */

            .doctor-actions {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 7px;
            }

            .doctor-action-button {
                width: 40px;
                height: 40px;
                padding: 0;
                border-radius: 9px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: #ffffff;
                font-size: 15px;
                transition: .2s ease;
            }

                .doctor-action-button:hover {
                    transform: translateY(-1px);
                }


            /* =====================================================
                       EMPTY
                    ====================================================== */

            .doctors-empty {
                padding: 70px 25px;
                text-align: center;
            }

            .doctors-empty-icon {
                width: 64px;
                height: 64px;
                border-radius: 16px;
                background: #f1eaff;
                color: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 16px;
                font-size: 29px;
            }

            .doctors-empty h5 {
                color: #302b40;
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 7px;
            }

            .doctors-empty p {
                color: #9993a8;
                font-size: 13px;
                margin: 0 0 18px;
            }
            /* Brand */
            .brand-icon {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                border-radius: 0;
                flex-shrink: 0;
            }

                .brand-icon img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }

            /* =====================================================
                       MOBILE
                    ====================================================== */

            @@media (max-width: 900px) {

                .doctors-header {
                    flex-direction: column;
                    gap: 18px;
                }

                .add-doctor-button {
                    align-self: flex-start;
                }
            }

            @@media (max-width: 700px) {

                .topbar {
                    padding: 0 15px;
                }

                .profile-info {
                    display: none;
                }

                .doctors-content {
                    padding: 20px 15px;
                }

                .doctors-title {
                    font-size: 28px;
                }

                .doctors-subtitle {
                    font-size: 14px;
                }
            }

    </style>

</head>


<body>

    <div class="dashboard-page">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- BRAND -->

            <div class="brand">

                <div class="brand-icon">
                    <img src="~/images/Logo.png"
                         alt="LabSync Logo" />
                </div>

                <div>

                    <h4>
                        LabSync
                    </h4>

                    <small>
                        Diagnostic Management
                    </small>

                </div>

            </div>


            <!-- MENU -->

            <div class="sidebar-menu">


                <p class="menu-title">
                    MAIN MENU
                </p>


                <!-- DASHBOARD -->

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- USERS -->

                <a asp-controller="Users"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <!-- PATIENTS -->

                <a asp-controller="Patients"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-person-vcard-fill"></i>

                    <span>
                        Patients
                    </span>

                </a>


                <!-- APPOINTMENTS -->

                <a asp-controller="Admin"
                   asp-action="AppointmentDetails"
                   class="menu-item">

                    <i class="bi bi-calendar-check-fill"></i>

                    <span>
                        Appointments
                    </span>

                </a>


                <!-- TESTS -->

                <a asp-controller="Tests"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-eyedropper"></i>

                    <span>
                        Tests
                    </span>

                </a>


                <!-- REFERRAL DOCTORS -->

                <a asp-controller="ReferralDoctors"
                   asp-action="Index"
                   class="menu-item active">

                    <i class="bi bi-person-badge-fill"></i>

                    <span>
                        Referral Doctors
                    </span>

                </a>


                <p class="menu-title mt-4">
                    OPERATIONS
                </p>


                <!-- REPORTS -->

                <a href="@Url.Action(
                                                             "Index",
                                                             "AdminReports",
                                                             new
                                                             {
                                                                 area = ""
                                                             })"
                   class="menu-item">

                    <i class="bi bi-file-earmark-medical-fill"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <!-- INVOICES -->

                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-receipt-cutoff"></i>

                    <span>
                        Invoices
                    </span>

                </a>


                <!-- PAYMENTS -->

                <a asp-controller="Payments"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-credit-card-fill"></i>

                    <span>
                        Payments
                    </span>

                </a>


                <!-- ANALYTICS -->

                <a asp-controller="Admin"
                   asp-action="Analytics"
                   class="menu-item">

                    <i class="bi bi-bar-chart-fill"></i>

                    <span>
                        Analytics
                    </span>

                </a>


                <!-- AUDIT LOGS -->

                <a asp-controller="Admin"
                   asp-action="AuditLogs"
                   class="menu-item">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


                

            </div>

        </aside>


        <!-- =====================================================
             MAIN
        ====================================================== -->

        <main class="dashboard-main">


            <!-- TOPBAR -->

            <header class="topbar">

                <div class="topbar-right">

                    <div class="dropdown">

                        <button class="profile dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <div class="profile-avatar">
                                A
                            </div>

                            <div class="profile-info">

                                <strong>
                                    Admin
                                </strong>

                                <small>
                                    Administrator
                                </small>

                            </div>

                        </button>


                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">

                           

                            <li>

                                <form asp-controller="Admin"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item logout-item">

                                        <i class="bi bi-box-arrow-right"></i>

                                        Logout

                                    </button>

                                </form>

                            </li>

                        </ul>

                    </div>

                </div>

            </header>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="doctors-content">


                <!-- HEADER -->

                <div class="doctors-header">

                    <div>

                        <h1 class="doctors-title">
                            Referral Doctors
                        </h1>

                        <p class="doctors-subtitle">
                            Manage referral doctors and their information.
                        </p>

                    </div>


                    <a asp-controller="ReferralDoctors"
                       asp-action="Create"
                       class="add-doctor-button">

                        <i class="bi bi-plus-lg"></i>

                        Add Doctor

                    </a>

                </div>


                <!-- SUCCESS -->
                @if (TempData["Success"] != null)
                {

                    <div class="alert alert-success alert-dismissible fade show doctor-alert">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        @TempData["Success"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>

                }


                <!-- ERROR -->
                @if (TempData["Error"] != null)
                {

                    <div class="alert alert-danger alert-dismissible fade show doctor-alert">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        @TempData["Error"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>

                }


                <!-- TABLE -->

                <div class="doctors-table-card">


                    <div class="doctors-table-wrapper">


                        <table class="doctors-table">


                            <thead>

                                <tr>

                                    <th>
                                        #
                                    </th>

                                    <th>
                                        Doctor Name
                                    </th>

                                    <th>
                                        Specialization
                                    </th>

                                    <th>
                                        Hospital
                                    </th>

                                    <th>
                                        Phone
                                    </th>

                                    <th>
                                        Email
                                    </th>

                                    <th>
                                        Actions
                                    </th>

                                </tr>

                            </thead>


                            <tbody>


                                @if (Model != null &&
                                     Model.Any())
                                {

                                    var serial = 1;


                                    foreach (var doctor in Model)
                                    {

                                        <tr>


                                            <!-- NUMBER -->

                                            <td>
                                                @serial
                                            </td>


                                            <!-- DOCTOR NAME -->

                                            <td>

                                                <div>

                                                    <strong class="doctor-name">

                                                        @doctor.DoctorName

                                                    </strong>

                                                    <span class="doctor-id">

                                                        Doctor ID: @doctor.Id

                                                    </span>

                                                </div>

                                            </td>


                                            <!-- SPECIALIZATION -->

                                            <td>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    doctor.Specialization))
                                                {

                                                    <span class="doctor-specialization">

                                                        @doctor.Specialization

                                                    </span>

                                                }
                                                else
                                                {

                                                    <span class="text-muted">
                                                        -
                                                    </span>

                                                }

                                            </td>


                                            <!-- HOSPITAL -->

                                            <td>

                                                @(doctor.HospitalName ?? "-")

                                            </td>


                                            <!-- PHONE -->

                                            <td>

                                                @(doctor.Phone ?? "-")

                                            </td>


                                            <!-- EMAIL -->

                                            <td>

                                                @(doctor.Email ?? "-")

                                            </td>


                                            <!-- ACTIONS -->

                                            <td>

                                                <div class="doctor-actions">


                                                    <!-- VIEW -->

                                                    <a asp-controller="ReferralDoctors"
                                                       asp-action="Details"
                                                       asp-route-id="@doctor.Id"
                                                       class="btn btn-outline-primary doctor-action-button"
                                                       title="View Doctor">

                                                        <i class="bi bi-eye"></i>

                                                    </a>


                                                    <!-- EDIT -->

                                                    <a asp-controller="ReferralDoctors"
                                                       asp-action="Edit"
                                                       asp-route-id="@doctor.Id"
                                                       class="btn btn-outline-warning doctor-action-button"
                                                       title="Edit Doctor">

                                                        <i class="bi bi-pencil"></i>

                                                    </a>


                                                    <!-- DELETE -->

                                                    <a asp-controller="ReferralDoctors"
                                                       asp-action="Delete"
                                                       asp-route-id="@doctor.Id"
                                                       class="btn btn-outline-danger doctor-action-button"
                                                       title="Delete Doctor">

                                                        <i class="bi bi-trash"></i>

                                                    </a>


                                                </div>

                                            </td>


                                        </tr>


                                        serial++;

                                    }

                                }
                                else
                                {

                                    <tr>

                                        <td colspan="7">


                                            <div class="doctors-empty">


                                                <div class="doctors-empty-icon">

                                                    <i class="bi bi-person-x"></i>

                                                </div>


                                                <h5>
                                                    No Referral Doctors Found
                                                </h5>


                                                <p>
                                                    There are no referral doctors available.
                                                </p>


                                                <a asp-controller="ReferralDoctors"
                                                   asp-action="Create"
                                                   class="add-doctor-button">

                                                    <i class="bi bi-plus-lg"></i>

                                                    Add Doctor

                                                </a>


                                            </div>


                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- BACK -->

                

                </div>


            </div>

        </main>

    </div>


    <!-- Bootstrap JS -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>