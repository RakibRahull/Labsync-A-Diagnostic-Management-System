@model LabSync.Models.ReferralDoctor

@{
    ViewData["Title"] = "Doctor Details";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>LabSync - Doctor Details</title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" />


    <style>

            /* =====================================================
                       TOPBAR
                    ====================================================== */

            .topbar {
                height: 85px;
                background: #ffffff;
                border-bottom: 1px solid #e8e5ef;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                padding: 0 28px;
            }

            .topbar-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                justify-content: flex-end;
            }


            /* =====================================================
                       PROFILE
                    ====================================================== */

            .profile {
                border: none;
                background: transparent;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 0 5px 8px;
                cursor: pointer;
            }

                .profile:focus {
                    box-shadow: none;
                }

                .profile::after {
                    margin-left: 5px;
                    color: #8f899d;
                }

            .profile-avatar {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                font-weight: 700;
                box-shadow: 0 7px 18px rgba(139, 92, 246, 0.28);
            }

            .profile-info {
                display: flex;
                flex-direction: column;
                text-align: left;
                line-height: 1.2;
            }

                .profile-info strong {
                    color: #29243a;
                    font-size: 15px;
                    font-weight: 700;
                }

                .profile-info small {
                    color: #9993a8;
                    font-size: 12px;
                    margin-top: 3px;
                }


            /* =====================================================
                       DROPDOWN
                    ====================================================== */

            .profile-dropdown {
                margin-top: 10px !important;
                min-width: 220px;
                border: 1px solid #eeeaf5;
                border-radius: 12px;
                padding: 8px;
                box-shadow: 0 12px 30px rgba(30, 20, 50, 0.12);
            }

                .profile-dropdown .dropdown-item {
                    border-radius: 8px;
                    padding: 10px 12px;
                    color: #514b61;
                    font-size: 14px;
                }

                    .profile-dropdown .dropdown-item:hover {
                        background: #f5efff;
                        color: #7c3aed;
                    }

                    .profile-dropdown .dropdown-item i {
                        width: 22px;
                        margin-right: 6px;
                    }

                .profile-dropdown .logout-item {
                    color: #dc2626;
                }

                    .profile-dropdown .logout-item:hover {
                        background: #fef2f2;
                        color: #dc2626;
                    }


            /* =====================================================
                       CONTENT
                    ====================================================== */

            .doctor-details-content {
                padding: 30px;
            }


            /* =====================================================
                       HEADER
                    ====================================================== */

            .doctor-details-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 28px;
            }

            .doctor-details-title {
                margin: 0;
                color: #18213a;
                font-size: 36px;
                font-weight: 700;
                line-height: 1.15;
                letter-spacing: -0.6px;
            }

            .doctor-details-subtitle {
                margin: 7px 0 0;
                color: #9296aa;
                font-size: 16px;
                line-height: 1.5;
            }
            /* Brand */
            .brand-icon {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                border-radius: 0;
                flex-shrink: 0;
            }

                .brand-icon img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }

            /* =====================================================
                       BACK
                    ====================================================== */

            .doctor-details-back {
                min-height: 46px;
                padding: 0 17px;
                border: 1px solid #dedbe6;
                border-radius: 10px;
                background: #ffffff;
                color: #5f596c;
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
            }

                .doctor-details-back:hover {
                    background: #f7f4fb;
                    color: #7c3aed;
                    border-color: #d5c5f5;
                }


            /* =====================================================
                       CARD
                    ====================================================== */

            .doctor-details-card {
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(30, 20, 50, .04);
                max-width: 1050px;
                margin: 0 auto;
            }


            /* =====================================================
                       CARD HEADER
                    ====================================================== */

            .doctor-details-card-header {
                padding: 24px 30px;
                border-bottom: 1px solid #eeeaf3;
            }

                .doctor-details-card-header h4 {
                    margin: 0 0 5px;
                    color: #29243a;
                    font-size: 21px;
                    font-weight: 700;
                }

                .doctor-details-card-header p {
                    margin: 0;
                    color: #9993a8;
                    font-size: 13px;
                }


            /* =====================================================
                       BODY
                    ====================================================== */

            .doctor-details-body {
                padding: 30px;
            }


            /* =====================================================
                       INFO BOX
                    ====================================================== */

            .doctor-info-box {
                height: 100%;
                padding: 18px;
                background: #ffffff;
                border: 1px solid #e9e5ef;
                border-radius: 12px;
                transition: .2s ease;
            }

                .doctor-info-box:hover {
                    border-color: #d8caf2;
                    box-shadow: 0 4px 14px rgba(139, 92, 246, .05);
                }

            .doctor-info-label {
                display: block;
                margin-bottom: 6px;
                color: #9892a6;
                font-size: 12px;
                font-weight: 600;
            }

            .doctor-info-value {
                margin: 0;
                color: #302b40;
                font-size: 14px;
                font-weight: 600;
                line-height: 1.4;
                word-break: break-word;
            }

            .doctor-info-id {
                color: #7c3aed;
            }


            /* =====================================================
                       SECTION TITLE
                    ====================================================== */

            .doctor-section-title {
                margin: 0 0 18px;
                color: #302b40;
                font-size: 15px;
                font-weight: 700;
            }


            /* =====================================================
                       MOBILE
                    ====================================================== */

            @@media (max-width: 900px) {

                .doctor-details-header {
                    flex-direction: column;
                    gap: 18px;
                }

                .doctor-details-back {
                    align-self: flex-start;
                }
            }


            @@media (max-width: 700px) {

                .topbar {
                    padding: 0 15px;
                }

                .profile-info {
                    display: none;
                }

                .doctor-details-content {
                    padding: 20px 15px;
                }

                .doctor-details-title {
                    font-size: 28px;
                }

                .doctor-details-subtitle {
                    font-size: 14px;
                }

                .doctor-details-card {
                    max-width: 100%;
                }

                .doctor-details-body {
                    padding: 20px;
                }
            }

    </style>

</head>


<body>

    <div class="dashboard-page">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <div class="brand">

                <div class="brand-icon">
                    <img src="~/images/Logo.png"
                         alt="LabSync Logo" />
                </div>

                <div>

                    <h4>
                        LabSync
                    </h4>

                    <small>
                        Diagnostic Management
                    </small>

                </div>

            </div>


            <div class="sidebar-menu">

                <p class="menu-title">
                    MAIN MENU
                </p>


                <a asp-controller="Admin"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <a asp-controller="Users"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <a asp-controller="Patients"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-person-vcard-fill"></i>

                    <span>
                        Patients
                    </span>

                </a>


                <a asp-controller="Admin"
                   asp-action="AppointmentDetails"
                   class="menu-item">

                    <i class="bi bi-calendar-check-fill"></i>

                    <span>
                        Appointments
                    </span>

                </a>


                <a asp-controller="Tests"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-eyedropper"></i>

                    <span>
                        Tests
                    </span>

                </a>


                <a asp-controller="ReferralDoctors"
                   asp-action="Index"
                   class="menu-item active">

                    <i class="bi bi-person-badge-fill"></i>

                    <span>
                        Referral Doctors
                    </span>

                </a>


                <p class="menu-title mt-4">
                    OPERATIONS
                </p>


                <a asp-controller="Reports"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-file-earmark-medical-fill"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-receipt-cutoff"></i>

                    <span>
                        Invoices
                    </span>

                </a>


                <a asp-controller="Payments"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-credit-card-fill"></i>

                    <span>
                        Payments
                    </span>

                </a>


                <a asp-controller="Admin"
                   asp-action="Analytics"
                   class="menu-item">

                    <i class="bi bi-bar-chart-fill"></i>

                    <span>
                        Analytics
                    </span>

                </a>


                <a asp-controller="Admin"
                   asp-action="AuditLogs"
                   class="menu-item">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


                

            </div>

        </aside>


        <!-- =====================================================
             MAIN
        ====================================================== -->

        <main class="dashboard-main">


            <!-- TOPBAR -->

            <header class="topbar">

                <div class="topbar-right">

                    <div class="dropdown">

                        <button class="profile dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <div class="profile-avatar">
                                A
                            </div>

                            <div class="profile-info">

                                <strong>
                                    Admin
                                </strong>

                                <small>
                                    Administrator
                                </small>

                            </div>

                        </button>


                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">

                            
                            <li>

                                <form asp-controller="Admin"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item logout-item">

                                        <i class="bi bi-box-arrow-right"></i>

                                        Logout

                                    </button>

                                </form>

                            </li>

                        </ul>

                    </div>

                </div>

            </header>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="doctor-details-content">


                <!-- HEADER -->

                <div class="doctor-details-header">

                    <div>

                        <h1 class="doctor-details-title">
                            Doctor Details
                        </h1>

                        <p class="doctor-details-subtitle">
                            View referral doctor information.
                        </p>

                    </div>


                    <a asp-controller="ReferralDoctors"
                       asp-action="Index"
                       class="doctor-details-back">

                        <i class="bi bi-arrow-left"></i>

                        Back to Doctors

                    </a>

                </div>


                <!-- CARD -->

                <div class="doctor-details-card">


                    <!-- CARD HEADER -->

                    <div class="doctor-details-card-header">

                        <h4>
                            @Model.DoctorName
                        </h4>

                        <p>
                            @(Model.Specialization ?? "Referral Doctor")
                        </p>

                    </div>


                    <!-- BODY -->

                    <div class="doctor-details-body">


                        <h6 class="doctor-section-title">
                            Doctor Information
                        </h6>


                        <div class="row g-3">


                            <!-- ID -->

                            <div class="col-md-6">

                                <div class="doctor-info-box">

                                    <span class="doctor-info-label">
                                        Doctor ID
                                    </span>

                                    <p class="doctor-info-value doctor-info-id">

                                        @Model.Id

                                    </p>

                                </div>

                            </div>


                            <!-- NAME -->

                            <div class="col-md-6">

                                <div class="doctor-info-box">

                                    <span class="doctor-info-label">
                                        Doctor Name
                                    </span>

                                    <p class="doctor-info-value">

                                        @Model.DoctorName

                                    </p>

                                </div>

                            </div>


                            <!-- SPECIALIZATION -->

                            <div class="col-md-6">

                                <div class="doctor-info-box">

                                    <span class="doctor-info-label">
                                        Specialization
                                    </span>

                                    <p class="doctor-info-value">

                                        @(Model.Specialization ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- HOSPITAL -->

                            <div class="col-md-6">

                                <div class="doctor-info-box">

                                    <span class="doctor-info-label">
                                        Hospital Name
                                    </span>

                                    <p class="doctor-info-value">

                                        @(Model.HospitalName ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- PHONE -->

                            <div class="col-md-6">

                                <div class="doctor-info-box">

                                    <span class="doctor-info-label">
                                        Phone Number
                                    </span>

                                    <p class="doctor-info-value">

                                        @(Model.Phone ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- EMAIL -->

                            <div class="col-md-6">

                                <div class="doctor-info-box">

                                    <span class="doctor-info-label">
                                        Email Address
                                    </span>

                                    <p class="doctor-info-value">

                                        @(Model.Email ?? "-")

                                    </p>

                                </div>

                            </div>


                            <!-- CREATED -->

                            <div class="col-md-6">

                                <div class="doctor-info-box">

                                    <span class="doctor-info-label">
                                        Created At
                                    </span>

                                    <p class="doctor-info-value">

                                        @(
                                            Model.CreatedAt.HasValue
                                                ? Model.CreatedAt.Value.ToString(
                                                    "dd MMM yyyy hh:mm tt"
                                                )
                                                : "-"
                                        )

                                    </p>

                                </div>

                            </div>


                        </div>


                    </div>

                </div>


            </div>

        </main>

    </div>


    <!-- Bootstrap JS -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>