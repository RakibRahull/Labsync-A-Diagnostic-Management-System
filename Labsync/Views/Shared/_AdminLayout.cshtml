@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    var activeMenu =
        ViewData["ActiveMenu"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LabSync</title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" />


    <style>

            /* =========================
                       BODY
                    ========================= */

            body {
                background: #f7f7fb;
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
            }


            /* =========================
                       ADMIN WRAPPER
                    ========================= */

            .admin-wrapper {
                display: flex;
                min-height: 100vh;
            }


            /* =========================
                       SIDEBAR
                    ========================= */

            .admin-sidebar {
                width: 280px;
                background: #ffffff;
                border-right: 1px solid #e5e7eb;
                position: fixed;
                left: 0;
                top: 0;
                bottom: 0;
                z-index: 1000;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }


            /* =========================
                       BRAND
                    ========================= */

            .brand-section {
                height: 100px;
                min-height: 100px;
                display: flex;
                align-items: center;
                padding: 20px;
                border-bottom: 1px solid #f0f0f0;
            }


            .brand-icon {
                width: 52px;
                height: 52px;
                border-radius: 15px;
                background: linear-gradient(135deg, #8b5cf6, #a855f7);
                display: flex;
                align-items: center;
                justify-content: center;
                margin-right: 14px;
                box-shadow: 0 8px 20px rgba(139, 92, 246, 0.25);
            }


                .brand-icon i {
                    color: white;
                    font-size: 25px;
                }


            .brand-name {
                font-size: 21px;
                font-weight: 700;
                color: #172554;
                margin: 0;
            }


            .brand-subtitle {
                font-size: 12px;
                color: #9ca3af;
                margin-top: 3px;
            }


            /* =========================
                       SIDEBAR SCROLL AREA
                    ========================= */

            .sidebar-menu {
                flex: 1;
                overflow-y: auto;
                overflow-x: hidden;
                padding-bottom: 25px;
            }


                /* Sidebar scrollbar */

                .sidebar-menu::-webkit-scrollbar {
                    width: 6px;
                }


                .sidebar-menu::-webkit-scrollbar-track {
                    background: #ffffff;
                }


                .sidebar-menu::-webkit-scrollbar-thumb {
                    background: #d8c9f5;
                    border-radius: 10px;
                }


            /* =========================
                       MENU TITLE
                    ========================= */

            .menu-title {
                font-size: 12px;
                font-weight: 700;
                color: #aaa8b9;
                text-transform: uppercase;
                padding: 20px 24px 8px;
                margin: 0;
                letter-spacing: .5px;
            }


            /* =========================
                       SIDEBAR LINK
                    ========================= */

            .sidebar-link {
                display: flex;
                align-items: center;
                margin: 4px 16px;
                padding: 13px 14px;
                border-radius: 11px;
                color: #777489;
                text-decoration: none;
                font-size: 16px;
                line-height: 1.4;
                white-space: nowrap;
                transition: .2s;
            }


                /* =========================
                       SIDEBAR ICON
                    ========================= */

                .sidebar-link i {
                    width: 30px;
                    min-width: 30px;
                    font-size: 18px;
                    margin-right: 7px;
                    text-align: center;
                }


                /* =========================
                       HOVER
                    ========================= */

                .sidebar-link:hover {
                    background: #f4edff;
                    color: #7c3aed;
                }


                /* =========================
                       ACTIVE LINK
                    ========================= */

                .sidebar-link.active {
                    background: linear-gradient(135deg, #9748ef, #a855f7) !important;
                    color: #ffffff !important;
                    box-shadow: 0 7px 18px rgba(139, 92, 246, .25);
                }


                    .sidebar-link.active i {
                        color: #ffffff !important;
                    }


                    .sidebar-link.active:hover {
                        background: linear-gradient(135deg, #9748ef, #a855f7) !important;
                        color: #ffffff !important;
                    }


            /* =========================
                       MAIN AREA
                    ========================= */

            .admin-main {
                margin-left: 280px;
                width: calc(100% - 280px);
                min-height: 100vh;
            }


            /* =========================
                       HEADER
                    ========================= */

            .admin-header {
                height: 75px;
                background: #ffffff;
                border-bottom: 1px solid #e5e7eb;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                padding: 0 30px;
            }


            /* =========================
                       HEADER RIGHT
                    ========================= */

            .header-right {
                display: flex;
                align-items: center;
                gap: 14px;
            }


            /* =========================
                       ADMIN AVATAR
                    ========================= */

            .admin-avatar {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: linear-gradient(135deg, #8b5cf6, #a855f7);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                font-weight: 600;
            }


            /* =========================
                       ADMIN INFO
                    ========================= */

            .admin-info {
                line-height: 1.2;
            }


                .admin-info strong {
                    color: #27223a;
                    font-size: 14px;
                }


                .admin-info small {
                    color: #9994a7;
                    font-size: 12px;
                }


            /* =========================
                       CONTENT
                    ========================= */

            .admin-content {
                padding: 35px;
            }


            .page-title {
                font-size: 32px;
                font-weight: 700;
                color: #172554;
                margin-bottom: 5px;
            }


            .page-subtitle {
                color: #8d879b;
                margin-bottom: 30px;
            }


            /* =========================
                       CARDS
                    ========================= */

            .lab-card {
                background: white;
                border: 1px solid #eceaf1;
                border-radius: 15px;
                box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
            }


            /* =========================
                       BUTTON
                    ========================= */

            .btn-labsync {
                background: linear-gradient(135deg, #7c3aed, #a855f7);
                color: white;
                border: none;
                border-radius: 10px;
                padding: 11px 18px;
                font-weight: 600;
            }


                .btn-labsync:hover {
                    color: white;
                    opacity: .92;
                }


            /* =========================
                       TABLE
                    ========================= */

            .users-table {
                margin-bottom: 0;
            }


                .users-table thead th {
                    background: #faf9fc;
                    color: #777287;
                    font-size: 13px;
                    font-weight: 600;
                    padding: 16px;
                    border-bottom: 1px solid #eceaf1;
                }


                .users-table tbody td {
                    padding: 17px 16px;
                    border-bottom: 1px solid #f0eef4;
                    color: #4d4859;
                }


                .users-table tbody tr:hover {
                    background: #fcfaff;
                }


            .user-avatar {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: #f0e9ff;
                color: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-right: 12px;
            }


            .role-badge {
                background: #dff7ff;
                color: #0891b2;
                padding: 5px 11px;
                border-radius: 7px;
                font-size: 12px;
                font-weight: 600;
            }


            .status-active {
                background: #dcfce7;
                color: #15803d;
                padding: 5px 11px;
                border-radius: 7px;
                font-size: 12px;
                font-weight: 600;
            }


            .status-inactive {
                background: #f1f5f9;
                color: #64748b;
                padding: 5px 11px;
                border-radius: 7px;
                font-size: 12px;
                font-weight: 600;
            }


            .action-btn {
                width: 39px;
                height: 39px;
                border-radius: 8px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: white;
            }


            /* =========================
                       FORM
                    ========================= */

            .form-card {
                max-width: 760px;
                margin: 0 auto;
            }


            .form-label {
                color: #302b3d;
                font-weight: 600;
                margin-bottom: 8px;
            }


            .form-control,
            .form-select {
                border: 1px solid #ddd9e6;
                border-radius: 10px;
                padding: 12px 14px;
                min-height: 46px;
            }


                .form-control:focus,
                .form-select:focus {
                    border-color: #9b5cf6;
                    box-shadow: 0 0 0 .2rem rgba(139, 92, 246, .12);
                }


            .form-check-input:checked {
                background-color: #8b5cf6;
                border-color: #8b5cf6;
            }
            /* Brand */
            .brand-icon {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                border-radius: 0;
                flex-shrink: 0;
            }

                .brand-icon img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }


            /* =========================
                       MOBILE
                    ========================= */

            @@media (max-width: 900px) {

                .admin-sidebar {
                    width: 220px;
                }

                .admin-main {
                    margin-left: 220px;
                    width: calc(100% - 220px);
                }

                .admin-content {
                    padding: 25px;
                }
            }


            @@media (max-width: 700px) {

                .admin-sidebar {
                    width: 0;
                    border: none;
                }

                .admin-main {
                    margin-left: 0;
                    width: 100%;
                }

                .admin-header {
                    padding: 0 15px;
                }

                .admin-info {
                    display: none;
                }
            }

    </style>


    @RenderSection("Styles", required: false)

</head>


<body>

    <div class="admin-wrapper">


        <!-- ================= SIDEBAR ================= -->

        <aside class="admin-sidebar">


            <!-- ================= BRAND ================= -->

            <div class="brand-section">

                <div class="brand-icon">
                    <img src="~/images/Logo.png"
                         alt="LabSync Logo" />
                </div>


                <div>

                    <div class="brand-name">
                        LabSync
                    </div>

                    <div class="brand-subtitle">
                        Diagnostic Management
                    </div>

                </div>

            </div>


            <!-- ================= SIDEBAR MENU ================= -->

            <div class="sidebar-menu">


                <!-- ================= MAIN MENU ================= -->

                <div class="menu-title">
                    Main Menu
                </div>


                <!-- ================= DASHBOARD ================= -->

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="sidebar-link @(activeMenu == "Dashboard" ? "active" : "")">

                    <i class="bi bi-grid-fill"></i>

                    <span>Dashboard</span>

                </a>


                <!-- ================= USERS ================= -->

                <a asp-controller="Users"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Users" ? "active" : "")">

                    <i class="bi bi-people-fill"></i>

                    <span>Users</span>

                </a>


                <!-- ================= PATIENTS ================= -->

                <a asp-controller="Patients"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Patients" ? "active" : "")">

                    <i class="bi bi-person-vcard-fill"></i>

                    <span>Patients</span>

                </a>


                <!-- ================= APPOINTMENTS ================= -->

                <a asp-controller="Appointments"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Appointments" ? "active" : "")">

                    <i class="bi bi-calendar-check-fill"></i>

                    <span>Appointments</span>

                </a>


                <!-- ================= TESTS ================= -->

                <a asp-controller="Tests"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Tests" ? "active" : "")">

                    <i class="bi bi-eyedropper"></i>

                    <span>Tests</span>

                </a>


                <!-- ================= REFERRAL DOCTORS ================= -->

                <a asp-controller="ReferralDoctors"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "ReferralDoctors" ? "active" : "")">

                    <i class="bi bi-person-badge-fill"></i>

                    <span>Referral Doctors</span>

                </a>


                <!-- ================= OPERATIONS ================= -->

                <div class="menu-title">
                    Operations
                </div>


                <!-- ================= REPORTS ================= -->

                <a href="@Url.Action(
                                                             "Index",
                                                             "AdminReports",
                                                             new
                                                             {
                                                                 area = ""
                                                             })"
                   class="menu-item">

                    <i class="bi bi-file-earmark-medical-fill"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <!-- ================= INVOICES ================= -->

                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Invoices" ? "active" : "")">

                    <i class="bi bi-receipt"></i>

                    <span>Invoices</span>

                </a>


                <!-- ================= PAYMENTS ================= -->

                <a asp-controller="Payments"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Payments" ? "active" : "")">

                    <i class="bi bi-credit-card-fill"></i>

                    <span>Payments</span>

                </a>


                <!-- ================= ANALYTICS ================= -->

                <a asp-controller="Admin"
                   asp-action="Analytics"
                   class="sidebar-link @(currentController == "Admin" && currentAction == "Analytics" ? "active" : "")">

                    <i class="bi bi-bar-chart-fill"></i>

                    <span>Analytics</span>

                </a>


                


                <!-- ================= AUDIT LOGS ================= -->

                <a asp-controller="AuditLogs"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "AuditLogs" ? "active" : "")">

                    <i class="bi bi-clock-history"></i>

                    <span>Audit Logs</span>

                </a>


            </div>

        </aside>


        <!-- ================= MAIN ================= -->

        <main class="admin-main">


            <!-- ================= HEADER ================= -->

            <header class="admin-header">


                <!-- ================= ADMIN PROFILE ================= -->

                <div class="header-right">

                    <div class="admin-avatar">
                        A
                    </div>


                    <div class="admin-info">

                        <strong>Admin</strong>

                        <br />

                        <small>Administrator</small>

                    </div>

                </div>

            </header>


            <!-- ================= CONTENT ================= -->

            <div class="admin-content">

                @RenderBody()

            </div>


        </main>

    </div>


    <!-- Bootstrap JS -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>