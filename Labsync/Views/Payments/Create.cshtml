@model LabSync.Models.Payment

@{
    ViewData["Title"] = "Add Payment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Add Payment</h2>
            <p class="text-muted mb-0">
                Record a new payment transaction
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Payments
        </a>
    </div>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="row g-4">

            <!-- Payment Information -->
            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-credit-card me-2"></i>
                            Payment Information
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-3">

                            <!-- Invoice -->
                            <div class="col-md-6">
                                <label asp-for="InvoiceId"
                                       class="form-label fw-semibold">
                                    Invoice
                                </label>

                                <select asp-for="InvoiceId"
                                        class="form-select"
                                        required>
                                    <option value="">
                                        -- Select Invoice --
                                    </option>

                                    @if (ViewBag.Invoices != null)
                                    {
                                        foreach (var invoice in ViewBag.Invoices)
                                        {
                                            <option value="@invoice.Id">
                                                @(invoice.InvoiceNumber
                                                    ?? $"Invoice #{invoice.Id}")
                                                - Due:
                                                @invoice.DueAmount.ToString("N2")
                                            </option>
                                        }
                                    }
                                </select>

                                <span asp-validation-for="InvoiceId"
                                      class="text-danger"></span>
                            </div>

                            <!-- Payment Method -->
                            <div class="col-md-6">
                                <label asp-for="PaymentMethodId"
                                       class="form-label fw-semibold">
                                    Payment Method
                                </label>

                                <select asp-for="PaymentMethodId"
                                        class="form-select"
                                        required>
                                    <option value="">
                                        -- Select Payment Method --
                                    </option>

                                    @if (ViewBag.PaymentMethods != null)
                                    {
                                        foreach (var method in ViewBag.PaymentMethods)
                                        {
                                            <option value="@method.Id">
                                                @method.MethodName
                                            </option>
                                        }
                                    }
                                </select>

                                <span asp-validation-for="PaymentMethodId"
                                      class="text-danger"></span>
                            </div>

                            <!-- Amount -->
                            <div class="col-md-6">
                                <label asp-for="Amount"
                                       class="form-label fw-semibold">
                                    Payment Amount
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        ৳
                                    </span>

                                    <input asp-for="Amount"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0.01"
                                           required />
                                </div>

                                <span asp-validation-for="Amount"
                                      class="text-danger"></span>
                            </div>

                            <!-- Payment Date -->
                            <div class="col-md-6">
                                <label asp-for="PaymentDate"
                                       class="form-label fw-semibold">
                                    Payment Date
                                </label>

                                <input asp-for="PaymentDate"
                                       class="form-control"
                                       type="date"
                                       value="@DateTime.Now.ToString("yyyy-MM-dd")" />

                                <span asp-validation-for="PaymentDate"
                                      class="text-danger"></span>
                            </div>

                            <!-- Transaction Number -->
                            <div class="col-md-6">
                                <label asp-for="TransactionNumber"
                                       class="form-label fw-semibold">
                                    Transaction Number
                                </label>

                                <input asp-for="TransactionNumber"
                                       class="form-control"
                                       placeholder="e.g. TXN123456" />

                                <span asp-validation-for="TransactionNumber"
                                      class="text-danger"></span>
                            </div>

                            <!-- Remarks -->
                            <div class="col-md-6">
                                <label asp-for="Remarks"
                                       class="form-label fw-semibold">
                                    Remarks
                                </label>

                                <input asp-for="Remarks"
                                       class="form-control"
                                       placeholder="Optional remarks" />

                                <span asp-validation-for="Remarks"
                                      class="text-danger"></span>
                            </div>

                        </div>

                    </div>
                </div>

            </div>

            <!-- Payment Summary -->
            <div class="col-lg-4">

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-receipt me-2"></i>
                            Payment Summary
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Select an invoice and enter the payment
                            amount.
                        </div>

                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>
                                Save Payment
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </div>
                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
