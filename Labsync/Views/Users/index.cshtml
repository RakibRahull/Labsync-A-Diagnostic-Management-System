@model List<LabSync.Models.UserManagementViewModel>

@{
    ViewData["Title"] = "Manage Users";
    Layout = null;

    var logoutUrl =
        Url.Action(
            "Logout",
            "Account",
            new
            {
                area = ""
            });
}


<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        LabSync - Manage Users
    </title>


    <!-- =====================================================
         BOOTSTRAP
    ====================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         BOOTSTRAP ICONS
    ====================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- SITE CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" />


    <style>

            /* TOPBAR */

            .topbar {
                height: 85px;
                background: #ffffff;
                border-bottom: 1px solid #e8e5ef;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                padding: 0 28px;
            }


            .topbar-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                justify-content: flex-end;
            }


            /* PROFILE */

            .profile {
                border: none;
                background: transparent;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 0 5px 8px;
                cursor: pointer;
            }


                .profile:focus {
                    box-shadow: none;
                    outline: none;
                }


                .profile::after {
                    margin-left: 5px;
                    color: #8f899d;
                }


            .profile-avatar {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                font-weight: 700;
                box-shadow: 0 7px 18px rgba(139, 92, 246, 0.28);
            }


            .profile-info {
                display: flex;
                flex-direction: column;
                text-align: left;
                line-height: 1.2;
            }


                .profile-info strong {
                    color: #29243a;
                    font-size: 15px;
                    font-weight: 700;
                }


                .profile-info small {
                    color: #9993a8;
                    font-size: 12px;
                    margin-top: 3px;
                }


            /*  DASHBOARD ACTIVE */

            .sidebar .menu-item.dashboard-active {
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 ) !important;
                color: #ffffff !important;
                border-radius: 11px;
                box-shadow: 0 7px 18px rgba(139, 92, 246, 0.25);
            }


                .sidebar .menu-item.dashboard-active i {
                    color: #ffffff !important;
                }


                .sidebar .menu-item.dashboard-active span {
                    color: #ffffff !important;
                }


                .sidebar .menu-item.dashboard-active:hover {
                    background: linear-gradient( 135deg, #7c3aed, #a855f7 ) !important;
                    color: #ffffff !important;
                }


                    .sidebar .menu-item.dashboard-active:hover i,
                    .sidebar .menu-item.dashboard-active:hover span {
                        color: #ffffff !important;
                    }


            /* PROFILE DROPDOWN */

            .profile-dropdown {
                margin-top: 10px !important;
                min-width: 190px;
                border: 1px solid #eeeaf5;
                border-radius: 12px;
                padding: 8px;
                box-shadow: 0 12px 30px rgba(30, 20, 50, 0.12);
            }


                /* =====================================================
                                   LOGOUT FORM
                                ====================================================== */

                .profile-dropdown .logout-form {
                    margin: 0;
                    padding: 0;
                }


                /* =====================================================
                                   LOGOUT BUTTON
                                ====================================================== */

                .profile-dropdown .logout-item {
                    width: 100%;
                    border: none;
                    background: transparent;
                    border-radius: 8px;
                    padding: 11px 12px;
                    color: #dc2626;
                    font-size: 14px;
                    font-family: inherit;
                    text-align: left;
                    cursor: pointer;
                    transition: .2s ease;
                }


                    .profile-dropdown .logout-item:hover {
                        background: #fef2f2;
                        color: #dc2626;
                    }


                    .profile-dropdown .logout-item i {
                        width: 22px;
                        margin-right: 7px;
                    }

            /* =====================================================
                                               Brand
                                            ====================================================== */
            .brand-icon {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                border-radius: 0;
                flex-shrink: 0;
            }

                .brand-icon img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }
            /* =====================================================
                                   SIDEBAR LOGOUT
                                ====================================================== */

            .sidebar-logout-form {
                margin: 0;
                padding: 0;
            }


            .sidebar-logout-button {
                width: 100%;
                border: none;
                background: transparent;
                text-align: left;
                cursor: pointer;
                font-family: inherit;
            }


                .sidebar-logout-button:hover {
                    background: #fef2f2 !important;
                    color: #dc2626 !important;
                }


                    .sidebar-logout-button:hover i,
                    .sidebar-logout-button:hover span {
                        color: #dc2626 !important;
                    }


            /* =====================================================
                       USERS PAGE
                    ====================================================== */

            .users-content {
                padding: 30px;
            }


            /* =====================================================
                       PAGE HEADER
                    ====================================================== */

            .users-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 20px;
                margin-bottom: 28px;
            }


            .users-header-left {
                display: flex;
                flex-direction: column;
            }


            .users-page-title {
                margin: 0;
                color: #18213a;
                font-size: 36px;
                font-weight: 700;
                line-height: 1.15;
                letter-spacing: -0.6px;
            }


            .users-page-subtitle {
                margin: 7px 0 0;
                color: #9296aa;
                font-size: 16px;
                line-height: 1.5;
            }


            /* =====================================================
                       ADD USER
                    ====================================================== */

            .add-user-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                min-height: 46px;
                padding: 0 18px;
                border: none;
                border-radius: 10px;
                background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
                color: #ffffff !important;
                font-size: 14px;
                font-weight: 700;
                text-decoration: none;
                box-shadow: 0 7px 18px rgba(139, 92, 246, 0.22);
                transition: .2s ease;
            }


                .add-user-button:hover {
                    color: #ffffff !important;
                    transform: translateY(-1px);
                    box-shadow: 0 9px 22px rgba(139, 92, 246, 0.28);
                }


                .add-user-button i {
                    font-size: 16px;
                }


            /* =====================================================
                       ALERTS
                    ====================================================== */

            .users-alert {
                border-radius: 11px;
                font-size: 14px;
                border: none;
                margin-bottom: 20px;
            }


            /* =====================================================
                       SEARCH CARD
                    ====================================================== */

            .users-search-card {
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 16px;
                padding: 19px;
                margin-bottom: 22px;
                box-shadow: 0 5px 20px rgba(30, 20, 50, 0.04);
            }


            .users-search-form {
                display: flex;
                align-items: center;
                gap: 10px;
                width: 100%;
            }


            .users-search-input-wrapper {
                flex: 1;
                position: relative;
            }


            .users-search-input-icon {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #81798d;
                font-size: 18px;
                pointer-events: none;
            }


            .users-search-input {
                width: 100%;
                height: 48px;
                border: 1px solid #ddd9e5;
                border-radius: 10px;
                background: #ffffff;
                padding: 0 16px 0 44px;
                color: #29243a;
                font-size: 14px;
                outline: none;
                transition: .2s ease;
            }


                .users-search-input::placeholder {
                    color: #a39cab;
                }


                .users-search-input:focus {
                    border-color: #9b5cff;
                    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.08);
                }


            /* =====================================================
                       SEARCH BUTTON
                    ====================================================== */

            .users-search-button {
                height: 48px;
                min-width: 130px;
                border: none;
                border-radius: 10px;
                background: #212529;
                color: #ffffff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: .2s ease;
            }


                .users-search-button:hover {
                    background: #151719;
                }


                .users-search-button i {
                    font-size: 17px;
                }


            /* =====================================================
                       TABLE CARD
                    ====================================================== */

            .users-table-card {
                background: #ffffff;
                border: 1px solid #e8e5ef;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(30, 20, 50, 0.03);
            }


            /* =====================================================
                       TABLE
                    ====================================================== */

            .users-table {
                width: 100%;
                margin: 0;
                border-collapse: collapse;
            }


                .users-table thead th {
                    background: #faf9fc;
                    padding: 16px 18px;
                    border-bottom: 1px solid #ebe8f0;
                    color: #6f6a7d;
                    font-size: 12px;
                    font-weight: 700;
                    white-space: nowrap;
                }


                .users-table tbody td {
                    padding: 18px 18px;
                    border-bottom: 1px solid #f0edf4;
                    color: #514b61;
                    font-size: 14px;
                    vertical-align: middle;
                    white-space: nowrap;
                }


                .users-table tbody tr:last-child td {
                    border-bottom: none;
                }


                .users-table tbody tr:hover {
                    background: #fcfbff;
                }


            /* =====================================================
                       USER AVATAR
                    ====================================================== */

            .user-cell {
                display: flex;
                align-items: center;
                gap: 12px;
            }


            .user-avatar {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                background: #f0e8ff;
                color: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                font-size: 17px;
            }


            .user-email {
                color: #302b40;
                font-size: 14px;
                font-weight: 700;
            }


            /* =====================================================
                       ROLE BADGE
                    ====================================================== */

            .role-badge {
                display: inline-flex;
                align-items: center;
                padding: 7px 12px;
                background: #def5ff;
                color: #1398c7;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
            }


            /* =====================================================
                       STATUS
                    ====================================================== */

            .status-active {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                padding: 7px 11px;
                background: #dcfce7;
                color: #159447;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
            }


            .status-inactive {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                padding: 7px 11px;
                background: #fee2e2;
                color: #dc2626;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
            }


            /* =====================================================
                       CREATED
                    ====================================================== */

            .created-date {
                color: #5b5666;
                font-size: 14px;
            }


            /* =====================================================
                       ACTIONS
                    ====================================================== */

            .users-actions {
                display: flex;
                justify-content: flex-end;
                align-items: center;
                gap: 8px;
            }


            .user-action-button {
                width: 42px;
                height: 42px;
                padding: 0;
                border-radius: 9px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: #ffffff;
                font-size: 16px;
                transition: .2s ease;
            }


                .user-action-button:hover {
                    transform: translateY(-1px);
                }


            /* =====================================================
                       EMPTY STATE
                    ====================================================== */

            .users-empty {
                padding: 70px 25px;
                text-align: center;
            }


            .users-empty-icon {
                width: 64px;
                height: 64px;
                border-radius: 16px;
                background: #f1eaff;
                color: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 15px;
                font-size: 28px;
            }


            .users-empty h5 {
                color: #302b40;
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 6px;
            }


            .users-empty p {
                color: #9993a8;
                font-size: 13px;
                margin: 0;
            }


            /* =====================================================
                       MOBILE
                    ====================================================== */

            @@media (max-width: 900px) {

                .users-header {
                    flex-direction: column;
                    gap: 18px;
                }


                .add-user-button {
                    align-self: flex-start;
                }


                .users-search-form {
                    flex-direction: column;
                }


                .users-search-input-wrapper,
                .users-search-button {
                    width: 100%;
                }
            }


            @@media (max-width: 700px) {

                .topbar {
                    padding: 0 15px;
                }


                .profile-info {
                    display: none;
                }


                .users-content {
                    padding: 20px 15px;
                }


                .users-page-title {
                    font-size: 28px;
                }


                .users-page-subtitle {
                    font-size: 14px;
                }


                .users-search-card {
                    padding: 15px;
                }
            }

    </style>

</head>


<body>


    <div class="dashboard-page">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- BRAND -->

            <div class="brand">


                <div class="brand-icon">
                    <img src="~/images/Logo.png"
                         alt="LabSync Logo" />
                </div>


                <div>

                    <h4>
                        LabSync
                    </h4>

                    <small>
                        Diagnostic Management
                    </small>

                </div>


            </div>


            <!-- =================================================
                 SIDEBAR MENU
            ================================================== -->

            <div class="sidebar-menu">


                <!-- MAIN MENU -->

                <p class="menu-title">
                    MAIN MENU
                </p>


                <!-- DASHBOARD -->

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="menu-item">


                    <i class="bi bi-grid-1x2-fill"></i>


                    <span>
                        Dashboard
                    </span>


                </a>


                <!-- USERS -->

                <a asp-controller="Users"
                   asp-action="Index"
                   class="menu-item active">


                    <i class="bi bi-people-fill"></i>


                    <span>
                        Users
                    </span>


                </a>


                <!-- PATIENTS -->

                <a asp-controller="Patients"
                   asp-action="Index"
                   class="menu-item">


                    <i class="bi bi-person-vcard-fill"></i>


                    <span>
                        Patients
                    </span>


                </a>


                <!-- APPOINTMENTS -->

                <a asp-controller="Admin"
                   asp-action="AppointmentDetails"
                   class="menu-item">


                    <i class="bi bi-calendar-check-fill"></i>


                    <span>
                        Appointments
                    </span>


                </a>


                <!-- TESTS -->

                <a asp-controller="Tests"
                   asp-action="Index"
                   class="menu-item">


                    <i class="bi bi-eyedropper"></i>


                    <span>
                        Tests
                    </span>


                </a>


                <!-- REFERRAL DOCTORS -->

                <a asp-controller="ReferralDoctors"
                   asp-action="Index"
                   class="menu-item">


                    <i class="bi bi-person-badge"></i>


                    <span>
                        Referral Doctors
                    </span>


                </a>


                <!-- =================================================
                     OPERATIONS
                ================================================== -->

                <p class="menu-title mt-4">
                    OPERATIONS
                </p>


                <!-- REPORTS -->

                <a href="@Url.Action(
                                          "Index",
                                          "AdminReports",
                                          new
                                          {
                                              area = ""
                                          })"
                   class="menu-item">


                    <i class="bi bi-file-earmark-medical-fill"></i>


                    <span>
                        Reports
                    </span>


                </a>


                <!-- INVOICES -->

                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="menu-item">


                    <i class="bi bi-receipt-cutoff"></i>


                    <span>
                        Invoices
                    </span>


                </a>


                <!-- PAYMENTS -->

                <a asp-controller="Payments"
                   asp-action="Index"
                   class="menu-item">


                    <i class="bi bi-credit-card-fill"></i>


                    <span>
                        Payments
                    </span>


                </a>


                <!-- ANALYTICS -->

                <a asp-controller="Admin"
                   asp-action="Analytics"
                   class="menu-item">


                    <i class="bi bi-bar-chart-fill"></i>


                    <span>
                        Analytics
                    </span>


                </a>


                <!-- AUDIT LOGS -->

                <a asp-controller="Admin"
                   asp-action="AuditLogs"
                   class="menu-item">


                    <i class="bi bi-clock-history"></i>


                    <span>
                        Audit Logs
                    </span>


                </a>


                


                


            </div>


        </aside>


        <!-- =====================================================
             MAIN
        ====================================================== -->

        <main class="dashboard-main">


            <!-- =================================================
                 TOPBAR
            ================================================== -->

            <header class="topbar">


                <div class="topbar-right">


                    <!-- ADMIN PROFILE -->

                    <div class="dropdown">


                        <!-- PROFILE BUTTON -->

                        <button class="profile dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">


                            <div class="profile-avatar">

                                A

                            </div>


                            <div class="profile-info">

                                <strong>
                                    Admin
                                </strong>

                                <small>
                                    Administrator
                                </small>

                            </div>


                        </button>


                        <!-- =================================================
                             DROPDOWN
                             ONLY LOGOUT
                        ================================================== -->

                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">


                            <li>


                                <form action="@logoutUrl"
                                      method="post"
                                      class="logout-form">


                                    @Html.AntiForgeryToken()


                                    <button type="submit"
                                            class="logout-item">


                                        <i class="bi bi-box-arrow-right"></i>


                                        Logout


                                    </button>


                                </form>


                            </li>


                        </ul>


                    </div>


                </div>


            </header>


            <!-- =================================================
                 USERS CONTENT
            ================================================== -->

            <div class="users-content">


                <!-- =================================================
                     PAGE HEADER
                ================================================== -->

                <div class="users-header">


                    <div class="users-header-left">


                        <h1 class="users-page-title">
                            Manage Users
                        </h1>


                        <p class="users-page-subtitle">
                            Manage LabSync system users and their roles.
                        </p>


                    </div>


                    <!-- ADD USER -->

                    <a asp-controller="Users"
                       asp-action="Create"
                       class="add-user-button">


                        <i class="bi bi-person-plus-fill"></i>


                        <span>
                            Add User
                        </span>


                    </a>


                </div>


                <!-- =================================================
                     SUCCESS ALERT
                ================================================== -->
                @if (TempData["Success"] != null)
                {

                    <div class="alert alert-success alert-dismissible fade show users-alert"
                         role="alert">


                        <i class="bi bi-check-circle-fill me-2"></i>


                        @TempData["Success"]


                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>


                    </div>

                }


                <!-- =================================================
                     ERROR ALERT
                ================================================== -->
                @if (TempData["Error"] != null)
                {

                    <div class="alert alert-danger alert-dismissible fade show users-alert"
                         role="alert">


                        <i class="bi bi-exclamation-triangle-fill me-2"></i>


                        @TempData["Error"]


                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>


                    </div>

                }


                <!-- =================================================
                     SEARCH CARD
                ================================================== -->

                <div class="users-search-card">


                    <form asp-controller="Users"
                          asp-action="Index"
                          method="get"
                          class="users-search-form">


                        <div class="users-search-input-wrapper">


                            <i class="bi bi-search users-search-input-icon"></i>


                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="users-search-input"
                                   placeholder="Search by email..."
                                   autocomplete="off" />


                        </div>


                        <button type="submit"
                                class="users-search-button">


                            <i class="bi bi-search"></i>


                            <span>
                                Search
                            </span>


                        </button>


                    </form>


                </div>


                <!-- =================================================
                     TABLE CARD
                ================================================== -->

                <div class="users-table-card">


                    <div class="table-responsive">


                        <table class="table users-table align-middle">


                            <!-- TABLE HEADER -->

                            <thead>


                                <tr>


                                    <th class="ps-4">
                                        #
                                    </th>


                                    <th>
                                        Email
                                    </th>


                                    <th>
                                        Role
                                    </th>


                                    <th>
                                        Status
                                    </th>


                                    <th>
                                        Created
                                    </th>


                                    <th class="text-end pe-4">
                                        Actions
                                    </th>


                                </tr>


                            </thead>


                            <!-- TABLE BODY -->

                            <tbody>


                                @if (
                                    Model != null &&
                                    Model.Any()
                                )
                                {

                                    var counter = 1;


                                    foreach (var user in Model)
                                    {

                                        <tr>


                                            <!-- NUMBER -->

                                            <td class="ps-4">

                                                @counter

                                            </td>


                                            <!-- EMAIL -->

                                            <td>


                                                <div class="user-cell">


                                                    <div class="user-avatar">

                                                        <i class="bi bi-person-fill"></i>

                                                    </div>


                                                    <strong class="user-email">

                                                        @user.Email

                                                    </strong>


                                                </div>


                                            </td>


                                            <!-- ROLE -->

                                            <td>


                                                <span class="role-badge">

                                                    @user.RoleName

                                                </span>


                                            </td>


                                            <!-- STATUS -->

                                            <td>


                                                @if (user.IsActive)
                                                {

                                                    <span class="status-active">


                                                        <i class="bi bi-check-circle"></i>


                                                        Active


                                                    </span>

                                                }
                                                else
                                                {

                                                    <span class="status-inactive">


                                                        <i class="bi bi-x-circle"></i>


                                                        Inactive


                                                    </span>

                                                }


                                            </td>


                                            <!-- CREATED -->

                                            <td>


                                                <span class="created-date">

                                                    @user.CreatedAt.ToString(
                                                        "dd MMM yyyy"
                                                    )

                                                </span>


                                            </td>


                                            <!-- ACTIONS -->

                                            <td class="text-end pe-4">


                                                <div class="users-actions">


                                                    <!-- EDIT -->

                                                    <a asp-controller="Users"
                                                       asp-action="Edit"
                                                       asp-route-id="@user.Id"
                                                       class="btn btn-outline-primary user-action-button"
                                                       title="Edit User">


                                                        <i class="bi bi-pencil"></i>


                                                    </a>


                                                    <!-- TOGGLE STATUS -->

                                                    <form asp-controller="Users"
                                                          asp-action="ToggleStatus"
                                                          method="post"
                                                          class="d-inline">


                                                        @Html.AntiForgeryToken()


                                                        <input type="hidden"
                                                               name="id"
                                                               value="@user.Id" />


                                                        @if (user.IsActive)
                                                        {

                                                            <button type="submit"
                                                                    class="btn btn-outline-warning user-action-button"
                                                                    title="Deactivate">


                                                                <i class="bi bi-person-dash"></i>


                                                            </button>

                                                        }
                                                        else
                                                        {

                                                            <button type="submit"
                                                                    class="btn btn-outline-success user-action-button"
                                                                    title="Activate">


                                                                <i class="bi bi-person-check"></i>


                                                            </button>

                                                        }


                                                    </form>


                                                    


                                                </div>


                                            </td>


                                        </tr>


                                        counter++;

                                    }

                                }
                                else
                                {

                                    <!-- NO USERS -->

                                    <tr>


                                        <td colspan="6">


                                            <div class="users-empty">


                                                <div class="users-empty-icon">

                                                    <i class="bi bi-people"></i>

                                                </div>


                                                <h5>
                                                    No users found
                                                </h5>


                                                <p>
                                                    No users match your search.
                                                </p>


                                            </div>


                                        </td>


                                    </tr>

                                }


                            </tbody>


                        </table>


                    </div>


                </div>


            </div>


        </main>


    </div>


    <!-- =====================================================
         BOOTSTRAP JS
    ====================================================== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>


</body>

</html>