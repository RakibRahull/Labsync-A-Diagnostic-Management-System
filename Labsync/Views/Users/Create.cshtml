    <!-- =====================================================
         PASSWORD TOGGLE SCRIPT
    ====================================================== -->

    <script>

            document.addEventListener("DOMContentLoaded", function() {

                const passwordInput =
                    document.getElementById("passwordInput");

                const passwordToggle =
                    document.getElementById("passwordToggle");

                const passwordToggleIcon =
                    document.getElementById("passwordToggleIcon");

                if (!passwordInput ||
                    !passwordToggle ||
                    !passwordToggleIcon) {
                    return;
                }

                passwordToggle.addEventListener("click", function() {

                    const isPassword =
                        passwordInput.type === "password";

                    passwordInput.type =
                        isPassword ? "text" : "password";

                    passwordToggleIcon.classList.toggle(
                        "bi-eye",
                        !isPassword
                    );

                    passwordToggleIcon.classList.toggle(
                        "bi-eye-slash",
                        isPassword
                    );

                    passwordToggle.setAttribute(
                        "aria-label",
                        isPassword ? "Hide password" : "Show password"
                    );

                    passwordToggle.setAttribute(
                        "title",
                        isPassword ? "Hide password" : "Show password"
                    );

                });

            });

    </script>


    <!-- =====================================================
         CITY SEARCH SCRIPT
    ====================================================== -->

    <script>

            document.addEventListener("DOMContentLoaded", function() {

                const citySearch =
                    document.getElementById("citySearch");

                const cityId =
                    document.getElementById("cityId");

                const cityError =
                    document.getElementById("cityError");

                const cityOptions =
                    document.querySelectorAll(
                        "#cityOptions option"
                    );


                function findCityId(cityName) {

                    const typedName =
                        cityName.trim().toLowerCase();


                    for (const option of cityOptions) {

                        const optionName =
                            (option.value || "")
                                .trim()
                                .toLowerCase();


                        if (optionName === typedName) {

                            return option.dataset.id || "";

                        }

                    }


                    return "";

                }


                citySearch.addEventListener(
                    "input",
                    function() {

                        const selectedCityId =
                            findCityId(citySearch.value);


                        cityId.value =
                            selectedCityId;


                        if (selectedCityId) {

                            cityError.style.display =
                                "none";

                        }

                    }
                );


                citySearch.addEventListener(
                    "change",
                    function() {

                        const selectedCityId =
                            findCityId(citySearch.value);


                        cityId.value =
                            selectedCityId;


                        if (!selectedCityId &&
                            citySearch.value.trim() !== "") {

                            cityError.style.display =
                                "block";

                        }
                        else {

                            cityError.style.display =
                                "none";

                        }

                    }
                );


                const form =
                    citySearch.closest("form");


                if (form) {

                    form.addEventListener(
                        "submit",
                        function(event) {

                            const typedCity =
                                citySearch.value.trim();


                            if (typedCity !== "" &&
                                !cityId.value) {

                                event.preventDefault();

                                cityError.style.display =
                                    "block";

                                citySearch.focus();

                                return;

                            }

                            if (typedCity === "") {

                                cityId.value = "";

                            }

                        }
                    );

                }

            });

    </script>

