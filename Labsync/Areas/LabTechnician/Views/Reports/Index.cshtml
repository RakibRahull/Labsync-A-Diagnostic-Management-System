@model List<LabSync.Models.ReportListRowViewModel>

@{
    ViewData["Title"] = "Reports";

    Layout =
        "~/Areas/LabTechnician/Views/Shared/_LabTechnicianLayout.cshtml";

    var appointmentId =
        ViewBag.AppointmentId as string ?? "";
}


<style>

    .reports-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .reports-title {
        margin: 0;
        color: #18213a;
        font-size: 36px;
        font-weight: 700;
    }

    .reports-subtitle {
        margin: 7px 0 0;
        color: #9296aa;
        font-size: 15px;
    }


    .reports-alert {
        margin-bottom: 20px;
        padding: 13px 15px;
        border-radius: 10px;
        font-size: 13px;
    }

    .reports-success {
        border: 1px solid #b9e3c8;
        background: #f1fbf4;
        color: #15803d;
    }

    .reports-error {
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #b91c1c;
    }


    .reports-search-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 16px;
        padding: 20px 22px;
        margin-bottom: 22px;
        box-shadow: 0 5px 20px rgba(30,20,50,.04);
    }

    .reports-search-form {
        display: flex;
        align-items: flex-end;
        gap: 12px;
    }

    .reports-search-area {
        flex: 1;
    }

    .reports-label {
        display: block;
        margin-bottom: 8px;
        color: #000000;
        font-size: 13px;
        font-weight: 700;
    }

    .reports-input {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        border: 1px solid #e8e5ef;
        border-radius: 10px;
        outline: none;
        color: #000000;
        box-sizing: border-box;
    }

    .reports-search-button {
        height: 48px;
        padding: 0 20px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg,#8b5cf6,#a855f7);
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }


    .reports-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(30,20,50,.04);
    }

    .reports-card-header {
        padding: 20px 22px;
        border-bottom: 1px solid #eeeaf3;
    }

        .reports-card-header h5 {
            margin: 0;
            color: #000000;
            font-size: 18px;
            font-weight: 700;
        }


    .reports-table-wrapper {
        overflow-x: auto;
    }

    .reports-table {
        width: 100%;
        min-width: 1100px;
        border-collapse: collapse;
    }

        .reports-table th {
            padding: 14px 16px;
            background: #faf9fc;
            border-bottom: 1px solid #ebe8f0;
            color: #000000;
            text-align: left;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .reports-table td {
            padding: 16px;
            border-bottom: 1px solid #f0edf4;
            color: #000000;
            font-size: 13px;
            vertical-align: middle;
        }


    .report-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

        .report-status.pending {
            background: #fff7df;
            color: #b98100;
        }

        .report-status.approved {
            background: #eaf8ef;
            color: #159447;
        }

        .report-status.rejected {
            background: #fef2f2;
            color: #dc2626;
        }


    .report-action {
        height: 36px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        margin-right: 5px;
    }

    .report-view {
        border: 1px solid #b8d5f7;
        background: #f4f9ff;
        color: #4385dd;
    }

    .report-download {
        border: 1px solid #b9e3c8;
        background: #f4fcf6;
        color: #159447;
    }


    .reports-empty {
        padding: 70px 25px;
        text-align: center;
    }

    .reports-empty-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 15px;
        border-radius: 16px;
        background: #f1eaff;
        color: #8b5cf6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
    }

    .reports-empty h5 {
        margin: 0 0 7px;
        color: #000000;
    }

    .reports-empty p {
        margin: 0;
        color: #666666;
        font-size: 13px;
    }


    @@media (max-width: 700px) {

        .reports-header {
            flex-direction: column;
        }

        .reports-search-form {
            flex-direction: column;
            align-items: stretch;
        }

        .reports-search-button {
            width: 100%;
        }
    }

</style>


<div class="reports-header">

    <div>

        <h1 class="reports-title">
            Reports
        </h1>

        <p class="reports-subtitle">
            Generated laboratory reports and their approval status.
        </p>

    </div>

</div>


@if (TempData["Success"] != null)
{
    <div class="reports-alert reports-success">

        <i class="bi bi-check-circle-fill"></i>

        @TempData["Success"]

    </div>
}


@if (TempData["Error"] != null)
{
    <div class="reports-alert reports-error">

        <i class="bi bi-exclamation-circle-fill"></i>

        @TempData["Error"]

    </div>
}


<div class="reports-search-card">

    <form method="get"
          action="@Url.Action(
                              "Index",
                              "Reports",
                              new
                              {
                                  area = "LabTechnician"
                              })">

        <div class="reports-search-form">

            <div class="reports-search-area">

                <label class="reports-label">
                    Appointment ID
                </label>

                <input type="text"
                       name="appointmentId"
                       value="@appointmentId"
                       class="reports-input"
                       placeholder="Enter Appointment ID..." />

            </div>


            <button type="submit"
                    class="reports-search-button">

                <i class="bi bi-search"></i>

                Search Reports

            </button>

        </div>

    </form>

</div>


<div class="reports-card">

    <div class="reports-card-header">

        <h5>
            Laboratory Reports
        </h5>

    </div>


    @if (
        Model != null
        &&
        Model.Count > 0
    )
    {
        <div class="reports-table-wrapper">

            <table class="reports-table">

                <thead>

                    <tr>

                        <th>
                            Report Number
                        </th>

                        <th>
                            Appointment ID
                        </th>

                        <th>
                            Patient
                        </th>

                        <th>
                            Generated By
                        </th>

                        <th>
                            Generated Date
                        </th>

                        <th>
                            Approval Status
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @{
                        var serial = 1;
                    }


                    @foreach (var report in Model)
                    {
                        var statusClass =
                            report.ApprovalStatusId == 1
                                ? "pending"
                                : report.ApprovalStatusId == 2
                                    ? "approved"
                                    : "rejected";


                        var statusIcon =
                            report.ApprovalStatusId == 1
                                ? "bi-clock"
                                : report.ApprovalStatusId == 2
                                    ? "bi-check-circle-fill"
                                    : "bi-x-circle-fill";


                        <tr>

                            <td>
                                @serial
                            </td>


                            <td>

                                <strong>
                                    @report.AppointmentCode
                                </strong>

                            </td>


                            <td>

                                <strong>
                                    @report.PatientName
                                </strong>

                                <br />

                                <small>
                                    @(report.PatientCode ?? "N/A")
                                </small>

                            </td>


                            <td>
                                @(report.GeneratedByEmail ?? "N/A")
                            </td>


                            <td>

                                @(
                                    report.GeneratedDate.HasValue
                                        ? report.GeneratedDate.Value.ToString(
                                            "dd/MM/yyyy hh:mm tt")
                                        : "N/A"
                                )

                            </td>


                            <td>

                                <span class="report-status @statusClass">

                                    <i class="bi @statusIcon"></i>

                                    @report.ApprovalStatusName

                                </span>

                            </td>


                            <td>

                                <a href="@Url.Action(
                                                                                "ViewPdf",
                                                                                "Reports",
                                                                                new
                                                                                {
                                                                                    area = "LabTechnician",
                                                                                    id = report.Id
                                                                                })"
                                   target="_blank"
                                   class="report-action report-view">

                                    <i class="bi bi-eye"></i>

                                    View PDF

                                </a>


                                <a href="@Url.Action(
                                                                                "DownloadPdf",
                                                                                "Reports",
                                                                                new
                                                                                {
                                                                                    area = "LabTechnician",
                                                                                    id = report.Id
                                                                                })"
                                   class="report-action report-download">

                                    <i class="bi bi-download"></i>

                                    Download

                                </a>

                            </td>

                        </tr>


                        serial++;
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="reports-empty">

            <div class="reports-empty-icon">

                <i class="bi bi-file-earmark-medical"></i>

            </div>

            <h5>
                No Reports Found
            </h5>

            <p>
                Generated reports will appear here after report generation.
            </p>

        </div>
    }

</div>