@model LabSync.Models.Appointment

@{
    ViewData["Title"] = "Add Appointment";

    Layout =
        "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";


    var availableTests =
        ViewBag.Tests as IEnumerable<LabSync.Models.Test>
        ?? Enumerable.Empty<LabSync.Models.Test>();


    var selectedTestIds =
        ViewBag.SelectedTestIds as IEnumerable<int>
        ?? Enumerable.Empty<int>();


    var findPatientUrl =
        Url.Action(
            "FindPatient",
            "Appointments",
            new
            {
                area = "Receptionist"
            });


    var findDoctorUrl =
        Url.Action(
            "FindReferralDoctor",
            "Appointments",
            new
            {
                area = "Receptionist"
            });


    var hasSelectedPatient =
        Model.PatientId > 0 &&
        Model.Patient != null;
}


<style>

    /* =====================================================
           PAGE HEADER
        ====================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }


    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }


    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }


    .page-header-left p {
        margin: 8px 0 0;
        color: #9296aa;
        font-size: 14px;
    }


    /* =====================================================
           BACK BUTTON
        ====================================================== */

    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 17px;
        border-radius: 10px;
        background: #ffffff;
        color: #514b61;
        border: 1px solid #ded8e8;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }


        .back-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #29243a;
        }


    /* =====================================================
           VALIDATION
        ====================================================== */

    .validation-box {
        background: #fff1f2;
        border: 1px solid #ffd9de;
        color: #dc2626;
        border-radius: 11px;
        padding: 15px 18px;
        margin-bottom: 22px;
        font-size: 13px;
    }


        .validation-box strong {
            font-size: 14px;
        }


        .validation-box ul {
            margin: 8px 0 0 20px;
            padding: 0;
        }


        .validation-box li {
            margin-bottom: 4px;
        }


    /* =====================================================
           FORM CARD
        ====================================================== */

    .appointment-form-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(30,20,50,.04);
    }


    /* =====================================================
           FORM HEADER
        ====================================================== */

    .form-card-header {
        margin-bottom: 24px;
    }


        .form-card-header h2 {
            margin: 0;
            color: #29243a;
            font-size: 20px;
            font-weight: 700;
        }


        .form-card-header span {
            display: block;
            margin-top: 5px;
            color: #9993a8;
            font-size: 12px;
        }


    /* =====================================================
           FORM GRID
        ====================================================== */

    .appointment-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 20px;
    }


    .form-field {
        min-width: 0;
    }


    .form-field-full {
        grid-column: 1 / -1;
    }


    /* =====================================================
           LABEL
        ====================================================== */

    .form-label-custom {
        display: block;
        margin-bottom: 7px;
        color: #514b61;
        font-size: 12px;
        font-weight: 700;
    }


    .required-mark {
        color: #dc2626;
    }


    .optional-text {
        color: #9993a8;
        font-weight: 400;
    }


    /* =====================================================
           INPUT
        ====================================================== */

    .appointment-input,
    .appointment-select,
    .appointment-textarea {
        width: 100%;
        background: #ffffff;
        color: #29243a;
        border: 1px solid #e1ddea;
        border-radius: 9px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        outline: none;
        transition: .2s ease;
        box-sizing: border-box;
    }


    .appointment-input,
    .appointment-select {
        height: 42px;
        padding: 0 12px;
    }


    .appointment-textarea {
        min-height: 95px;
        padding: 11px 12px;
        resize: vertical;
        line-height: 1.5;
    }


        .appointment-input:focus,
        .appointment-select:focus,
        .appointment-textarea:focus {
            border-color: #a78bfa;
            box-shadow: 0 0 0 3px rgba(139,92,246,.10);
            outline: none;
        }


        .appointment-input::placeholder,
        .appointment-textarea::placeholder {
            color: #aaa4b5;
        }


    /* =====================================================
           READONLY
        ====================================================== */

    .readonly-input {
        background: #f8f7fb !important;
        font-weight: 700;
    }


    /* =====================================================
           SEARCH
        ====================================================== */

    .search-group {
        display: flex;
        gap: 8px;
    }


        .search-group .appointment-input {
            flex: 1;
        }


    .search-btn {
        height: 42px;
        min-width: 96px;
        padding: 0 16px;
        border: none;
        border-radius: 9px;
        background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        box-shadow: 0 5px 14px rgba(139,92,246,.18);
        transition: .2s ease;
        white-space: nowrap;
        cursor: pointer;
    }


        .search-btn:hover {
            background: linear-gradient( 135deg, #7c3aed, #9333ea );
            color: #ffffff;
        }


        .search-btn:disabled {
            opacity: .7;
            cursor: not-allowed;
        }


    .field-help {
        display: block;
        margin-top: 6px;
        color: #9993a8;
        font-size: 11px;
    }


    /* =====================================================
           SEARCH MESSAGE
        ====================================================== */

    .search-message {
        display: none;
        margin-top: 9px;
        padding: 9px 11px;
        border-radius: 8px;
        font-size: 12px;
    }


        .search-message.success {
            display: block;
            background: #eaf8f0;
            color: #198754;
            border: 1px solid #ccefdc;
        }


        .search-message.danger {
            display: block;
            background: #fff1f2;
            color: #dc2626;
            border: 1px solid #ffd9de;
        }


    /* =====================================================
           INFORMATION BOX
        ====================================================== */

    .information-box {
        background: #faf9fd;
        border: 1px solid #e8e5ef;
        border-radius: 12px;
        padding: 18px;
    }


    .information-label {
        display: block;
        margin-bottom: 4px;
        color: #9993a8;
        font-size: 11px;
        font-weight: 600;
    }


    .information-value {
        color: #29243a;
        font-size: 13px;
        font-weight: 700;
        word-break: break-word;
    }


    /* =====================================================
           TESTS
        ====================================================== */

    .tests-section {
        grid-column: 1 / -1;
        margin-top: 5px;
    }


    .tests-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 14px;
    }


    .tests-section-title h3 {
        margin: 0;
        color: #29243a;
        font-size: 17px;
        font-weight: 700;
    }


    .tests-section-title span {
        display: block;
        margin-top: 4px;
        color: #9993a8;
        font-size: 12px;
    }


    .selected-test-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        padding: 0 12px;
        border-radius: 9px;
        background: #f5efff;
        border: 1px solid #eadcff;
        color: #7c3aed;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =====================================================
           TEST LIST
        ====================================================== */

    .test-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 12px;
    }


    .test-option {
        position: relative;
    }


    .test-checkbox {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }


    .test-label {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 78px;
        padding: 13px 14px;
        background: #ffffff;
        border: 1px solid #e3deeb;
        border-radius: 11px;
        cursor: pointer;
        transition: .2s ease;
    }


        .test-label:hover {
            border-color: #c9b5f7;
            background: #fcfaff;
        }


    .test-checkbox:checked +
    .test-label {
        border-color: #a78bfa;
        background: #f8f4ff;
        box-shadow: 0 0 0 2px rgba(139,92,246,.08);
    }


    .test-check {
        width: 22px;
        height: 22px;
        min-width: 22px;
        border-radius: 6px;
        border: 1.5px solid #cfc8dc;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: transparent;
        font-size: 13px;
        transition: .2s ease;
    }


    .test-checkbox:checked +
    .test-label
    .test-check {
        background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
        border-color: #8b5cf6;
        color: #ffffff;
    }


    .test-content {
        flex: 1;
        min-width: 0;
    }


    .test-name {
        display: block;
        color: #29243a;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.3;
    }


    .test-code {
        display: inline-block;
        margin-top: 4px;
        color: #29243a;
        font-size: 11px;
        font-weight: 600;
    }


    .test-meta {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 6px;
        flex-wrap: wrap;
    }


        .test-meta span {
            color: #29243a;
            font-size: 11px;
            font-weight: 500;
        }


        .test-meta i {
            color: #8b5cf6;
            margin-right: 3px;
        }


    /* =====================================================
           SELECTION SUMMARY
        ====================================================== */

    .selection-summary {
        display: none;
        margin-top: 13px;
        padding: 12px 14px;
        background: #f8f4ff;
        border: 1px solid #e5d9ff;
        border-radius: 10px;
    }


        .selection-summary.show {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }


        .selection-summary strong {
            color: #29243a;
            font-size: 12px;
        }


        .selection-summary span {
            color: #7c3aed;
            font-size: 12px;
            font-weight: 700;
        }


    /* =====================================================
           ACTIONS
        ====================================================== */

    .form-actions {
        grid-column: 1 / -1;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
        padding-top: 22px;
        border-top: 1px solid #eeeaf5;
    }


    .cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 17px;
        border-radius: 9px;
        background: #ffffff;
        color: #514b61;
        border: 1px solid #ded8e8;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }


        .cancel-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #29243a;
        }


    .save-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 18px;
        border: none;
        border-radius: 9px;
        background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 5px 14px rgba(139,92,246,.18);
        transition: .2s ease;
        cursor: pointer;
    }


        .save-btn:hover:not(:disabled) {
            background: linear-gradient( 135deg, #7c3aed, #9333ea );
            color: #ffffff;
            transform: translateY(-1px);
        }


        .save-btn:disabled {
            opacity: .55;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }


    /* =====================================================
           RESPONSIVE
        ====================================================== */

    @@media (max-width:850px) {

        .appointment-form-grid {
            grid-template-columns: 1fr;
        }


        .form-field-full,
        .tests-section,
        .form-actions {
            grid-column: auto;
        }


        .test-list {
            grid-template-columns: 1fr;
        }


        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .back-btn {
            width: 100%;
        }


        .appointment-form-card {
            padding: 20px;
        }
    }


    @@media (max-width:600px) {

        .search-group {
            flex-direction: column;
        }


        .search-btn {
            width: 100%;
        }


        .tests-section-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .form-actions {
            align-items: stretch;
            flex-direction: column;
        }


        .cancel-btn,
        .save-btn {
            width: 100%;
        }
    }

</style>


<!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Add Appointment
        </h1>

        <p>
            Schedule a new patient appointment.
        </p>

    </div>


    <a asp-area="Receptionist"
       asp-controller="Appointments"
       asp-action="Index"
       class="back-btn">

        <i class="bi bi-arrow-left"></i>

        Back to Appointments

    </a>

</div>


<!-- =====================================================
     VALIDATION
====================================================== -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-box">

        <strong>
            Please fix the following:
        </strong>

        <ul>

            @foreach (
                var error in
                ViewData.ModelState.Values
                    .SelectMany(v => v.Errors))
            {
                <li>
                    @error.ErrorMessage
                </li>
            }

        </ul>

    </div>
}


<!-- =====================================================
     FORM CARD
====================================================== -->

<div class="appointment-form-card">


    <div class="form-card-header">

        <h2>
            Appointment Information
        </h2>

    </div>


    <form asp-area="Receptionist"
          asp-controller="Appointments"
          asp-action="Create"
          method="post"
          id="appointmentForm">

        @Html.AntiForgeryToken()


        <!-- =================================================
             HIDDEN IDs
        ================================================== -->

        <input type="hidden"
               asp-for="PatientId"
               id="PatientId" />


        <input type="hidden"
               asp-for="ReferralDoctorId"
               id="ReferralDoctorId" />


        <div class="appointment-form-grid">


            


            <!-- =================================================
                 PATIENT ID
            ================================================== -->

            <div class="form-field">

                <label class="form-label-custom"
                       for="PatientCode">

                    Patient ID

                    <span class="required-mark">
                        *
                    </span>

                </label>


                <div class="search-group">

                    <input type="text"
                           id="PatientCode"
                           class="appointment-input"
                           value="@(Model.Patient?.PatientCode ?? "")"
                           placeholder="Enter Patient ID e.g. PAT001"
                           autocomplete="off" />


                    <button type="button"
                            id="searchPatientBtn"
                            class="search-btn">

                        <i class="bi bi-search"></i>

                        Search

                    </button>

                </div>


                <span class="field-help">
                    Search by the unique Patient ID.
                </span>


                <div id="patientMessage"
                     class="search-message">
                </div>

            </div>


            <!-- =================================================
                 PATIENT INFORMATION
            ================================================== -->

            <div class="form-field form-field-full">

                <div id="patientInfo"
                     class="information-box"
                     style="@(hasSelectedPatient
                                             ? "display:block;"
                                             : "display:none;")">

                    <div class="row g-3">


                        <div class="col-md-3">

                            <span class="information-label">
                                Patient ID
                            </span>

                            <div id="displayPatientCode"
                                 class="information-value">

                                @(Model.Patient?.PatientCode ?? "N/A")

                            </div>

                        </div>


                        <div class="col-md-3">

                            <span class="information-label">
                                Patient Name
                            </span>

                            <div id="displayPatientName"
                                 class="information-value">

                                @(Model.Patient == null
                                    ? "N/A"
                                    : $"{Model.Patient.FirstName} {Model.Patient.LastName}")

                            </div>

                        </div>


                        <div class="col-md-3">

                            <span class="information-label">
                                Phone
                            </span>

                            <div id="displayPatientPhone"
                                 class="information-value">

                                @(string.IsNullOrWhiteSpace(
                                    Model.Patient?.Phone)
                                    ? "N/A"
                                    : Model.Patient.Phone)

                            </div>

                        </div>


                        <div class="col-md-3">

                            <span class="information-label">
                                Email
                            </span>

                            <div id="displayPatientEmail"
                                 class="information-value">

                                @(string.IsNullOrWhiteSpace(
                                    Model.Patient?.Email)
                                    ? "N/A"
                                    : Model.Patient.Email)

                            </div>

                        </div>


                        <div class="col-md-3">

                            <span class="information-label">
                                Gender
                            </span>

                            <div id="displayPatientGender"
                                 class="information-value">

                                @(string.IsNullOrWhiteSpace(
                                    Model.Patient?.Gender)
                                    ? "N/A"
                                    : Model.Patient.Gender)

                            </div>

                        </div>


                        <div class="col-md-3">

                            <span class="information-label">
                                Date of Birth
                            </span>

                            <div id="displayPatientDob"
                                 class="information-value">

                                @(Model.Patient?.DateOfBirth.HasValue == true
                                    ? Model.Patient.DateOfBirth.Value
                                        .ToString("dd MMM yyyy")
                                    : "N/A")

                            </div>

                        </div>


                        <div class="col-md-3">

                            <span class="information-label">
                                Blood Group
                            </span>

                            <div id="displayPatientBloodGroup"
                                 class="information-value">

                                @(string.IsNullOrWhiteSpace(
                                    Model.Patient?.BloodGroup)
                                    ? "N/A"
                                    : Model.Patient.BloodGroup)

                            </div>

                        </div>


                        <div class="col-md-3">

                            <span class="information-label">
                                Address
                            </span>

                            <div id="displayPatientAddress"
                                 class="information-value">

                                @(string.IsNullOrWhiteSpace(
                                    Model.Patient?.Address)
                                    ? "N/A"
                                    : Model.Patient.Address)

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 BRANCH
            ================================================== -->

            <div class="form-field">

                <label asp-for="BranchId"
                       class="form-label-custom">

                    Branch

                    <span class="required-mark">
                        *
                    </span>

                </label>


                <select asp-for="BranchId"
                        asp-items="ViewBag.Branches"
                        class="appointment-select">

                    <option value="">
                        Select Branch
                    </option>

                </select>


                <span asp-validation-for="BranchId"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 REFERRAL DOCTOR
            ================================================== -->

            <div class="form-field">

                <label class="form-label-custom">

                    Referral Doctor ID>

                </label>


                <div class="search-group">

                    <input type="number"
                           id="ReferralDoctorSearch"
                           class="appointment-input"
                           placeholder="Enter Doctor ID e.g. 3"
                           min="1"
                           autocomplete="off" />


                    <button type="button"
                            id="searchDoctorBtn"
                            class="search-btn">

                        <i class="bi bi-search"></i>

                        Search

                    </button>

                </div>
                <div id="doctorMessage"
                     class="search-message">
                </div>

            </div>


            <!-- =================================================
                 REFERRAL DOCTOR INFORMATION
            ================================================== -->

            <div class="form-field form-field-full">

                <div id="doctorInfo"
                     class="information-box"
                     style="display:none;">

                    <div class="row g-3">


                        <div class="col-md-3">

                            <span class="information-label">
                                Doctor ID
                            </span>

                            <div id="displayDoctorId"
                                 class="information-value">
                            </div>

                        </div>


                        <div class="col-md-3">

                            <span class="information-label">
                                Doctor Name
                            </span>

                            <div id="displayDoctorName"
                                 class="information-value">
                            </div>

                        </div>


                        <div class="col-md-3">

                            <span class="information-label">
                                Specialization
                            </span>

                            <div id="displayDoctorSpecialization"
                                 class="information-value">
                            </div>

                        </div>


                        <div class="col-md-3">

                            <span class="information-label">
                                Phone
                            </span>

                            <div id="displayDoctorPhone"
                                 class="information-value">
                            </div>

                        </div>


                        <div class="col-12">

                            <span class="information-label">
                                Hospital
                            </span>

                            <div id="displayDoctorHospital"
                                 class="information-value">
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 APPOINTMENT STATUS
            ================================================== -->

            <div class="form-field">

                <label asp-for="AppointmentStatusId"
                       class="form-label-custom">

                    Appointment Status

                    <span class="required-mark">
                        *
                    </span>

                </label>


                <select asp-for="AppointmentStatusId"
                        asp-items="ViewBag.AppointmentStatuses"
                        class="appointment-select">

                    <option value="">
                        Select Status
                    </option>

                </select>


                <span asp-validation-for="AppointmentStatusId"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 DATE
            ================================================== -->

            <div class="form-field">

                <label asp-for="AppointmentDate"
                       class="form-label-custom">

                    Appointment Date

                    <span class="required-mark">
                        *
                    </span>

                </label>


                <input asp-for="AppointmentDate"
                       type="date"
                       class="appointment-input" />


                <span asp-validation-for="AppointmentDate"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 TIME
            ================================================== -->

            <div class="form-field">

                <label asp-for="AppointmentTime"
                       class="form-label-custom">

                    Appointment Time

                    <span class="required-mark">
                        *
                    </span>

                </label>


                <input asp-for="AppointmentTime"
                       type="time"
                       class="appointment-input" />


                <span asp-validation-for="AppointmentTime"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 TESTS
            ================================================== -->

            <div class="tests-section">


                <div class="tests-section-header">

                    <div class="tests-section-title">

                        <h3>

                            Select Tests

                        </h3>

                    </div>


                    <div class="selected-test-count">

                        <span id="selectedTestCount">
                            @selectedTestIds.Count()
                        </span>

                        &nbsp;Tests Selected

                    </div>

                </div>


                <div class="test-list">


                    @if (availableTests.Any())
                    {

                        foreach (var test in availableTests)
                        {

                            if (test.IsActive == true)
                            {

                                var isSelected =
                                    selectedTestIds.Contains(
                                        test.Id
                                    );


                                <div class="test-option">


                                    <input type="checkbox"
                                           id="test_@test.Id"
                                           name="SelectedTestIds"
                                           value="@test.Id"
                                           class="test-checkbox"
                                    @(isSelected
                                        ? "checked"
                                        : null) />


                                    <label for="test_@test.Id"
                                           class="test-label">


                                        <span class="test-check">

                                            <i class="bi bi-check-lg"></i>

                                        </span>


                                        <span class="test-content">


                                            <span class="test-name">

                                                @test.TestName

                                            </span>


                                            <span class="test-code">

                                                @test.TestCode

                                            </span>


                                            <span class="test-meta">


                                                <span>

                                                    <i class="bi bi-cash-stack"></i>

                                                    ৳ @test.Price.ToString("0.00")

                                                </span>


                                                <span>

                                                    <i class="bi bi-rulers"></i>

                                                    @(string.IsNullOrWhiteSpace(
                                                        test.Unit)
                                                        ? "N/A"
                                                        : test.Unit)

                                                </span>


                                                <span>

                                                    <i class="bi bi-clock"></i>

                                                    @(test.TurnAroundTime.HasValue
                                                        ? test.TurnAroundTime.Value.ToString()
                                                        : "N/A")

                                                </span>

                                            </span>

                                        </span>

                                    </label>

                                </div>

                            }

                        }

                    }
                    else
                    {

                        <div style="
                            grid-column:1 / -1;
                            text-align:center;
                            padding:35px 20px;
                            background:#faf9fd;
                            border:1px dashed #d9d3e3;
                            border-radius:11px;">

                            <div style="
                                width:48px;
                                height:48px;
                                margin:0 auto 10px;
                                border-radius:12px;
                                background:#f1eaff;
                                color:#8b5cf6;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:20px;">

                                <i class="bi bi-eyedropper"></i>

                            </div>


                            <h5 style="
                                margin:0;
                                color:#29243a;
                                font-size:14px;
                                font-weight:700;">

                                No active tests available

                            </h5>


                            <p style="
                                margin:5px 0 0;
                                color:#9993a8;
                                font-size:12px;">

                                Please add or activate tests from the Admin panel.

                            </p>

                        </div>

                    }

                </div>


                <div id="selectionSummary"
                     class="selection-summary">

                    <strong>
                        Selected Tests
                    </strong>


                    <span>

                        <span id="selectedTestSummary">
                            @selectedTestIds.Count()
                        </span>

                        test(s)

                    </span>

                </div>


                <div id="testValidationMessage"
                     class="search-message">
                </div>

            </div>


            <!-- =================================================
                 REMARKS
            ================================================== -->

            <div class="form-field form-field-full">

                <label asp-for="Remarks"
                       class="form-label-custom">

                    Remarks

                </label>


                <textarea asp-for="Remarks"
                          class="appointment-textarea"
                          rows="4"
                          placeholder="Enter appointment remarks"></textarea>


                <span asp-validation-for="Remarks"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 ACTIONS
            ================================================== -->

            <div class="form-actions">


                <a asp-area="Receptionist"
                   asp-controller="Appointments"
                   asp-action="Index"
                   class="cancel-btn">

                    Cancel

                </a>


                <button type="submit"
                        id="saveAppointmentBtn"
                        class="save-btn"
                        disabled>

                    <i class="bi bi-calendar-check"></i>

                    Save Appointment

                </button>

            </div>


        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {


                // =================================================
                // URLS
                // =================================================

                const findPatientUrl =
                    '@findPatientUrl';


                const findDoctorUrl =
                    '@findDoctorUrl';


                // =================================================
                // PATIENT ELEMENTS
                // =================================================

                const patientCodeInput =
                    document.getElementById(
                        "PatientCode"
                    );


                const patientIdInput =
                    document.getElementById(
                        "PatientId"
                    );


                const searchPatientBtn =
                    document.getElementById(
                        "searchPatientBtn"
                    );


                const patientInfo =
                    document.getElementById(
                        "patientInfo"
                    );


                const patientMessage =
                    document.getElementById(
                        "patientMessage"
                    );


                // =================================================
                // DOCTOR ELEMENTS
                // =================================================

                const doctorSearchInput =
                    document.getElementById(
                        "ReferralDoctorSearch"
                    );


                const doctorIdInput =
                    document.getElementById(
                        "ReferralDoctorId"
                    );


                const searchDoctorBtn =
                    document.getElementById(
                        "searchDoctorBtn"
                    );


                const doctorInfo =
                    document.getElementById(
                        "doctorInfo"
                    );


                const doctorMessage =
                    document.getElementById(
                        "doctorMessage"
                    );


                // =================================================
                // SAVE BUTTON
                // =================================================

                const saveButton =
                    document.getElementById(
                        "saveAppointmentBtn"
                    );


                // =================================================
                // TEST ELEMENTS
                // =================================================

                const testCheckboxes =
                    document.querySelectorAll(
                        ".test-checkbox"
                    );


                const selectedTestCount =
                    document.getElementById(
                        "selectedTestCount"
                    );


                const selectedTestSummary =
                    document.getElementById(
                        "selectedTestSummary"
                    );


                const selectionSummary =
                    document.getElementById(
                        "selectionSummary"
                    );


                // =================================================
                // PATIENT DISPLAY
                // =================================================

                const displayPatientCode =
                    document.getElementById(
                        "displayPatientCode"
                    );


                const displayPatientName =
                    document.getElementById(
                        "displayPatientName"
                    );


                const displayPatientPhone =
                    document.getElementById(
                        "displayPatientPhone"
                    );


                const displayPatientEmail =
                    document.getElementById(
                        "displayPatientEmail"
                    );


                const displayPatientGender =
                    document.getElementById(
                        "displayPatientGender"
                    );


                const displayPatientDob =
                    document.getElementById(
                        "displayPatientDob"
                    );


                const displayPatientBloodGroup =
                    document.getElementById(
                        "displayPatientBloodGroup"
                    );


                const displayPatientAddress =
                    document.getElementById(
                        "displayPatientAddress"
                    );


                // =================================================
                // DOCTOR DISPLAY
                // =================================================

                const displayDoctorId =
                    document.getElementById(
                        "displayDoctorId"
                    );


                const displayDoctorName =
                    document.getElementById(
                        "displayDoctorName"
                    );


                const displayDoctorSpecialization =
                    document.getElementById(
                        "displayDoctorSpecialization"
                    );


                const displayDoctorPhone =
                    document.getElementById(
                        "displayDoctorPhone"
                    );


                const displayDoctorHospital =
                    document.getElementById(
                        "displayDoctorHospital"
                    );


                // =================================================
                // SAVE BUTTON STATUS
                // =================================================

                function updateSaveButton() {

                    const hasPatient =
                        patientIdInput.value !== "" &&
                        patientIdInput.value !== "0";


                    const hasTest =
                        document.querySelectorAll(
                            ".test-checkbox:checked"
                        ).length > 0;


                    saveButton.disabled =
                        !(
                            hasPatient &&
                            hasTest
                        );

                }


                // =================================================
                // TEST COUNT
                // =================================================

                function updateTestCount() {

                    const count =
                        document.querySelectorAll(
                            ".test-checkbox:checked"
                        ).length;


                    selectedTestCount.textContent =
                        count;


                    selectedTestSummary.textContent =
                        count;


                    if (count > 0) {

                        selectionSummary.classList.add(
                            "show"
                        );

                    }
                    else {

                        selectionSummary.classList.remove(
                            "show"
                        );

                    }


                    updateSaveButton();

                }


                // =================================================
                // MESSAGE
                // =================================================

                function showMessage(
                    element,
                    message,
                    type
                ) {

                    element.style.display =
                        "block";


                    element.className =
                        "search-message " +
                        type;


                    element.textContent =
                        message;

                }


                // =================================================
                // CLEAR MESSAGE
                // =================================================

                function clearMessage(
                    element
                ) {

                    element.style.display =
                        "none";


                    element.textContent =
                        "";

                }


                // =================================================
                // SEARCH PATIENT
                // =================================================

                async function searchPatient() {

                    const patientCode =
                        patientCodeInput.value.trim();


                    patientIdInput.value =
                        "";


                    patientInfo.style.display =
                        "none";


                    clearMessage(
                        patientMessage
                    );


                    if (patientCode === "") {

                        showMessage(
                            patientMessage,
                            "Please enter Patient ID.",
                            "danger"
                        );


                        updateSaveButton();

                        return;
                    }


                    searchPatientBtn.disabled =
                        true;


                    searchPatientBtn.innerHTML =
                        '<span class="spinner-border spinner-border-sm"></span> Searching';


                    try {

                        const url =
                            findPatientUrl +
                            "?patientCode=" +
                            encodeURIComponent(
                                patientCode
                            );


                        const response =
                            await fetch(
                                url,
                                {
                                    method: "GET",

                                    headers: {
                                        "Accept":
                                            "application/json"
                                    }
                                }
                            );


                        const data =
                            await response.json();


                        if (
                            !response.ok ||
                            data.success !== true
                        ) {

                            showMessage(
                                patientMessage,
                                data.message ||
                                "Patient ID not found.",
                                "danger"
                            );


                            return;
                        }


                        patientIdInput.value =
                            data.patientId;


                        displayPatientCode.textContent =
                            data.patientCode ||
                            "N/A";


                        displayPatientName.textContent =
                            data.patientName ||
                            "N/A";


                        displayPatientPhone.textContent =
                            data.phone ||
                            "N/A";


                        displayPatientEmail.textContent =
                            data.email ||
                            "N/A";


                        displayPatientGender.textContent =
                            data.gender ||
                            "N/A";


                        displayPatientDob.textContent =
                            data.dateOfBirth ||
                            "N/A";


                        displayPatientBloodGroup.textContent =
                            data.bloodGroup ||
                            "N/A";


                        displayPatientAddress.textContent =
                            data.address ||
                            "N/A";


                        patientInfo.style.display =
                            "block";


                        showMessage(
                            patientMessage,
                            "Patient found successfully.",
                            "success"
                        );

                    }
                    catch (error) {

                        console.error(error);


                        patientIdInput.value =
                            "";


                        patientInfo.style.display =
                            "none";


                        showMessage(
                            patientMessage,
                            "Unable to search patient. Please try again.",
                            "danger"
                        );

                    }
                    finally {

                        searchPatientBtn.disabled =
                            false;


                        searchPatientBtn.innerHTML =
                            '<i class="bi bi-search"></i> Search';


                        updateSaveButton();

                    }

                }


                // =================================================
                // PATIENT SEARCH BUTTON
                // =================================================

                searchPatientBtn.addEventListener(
                    "click",
                    searchPatient
                );


                // =================================================
                // PATIENT ENTER
                // =================================================

                patientCodeInput.addEventListener(
                    "keypress",
                    function(event) {

                        if (
                            event.key === "Enter"
                        ) {

                            event.preventDefault();

                            searchPatient();

                        }

                    }
                );


                // =================================================
                // PATIENT INPUT CHANGE
                // =================================================

                patientCodeInput.addEventListener(
                    "input",
                    function() {

                        patientIdInput.value =
                            "";


                        patientInfo.style.display =
                            "none";


                        clearMessage(
                            patientMessage
                        );


                        updateSaveButton();

                    }
                );


                // =================================================
                // SEARCH DOCTOR
                // =================================================

                async function searchReferralDoctor() {

                    const doctorId =
                        doctorSearchInput.value.trim();


                    doctorIdInput.value =
                        "";


                    doctorInfo.style.display =
                        "none";


                    clearMessage(
                        doctorMessage
                    );


                    if (doctorId === "") {

                        showMessage(
                            doctorMessage,
                            "Please enter Referral Doctor ID.",
                            "danger"
                        );

                        return;
                    }


                    if (
                        parseInt(doctorId) <= 0
                    ) {

                        showMessage(
                            doctorMessage,
                            "Please enter a valid Referral Doctor ID.",
                            "danger"
                        );

                        return;
                    }


                    searchDoctorBtn.disabled =
                        true;


                    searchDoctorBtn.innerHTML =
                        '<span class="spinner-border spinner-border-sm"></span> Searching';


                    try {

                        const url =
                            findDoctorUrl +
                            "?id=" +
                            encodeURIComponent(
                                doctorId
                            );


                        const response =
                            await fetch(
                                url,
                                {
                                    method: "GET",

                                    headers: {
                                        "Accept":
                                            "application/json"
                                    }
                                }
                            );


                        const data =
                            await response.json();


                        if (
                            !response.ok ||
                            data.success !== true
                        ) {

                            showMessage(
                                doctorMessage,
                                data.message ||
                                "Referral Doctor not found.",
                                "danger"
                            );


                            return;

                        }


                        doctorIdInput.value =
                            data.doctorId;


                        displayDoctorId.textContent =
                            data.doctorId;


                        displayDoctorName.textContent =
                            data.doctorName ||
                            "N/A";


                        displayDoctorSpecialization.textContent =
                            data.specialization ||
                            "N/A";


                        displayDoctorPhone.textContent =
                            data.phone ||
                            "N/A";


                        displayDoctorHospital.textContent =
                            data.hospitalName ||
                            "N/A";


                        doctorInfo.style.display =
                            "block";


                        showMessage(
                            doctorMessage,
                            "Referral Doctor found successfully.",
                            "success"
                        );

                    }
                    catch (error) {

                        console.error(error);


                        doctorIdInput.value =
                            "";


                        doctorInfo.style.display =
                            "none";


                        showMessage(
                            doctorMessage,
                            "Unable to search Referral Doctor. Please try again.",
                            "danger"
                        );

                    }
                    finally {

                        searchDoctorBtn.disabled =
                            false;


                        searchDoctorBtn.innerHTML =
                            '<i class="bi bi-search"></i> Search';

                    }

                }


                // =================================================
                // DOCTOR SEARCH BUTTON
                // =================================================

                searchDoctorBtn.addEventListener(
                    "click",
                    searchReferralDoctor
                );


                // =================================================
                // DOCTOR ENTER
                // =================================================

                doctorSearchInput.addEventListener(
                    "keypress",
                    function(event) {

                        if (
                            event.key === "Enter"
                        ) {

                            event.preventDefault();

                            searchReferralDoctor();

                        }

                    }
                );


                // =================================================
                // DOCTOR INPUT CHANGE
                // =================================================

                doctorSearchInput.addEventListener(
                    "input",
                    function() {

                        doctorIdInput.value =
                            "";


                        doctorInfo.style.display =
                            "none";


                        clearMessage(
                            doctorMessage
                        );

                    }
                );


                // =================================================
                // TEST CHANGE
                // =================================================

                testCheckboxes.forEach(
                    function(checkbox) {

                        checkbox.addEventListener(
                            "change",
                            updateTestCount
                        );

                    }
                );


                // =================================================
                // INITIAL STATE
                //
                // নতুন patient থেকে এলে:
                //
                // Model.PatientId
                // Model.Patient
                //
                // already populated থাকবে.
                // তাই patient আবার search না করেও
                // save করা যাবে.
                // =================================================

                updateTestCount();


                updateSaveButton();

            }

        );

    </script>
}