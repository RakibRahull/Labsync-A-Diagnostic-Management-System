@model LabSync.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
    Layout = "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";
}


<style>

    /* =====================================================
           PAGE HEADER
        ====================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }

    .page-header-left p {
        margin: 8px 0 0;
        color: #9296aa;
        font-size: 14px;
    }


    /* =====================================================
           BACK BUTTON
        ====================================================== */

    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 17px;
        border-radius: 10px;
        background: #ffffff;
        color: #514b61;
        border: 1px solid #ded8e8;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

        .back-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #29243a;
        }


    /* =====================================================
           DELETE CARD
        ====================================================== */

    .delete-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
    }


    /* =====================================================
           WARNING BOX
        ====================================================== */

    .warning-box {
        background: #fff1f2;
        border: 1px solid #ffd9de;
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 25px;
    }

    .warning-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #ffe4e6;
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 11px;
    }

    .warning-title {
        margin: 0;
        color: #b91c1c;
        font-size: 16px;
        font-weight: 700;
    }

    .warning-text {
        margin: 6px 0 0;
        color: #dc2626;
        font-size: 13px;
        line-height: 1.5;
    }


    /* =====================================================
           SECTION HEADER
        ====================================================== */

    .details-header {
        margin-bottom: 18px;
    }

        .details-header h2 {
            margin: 0;
            color: #29243a;
            font-size: 19px;
            font-weight: 700;
        }

        .details-header p {
            margin: 5px 0 0;
            color: #9993a8;
            font-size: 12px;
        }


    /* =====================================================
           DETAILS GRID
        ====================================================== */

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .detail-item {
        background: #faf9fd;
        border: 1px solid #e8e5ef;
        border-radius: 11px;
        padding: 15px 16px;
    }

    .detail-label {
        display: block;
        margin-bottom: 6px;
        color: #9993a8;
        font-size: 11px;
        font-weight: 600;
    }

    .detail-value {
        color: #29243a;
        font-size: 13px;
        font-weight: 700;
        word-break: break-word;
    }


    /* =====================================================
           REMARKS
        ====================================================== */

    .remarks-box {
        margin-top: 14px;
        background: #faf9fd;
        border: 1px solid #e8e5ef;
        border-radius: 11px;
        padding: 15px 16px;
    }

    .remarks-value {
        color: #29243a;
        font-size: 13px;
        line-height: 1.55;
        white-space: pre-wrap;
    }


    /* =====================================================
           FORM ACTIONS
        ====================================================== */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #eeeaf5;
    }

    .cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 42px;
        padding: 0 18px;
        border-radius: 9px;
        background: #ffffff;
        color: #514b61;
        border: 1px solid #ded8e8;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

        .cancel-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #29243a;
        }

    .delete-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 18px;
        border: none;
        border-radius: 9px;
        background: #dc3545;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 5px 14px rgba(220, 53, 69, .16);
        transition: .2s ease;
    }

        .delete-btn:hover {
            background: #bb2d3b;
            color: #ffffff;
            transform: translateY(-1px);
        }


    /* =====================================================
           RESPONSIVE
        ====================================================== */

    @@media (max-width: 700px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .delete-card {
            padding: 20px;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .form-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .cancel-btn,
        .delete-btn {
            width: 100%;
        }
    }

</style>


<!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Delete Appointment
        </h1>

        <p>
            Remove this appointment from the system.
        </p>

    </div>


    <a asp-area="Receptionist"
       asp-controller="Appointments"
       asp-action="Index"
       class="back-btn">

        <i class="bi bi-arrow-left"></i>

        Back to Appointments

    </a>

</div>


<!-- =====================================================
     DELETE CARD
====================================================== -->

<div class="delete-card">


    <!-- =================================================
         WARNING
    ================================================== -->

    <div class="warning-box">

        <div class="warning-icon">
            <i class="bi bi-exclamation-triangle"></i>
        </div>

        <h3 class="warning-title">
            Are you sure you want to delete this appointment?
        </h3>

        <p class="warning-text">
            This action cannot be undone. The appointment and its
            assigned test records will be removed from the system.
        </p>

    </div>


    <!-- =================================================
         DETAILS HEADER
    ================================================== -->

    <div class="details-header">

        <h2>
            Appointment Information
        </h2>

        <p>
            Review the appointment details before deleting it.
        </p>

    </div>


    <!-- =================================================
         DETAILS
    ================================================== -->

    <div class="details-grid">


        <!-- Appointment ID -->

        <div class="detail-item">

            <span class="detail-label">
                Appointment ID
            </span>

            <div class="detail-value">
                @(string.IsNullOrWhiteSpace(Model.AppointmentCode)
                    ? "N/A"
                    : Model.AppointmentCode)
            </div>

        </div>


        <!-- Patient ID -->

        <div class="detail-item">

            <span class="detail-label">
                Patient ID
            </span>

            <div class="detail-value">

                @(Model.Patient?.PatientCode
                    ?? (Model.PatientId > 0
                        ? Model.PatientId.ToString()
                        : "N/A"))

            </div>

        </div>


        <!-- Patient Name -->

        <div class="detail-item">

            <span class="detail-label">
                Patient Name
            </span>

            <div class="detail-value">

                @(Model.Patient == null
                    ? "N/A"
                    : $"{Model.Patient.FirstName} {Model.Patient.LastName}")

            </div>

        </div>


        <!-- Referral Doctor -->

        <div class="detail-item">

            <span class="detail-label">
                Referral Doctor ID
            </span>

            <div class="detail-value">

                @(Model.ReferralDoctorId?.ToString() ?? "N/A")

            </div>

        </div>


        <!-- Date -->

        <div class="detail-item">

            <span class="detail-label">
                Date of Appointment
            </span>

            <div class="detail-value">

                @(Model.AppointmentDate.ToString("dd MMM yyyy"))

            </div>

        </div>


        <!-- Time -->

        <div class="detail-item">

            <span class="detail-label">
                Appointment Time
            </span>

            <div class="detail-value">

                @(DateTime.Today
                    .Add(Model.AppointmentTime)
                    .ToString("hh:mm tt"))

            </div>

        </div>


        <!-- Branch -->

        <div class="detail-item">

            <span class="detail-label">
                Branch ID
            </span>

            <div class="detail-value">

                @(Model.BranchId > 0
                    ? Model.BranchId.ToString()
                    : "N/A")

            </div>

        </div>


        <!-- Created At -->

        <div class="detail-item">

            <span class="detail-label">
                Created At
            </span>

            <div class="detail-value">

                @(Model.CreatedAt.HasValue
                    ? Model.CreatedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                    : "N/A")

            </div>

        </div>

    </div>


    <!-- =================================================
         REMARKS
    ================================================== -->

    <div class="remarks-box">

        <span class="detail-label">
            Remarks
        </span>

        <div class="remarks-value">

            @(string.IsNullOrWhiteSpace(Model.Remarks)
                ? "No remarks provided."
                : Model.Remarks)

        </div>

    </div>


    <!-- =================================================
         ACTIONS
    ================================================== -->

    <form asp-area="Receptionist"
          asp-controller="Appointments"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()


        <div class="form-actions">


            <a asp-area="Receptionist"
               asp-controller="Appointments"
               asp-action="Index"
               class="cancel-btn">

                <i class="bi bi-x-lg"></i>

                Cancel

            </a>


            <button type="submit"
                    class="delete-btn"
                    onclick="return confirm('Are you sure you want to delete this appointment?');">

                <i class="bi bi-trash"></i>

                Yes, Delete Appointment

            </button>


        </div>

    </form>

</div>