@model LabSync.Models.Report

@using LabSync.Areas.Receptionist.Models

@{
    ViewData["Title"] = "Report Details";

    Layout =
        "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";


    // =====================================================
    // APPOINTMENT
    // =====================================================

    var appointment =
        ViewBag.Appointment as LabSync.Models.Appointment;


    // =====================================================
    // PATIENT
    // =====================================================

    var patient =
        ViewBag.Patient as LabSync.Models.Patient;


    // =====================================================
    // TESTS
    // =====================================================

    var tests =
        ViewBag.Tests as IEnumerable<ReportTestDetailsViewModel>
        ?? Enumerable.Empty<ReportTestDetailsViewModel>();


    // =====================================================
    // GENERATED BY
    // =====================================================

    var generatedByUser =
        ViewBag.GeneratedByUser as LabSync.Models.User;


    // =====================================================
    // APPROVED BY
    // =====================================================

    var approvedByUser =
        ViewBag.ApprovedByUser as LabSync.Models.User;


    // =====================================================
    // APPROVAL STATUS
    // =====================================================

    var approvalStatus =
        ViewBag.ApprovalStatus?.ToString()
        ?? "Pending";


    // =====================================================
    // PAYMENT STATUS
    // =====================================================

    var paymentStatus =
        ViewBag.PaymentStatus?.ToString()
        ?? "Unpaid";
}


<style>

    /* =====================================================
           PAGE HEADER
        ====================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }

    .page-header-left p {
        margin: 8px 0 0;
        color: #9296aa;
        font-size: 14px;
    }


    /* =====================================================
           HEADER ACTIONS
        ====================================================== */

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }


    .back-btn,
    .pdf-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 17px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
        white-space: nowrap;
    }

    .back-btn {
        background: #ffffff;
        color: #514b61;
        border: 1px solid #ded8e8;
    }

        .back-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #29243a;
        }

    .pdf-btn {
        background: #f4f9ff;
        color: #4385dd;
        border: 1px solid #b8d5f7;
    }

        .pdf-btn:hover {
            background: #e9f2ff;
            color: #2868b9;
        }


    /* =====================================================
           MAIN CARD
        ====================================================== */

    .details-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
        margin-bottom: 22px;
    }


    /* =====================================================
           REPORT HEADER
        ====================================================== */

    .report-header {
        padding: 28px 30px;
        border-bottom: 1px solid #eeeaf5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .report-header-left h2 {
        margin: 0;
        color: #18213a;
        font-size: 23px;
        font-weight: 700;
    }

    .report-header-left p {
        margin: 7px 0 0;
        color: #9993a8;
        font-size: 12px;
    }


    /* =====================================================
           STATUS BADGES
        ====================================================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        padding: 0 12px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-approved {
        background: #eaf8f0;
        color: #198754;
        border: 1px solid #ccefdc;
    }

    .status-pending {
        background: #fff7e6;
        color: #b7791f;
        border: 1px solid #f6dfad;
    }

    .status-rejected {
        background: #fff1f2;
        color: #dc2626;
        border: 1px solid #ffd9de;
    }

    .status-paid {
        background: #eaf8f0;
        color: #198754;
        border: 1px solid #ccefdc;
    }

    .status-unpaid {
        background: #fff1f2;
        color: #dc2626;
        border: 1px solid #ffd9de;
    }

    .status-partial {
        background: #fff7e6;
        color: #b7791f;
        border: 1px solid #f6dfad;
    }


    /* =====================================================
           BODY
        ====================================================== */

    .details-body {
        padding: 30px;
    }


    /* =====================================================
           SECTION
        ====================================================== */

    .details-section {
        margin-bottom: 32px;
    }

        .details-section:last-child {
            margin-bottom: 0;
        }

    .section-title {
        margin: 0 0 17px;
        color: #29243a;
        font-size: 18px;
        font-weight: 700;
    }

    .section-subtitle {
        margin: -10px 0 18px;
        color: #9993a8;
        font-size: 12px;
    }


    /* =====================================================
           INFORMATION GRID
        ====================================================== */

    .information-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .information-item {
        background: #faf9fd;
        border: 1px solid #e8e5ef;
        border-radius: 11px;
        padding: 16px 17px;
    }

    .information-label {
        display: block;
        margin-bottom: 6px;
        color: #9993a8;
        font-size: 11px;
        font-weight: 600;
    }

    .information-value {
        color: #29243a;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.45;
        word-break: break-word;
    }

    .full-width {
        grid-column: 1 / -1;
    }


    /* =====================================================
           TEST TABLE
        ====================================================== */

    .test-table-wrapper {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 12px;
        overflow: hidden;
    }

    .test-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1000px;
    }

        .test-table thead th {
            background: #faf9fd;
            padding: 14px 15px;
            color: #514b61;
            border-bottom: 1px solid #e8e5ef;
            font-size: 11px;
            font-weight: 700;
            text-align: left;
            white-space: nowrap;
        }

        .test-table tbody td {
            padding: 14px 15px;
            color: #29243a;
            border-bottom: 1px solid #eeeaf5;
            font-size: 12px;
            vertical-align: middle;
        }

        .test-table tbody tr:last-child td {
            border-bottom: none;
        }

        .test-table tbody tr:hover {
            background: #fcfbfe;
        }

    .test-code {
        color: #7c3aed;
        font-weight: 700;
    }

    .test-name {
        color: #29243a;
        font-weight: 700;
    }


    /* =====================================================
           RESULT
        ====================================================== */

    .result-value-normal {
        color: #198754;
        font-weight: 700;
    }

    .result-value-abnormal {
        color: #dc2626;
        font-weight: 700;
    }

    .result-pending {
        color: #9993a8;
        font-weight: 600;
    }


    /* =====================================================
           REFERENCE
        ====================================================== */

    .reference-box {
        margin-top: 20px;
        background: #faf7ff;
        border: 1px solid #ddd0f6;
        border-radius: 11px;
        padding: 17px;
    }

    .reference-title {
        margin-bottom: 7px;
        color: #6d28d9;
        font-size: 12px;
        font-weight: 700;
    }

    .reference-value {
        color: #29243a;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.5;
    }

    .reference-description {
        margin-top: 6px;
        color: #666666;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =====================================================
           RESPONSIBLE USERS
        ====================================================== */

    .responsible-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .responsible-card {
        background: #faf9fd;
        border: 1px solid #e8e5ef;
        border-radius: 11px;
        padding: 18px;
    }

    .responsible-label {
        display: block;
        margin-bottom: 8px;
        color: #9993a8;
        font-size: 11px;
        font-weight: 600;
    }

    .responsible-title {
        color: #29243a;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .responsible-email {
        color: #7c3aed;
        font-size: 12px;
        font-weight: 600;
        word-break: break-word;
    }


    /* =====================================================
           SUMMARY
        ====================================================== */

    .status-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .summary-card {
        background: #faf9fd;
        border: 1px solid #e8e5ef;
        border-radius: 11px;
        padding: 17px;
    }

    .summary-label {
        display: block;
        margin-bottom: 8px;
        color: #9993a8;
        font-size: 11px;
        font-weight: 600;
    }


    /* =====================================================
           EMPTY
        ====================================================== */

    .empty-tests {
        padding: 30px 20px;
        text-align: center;
        background: #faf9fd;
        border: 1px dashed #d9d3e3;
        border-radius: 11px;
        color: #9993a8;
        font-size: 12px;
    }


    /* =====================================================
           MOBILE
        ====================================================== */

    @@media (max-width: 900px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .header-actions {
            width: 100%;
        }

        .back-btn,
        .pdf-btn {
            flex: 1;
        }

        .report-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .information-grid,
        .responsible-grid,
        .status-summary {
            grid-template-columns: 1fr;
        }

        .details-body {
            padding: 20px;
        }

        .report-header {
            padding: 22px 20px;
        }
    }

</style>


<!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Report Details
        </h1>

        <p>
            View complete patient, appointment and laboratory report information.
        </p>

    </div>


    <div class="header-actions">

        @if (Model != null && !string.IsNullOrWhiteSpace(Model.PdfPath))
        {
            <a href="@Url.Action(
                                        "ViewPdf",
                                        "Reports",
                                        new
                                        {
                                            area = "Receptionist",
                                            id = Model.Id
                                        })"
               target="_blank"
               class="pdf-btn">

                <i class="bi bi-file-earmark-pdf"></i>

                View PDF

            </a>
        }


        <a asp-area="Receptionist"
           asp-controller="Reports"
           asp-action="Index"
           class="back-btn">

            <i class="bi bi-arrow-left"></i>

            Back to Reports

        </a>

    </div>

</div>


<!-- =====================================================
     MAIN CARD
====================================================== -->

<div class="details-card">


    <!-- =================================================
         REPORT HEADER
    ================================================== -->

    <div class="report-header">

        <div class="report-header-left">

            <h2>
                Final Diagnostic Report
            </h2>

            <p>

                Report ID:
                @Model.Id

                <span style="margin:0 7px;">
                    •
                </span>

                Appointment:
                @(appointment?.AppointmentCode ?? "N/A")

            </p>

        </div>


        <!-- =================================================
             APPROVAL STATUS
        ================================================== -->
        @if (
                    string.Equals(
                        approvalStatus,
                        "Approved",
                        StringComparison.OrdinalIgnoreCase
                    )
                )
        {
            <span class="status-badge status-approved">

                <i class="bi bi-check-circle me-1"></i>

                Approved

            </span>
        }
        else if (
            string.Equals(
                approvalStatus,
                "Rejected",
                StringComparison.OrdinalIgnoreCase
            )
        )
        {
            <span class="status-badge status-rejected">

                <i class="bi bi-x-circle me-1"></i>

                Rejected

            </span>
        }
        else
        {
            <span class="status-badge status-pending">

                <i class="bi bi-clock me-1"></i>

                Pending

            </span>
        }

    </div>


    <!-- =================================================
         BODY
    ================================================== -->

    <div class="details-body">


        <!-- =================================================
             PATIENT INFORMATION
        ================================================== -->

        <div class="details-section">

            <h3 class="section-title">
                Patient Information
            </h3>

            <p class="section-subtitle">
                Complete registered patient information.
            </p>


            @if (patient != null)
            {
                <div class="information-grid">


                    <div class="information-item">

                        <span class="information-label">
                            Patient ID
                        </span>

                        <div class="information-value">

                            @(patient.PatientCode ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Patient Name
                        </span>

                        <div class="information-value">

                            @patient.FirstName @patient.LastName

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Phone Number
                        </span>

                        <div class="information-value">

                            @(patient.Phone ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Email Address
                        </span>

                        <div class="information-value">

                            @(patient.Email ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Date of Birth
                        </span>

                        <div class="information-value">

                            @(patient.DateOfBirth.HasValue
                                ? patient.DateOfBirth.Value.ToString(
                                    "dd MMM yyyy")
                                : "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Gender
                        </span>

                        <div class="information-value">

                            @(patient.Gender ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Religion
                        </span>

                        <div class="information-value">

                            @(patient.Religion ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Marital Status
                        </span>

                        <div class="information-value">

                            @(patient.MaritalStatus ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Blood Group
                        </span>

                        <div class="information-value">

                            @(patient.BloodGroup ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Father Name
                        </span>

                        <div class="information-value">

                            @(patient.FatherName ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Mother Name
                        </span>

                        <div class="information-value">

                            @(patient.MotherName ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            NID
                        </span>

                        <div class="information-value">

                            @(patient.NID ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item">

                        <span class="information-label">
                            Occupation
                        </span>

                        <div class="information-value">

                            @(patient.Occupation ?? "N/A")

                        </div>

                    </div>


                    <div class="information-item full-width">

                        <span class="information-label">
                            Address
                        </span>

                        <div class="information-value">

                            @(patient.Address ?? "N/A")

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="empty-tests">
                    Patient information is not available.
                </div>
            }

        </div>


        <!-- =================================================
             APPOINTMENT INFORMATION
        ================================================== -->

        <div class="details-section">

            <h3 class="section-title">
                Appointment Information
            </h3>

            <p class="section-subtitle">
                Appointment information associated with this report.
            </p>


            <div class="information-grid">


                <div class="information-item">

                    <span class="information-label">
                        Appointment ID
                    </span>

                    <div class="information-value">

                        @(appointment?.AppointmentCode ?? "N/A")

                    </div>

                </div>


                <div class="information-item">

                    <span class="information-label">
                        Record ID
                    </span>

                    <div class="information-value">

                        @(appointment?.Id.ToString() ?? "N/A")

                    </div>

                </div>


                <div class="information-item">

                    <span class="information-label">
                        Appointment Date
                    </span>

                    <div class="information-value">

                        @(appointment != null
                            ? appointment.AppointmentDate.ToString(
                                "dd MMM yyyy")
                            : "N/A")

                    </div>

                </div>


                <div class="information-item">

                    <span class="information-label">
                        Appointment Time
                    </span>

                    <div class="information-value">

                        @(appointment != null
                            ? DateTime.Today
                                .Add(appointment.AppointmentTime)
                                .ToString("hh:mm tt")
                            : "N/A")

                    </div>

                </div>


                <div class="information-item">

                    <span class="information-label">
                        Branch ID
                    </span>

                    <div class="information-value">

                        @(appointment?.BranchId.ToString() ?? "N/A")

                    </div>

                </div>


                <div class="information-item">

                    <span class="information-label">
                        Referral Doctor ID
                    </span>

                    <div class="information-value">

                        @(appointment?.ReferralDoctorId?.ToString()
                            ?? "N/A")

                    </div>

                </div>


                <div class="information-item">

                    <span class="information-label">
                        Report Generated
                    </span>

                    <div class="information-value">

                        @(Model.GeneratedDate.HasValue
                            ? Model.GeneratedDate.Value.ToString(
                                "dd MMM yyyy hh:mm tt")
                            : "N/A")

                    </div>

                </div>


                <div class="information-item">

                    <span class="information-label">
                        Approval Date
                    </span>

                    <div class="information-value">

                        @(Model.ApprovalDate.HasValue
                            ? Model.ApprovalDate.Value.ToString(
                                "dd MMM yyyy hh:mm tt")
                            : "N/A")

                    </div>

                </div>


                <div class="information-item full-width">

                    <span class="information-label">
                        Appointment Remarks
                    </span>

                    <div class="information-value">

                        @(string.IsNullOrWhiteSpace(
                            appointment?.Remarks)
                            ? "No remarks provided."
                            : appointment.Remarks)

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             TESTS PERFORMED
        ================================================== -->

        <div class="details-section">

            <h3 class="section-title">
                Tests Performed
            </h3>

            <p class="section-subtitle">
                All tests and their corresponding laboratory results.
            </p>


            @if (tests.Any())
            {

                <div class="test-table-wrapper">

                    <table class="test-table">

                        <thead>

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    Test Code
                                </th>

                                <th>
                                    Test Name
                                </th>

                                <th>
                                    Result
                                </th>

                                <th>
                                    Unit
                                </th>

                                <th>
                                    Reference Range
                                </th>

                                <th>
                                    Interpretation
                                </th>

                                <th>
                                    Result Status
                                </th>

                                <th>
                                    Result Date
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                var testSerial = 1;
                            }


                            @foreach (
                                var test
                                in tests
                            )
                            {
                                <tr>

                                    <td>
                                        @testSerial
                                    </td>


                                    <td>

                                        <span class="test-code">

                                            @(test.TestCode ?? "N/A")

                                        </span>

                                    </td>


                                    <td>

                                        <span class="test-name">

                                            @test.TestName

                                        </span>

                                    </td>


                                    <td>

                                        @if (
                                            string.IsNullOrWhiteSpace(
                                                test.ResultValue
                                            )
                                        )
                                        {
                                            <span class="result-pending">
                                                Not Entered
                                            </span>
                                        }
                                        else
                                        {
                                            <strong>
                                                @test.ResultValue
                                            </strong>
                                        }

                                    </td>


                                    <td>
                                        @(test.Unit ?? "N/A")
                                    </td>


                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            test.ReferenceRange)
                                            ? "N/A"
                                            : test.ReferenceRange)

                                    </td>


                                    <td>

                                        @if (
                                            string.Equals(
                                                test.ResultInterpretation,
                                                "Normal",
                                                StringComparison.OrdinalIgnoreCase
                                            )
                                        )
                                        {
                                            <span class="result-value-normal">

                                                Normal

                                            </span>
                                        }
                                        else if (
                                            string.Equals(
                                                test.ResultInterpretation,
                                                "Abnormal",
                                                StringComparison.OrdinalIgnoreCase
                                            )
                                        )
                                        {
                                            <span class="result-value-abnormal">

                                                Abnormal

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="result-pending">

                                                N/A

                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @(test.ResultStatusName ?? "N/A")

                                    </td>


                                    <td>

                                        @(
                                            test.ResultDate.HasValue
                                                ? test.ResultDate.Value.ToString(
                                                    "dd/MM/yyyy hh:mm tt")
                                                : "N/A"
                                        )

                                    </td>

                                </tr>


                                testSerial++;
                            }

                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     REFERENCE DETAILS
                ================================================== -->
                @foreach (
                                    var test
                                    in tests
                                )
                {
                    @if (
                        !string.IsNullOrWhiteSpace(
                            test.ReferenceRange
                        )
                        ||
                        !string.IsNullOrWhiteSpace(
                            test.ReferenceRangeDescription
                        )
                    )
                    {
                        <div class="reference-box">

                            <div class="reference-title">

                                @test.TestName
                                — Reference Range

                            </div>


                            @if (
                                !string.IsNullOrWhiteSpace(
                                    test.ReferenceRange
                                )
                            )
                            {
                                <div class="reference-value">

                                    @test.ReferenceRange

                                </div>
                            }


                            @if (
                                !string.IsNullOrWhiteSpace(
                                    test.ReferenceRangeDescription
                                )
                            )
                            {
                                <div class="reference-description">

                                    @test.ReferenceRangeDescription

                                </div>
                            }

                        </div>
                    }
                }

            }
            else
            {

                <div class="empty-tests">

                    No tests were found for this appointment.

                </div>

            }

        </div>


        <!-- =================================================
             REPORT RESPONSIBILITY
        ================================================== -->

        <div class="details-section">

            <h3 class="section-title">
                Report Responsibility
            </h3>

            <p class="section-subtitle">
                Report generation and approval information.
            </p>


            <div class="responsible-grid">


                <!-- GENERATED BY -->

                <div class="responsible-card">

                    <span class="responsible-label">

                        Generated By - Lab Technician

                    </span>


                    <div class="responsible-title">

                        User ID:

                        @(generatedByUser?.Id.ToString()
                            ?? "N/A")

                    </div>


                    <div class="responsible-email">

                        @(generatedByUser?.Email
                            ?? "N/A")

                    </div>

                </div>


                <!-- APPROVED BY -->

                <div class="responsible-card">

                    <span class="responsible-label">

                        Approved By - Admin

                    </span>


                    <div class="responsible-title">

                        User ID:

                        @(approvedByUser?.Id.ToString()
                            ?? "N/A")

                    </div>


                    <div class="responsible-email">

                        @(approvedByUser?.Email
                            ?? "N/A")

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             STATUS SUMMARY
        ================================================== -->

        <div class="details-section">

            <h3 class="section-title">
                Report Status
            </h3>


            <div class="status-summary">


                <!-- REPORT STATUS -->

                <div class="summary-card">

                    <span class="summary-label">
                        Final Report Status
                    </span>


                    @if (
                        string.Equals(
                            approvalStatus,
                            "Approved",
                            StringComparison.OrdinalIgnoreCase
                        )
                    )
                    {
                        <span class="status-badge status-approved">

                            <i class="bi bi-check-circle me-1"></i>

                            Approved

                        </span>
                    }
                    else if (
                        string.Equals(
                            approvalStatus,
                            "Rejected",
                            StringComparison.OrdinalIgnoreCase
                        )
                    )
                    {
                        <span class="status-badge status-rejected">

                            <i class="bi bi-x-circle me-1"></i>

                            Rejected

                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-pending">

                            <i class="bi bi-clock me-1"></i>

                            Pending

                        </span>
                    }

                </div>


                <!-- PAYMENT STATUS -->

                <div class="summary-card">

                    <span class="summary-label">
                        Bill / Payment Status
                    </span>


                    @if (
                        string.Equals(
                            paymentStatus,
                            "Paid",
                            StringComparison.OrdinalIgnoreCase
                        )
                    )
                    {
                        <span class="status-badge status-paid">

                            <i class="bi bi-check-circle me-1"></i>

                            Paid

                        </span>
                    }
                    else if (
                        string.Equals(
                            paymentStatus,
                            "Partially Paid",
                            StringComparison.OrdinalIgnoreCase
                        )
                    )
                    {
                        <span class="status-badge status-partial">

                            <i class="bi bi-circle-half me-1"></i>

                            Partially Paid

                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-unpaid">

                            <i class="bi bi-exclamation-circle me-1"></i>

                            Unpaid

                        </span>
                    }

                </div>


                <!-- DELIVERY STATUS -->

                <div class="summary-card">

                    <span class="summary-label">
                        Handover Status
                    </span>


                    @if (Model.IsDelivered)
                    {
                        <span class="status-badge status-approved">

                            <i class="bi bi-check2-all me-1"></i>

                            Delivered

                        </span>


                        @if (Model.DeliveredAt.HasValue)
                        {
                            <div style="
                                margin-top:7px;
                                color:#9993a8;
                                font-size:11px;">

                                @Model.DeliveredAt.Value.ToString(
                                    "dd MMM yyyy hh:mm tt")

                            </div>
                        }
                    }
                    else
                    {
                        <span class="status-badge status-pending">

                            <i class="bi bi-clock me-1"></i>

                            Not Delivered

                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

</div>