@model List<LabSync.Areas.Receptionist.Models.ReportListRowViewModel>

@{
    ViewData["Title"] = "Reports";
    Layout = "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";

    var appointmentId = ViewBag.AppointmentId as string ?? "";
}

@section Styles {
    <style>

        /* =====================================================
                   REPORTS PAGE
                ====================================================== */

        .reports-page {
            width: 100%;
        }


        /* =====================================================
                   HEADER
                ====================================================== */

        .reports-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .reports-title {
            margin: 0;
            color: #18213a;
            font-size: 32px;
            font-weight: 700;
            line-height: 1.2;
        }

        .reports-subtitle {
            margin: 7px 0 0;
            color: #9296aa;
            font-size: 14px;
        }

        .reports-header-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: #f1eaff;
            color: #8b5cf6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            flex-shrink: 0;
        }


        /* =====================================================
                   SEARCH CARD
                ====================================================== */

        .reports-search-card {
            background: #fff;
            border: 1px solid #e8e5ef;
            border-radius: 16px;
            padding: 20px 22px;
            margin-bottom: 22px;
            box-shadow: 0 5px 20px rgba(30, 20, 50, .04);
        }

        .reports-search-title {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 17px;
        }

            .reports-search-title i {
                color: #8b5cf6;
                font-size: 17px;
            }

            .reports-search-title h5 {
                margin: 0;
                color: #18213a;
                font-size: 16px;
                font-weight: 700;
            }

        .reports-search-form {
            display: flex;
            gap: 12px;
            align-items: flex-end;
        }

        .reports-search-area {
            flex: 1;
        }

        .reports-label {
            display: block;
            margin-bottom: 8px;
            color: #000;
            font-size: 13px;
            font-weight: 700;
        }

        .reports-input {
            width: 100%;
            height: 46px;
            padding: 0 13px;
            border: 1px solid #e8e5ef;
            border-radius: 10px;
            outline: none;
            box-sizing: border-box;
            color: #29243a;
            background: #fff;
            font-size: 13px;
            transition: .2s ease;
        }

            .reports-input::placeholder {
                color: #aaa6b4;
            }

            .reports-input:focus {
                border-color: #bca4f5;
                box-shadow: 0 0 0 3px rgba(139, 92, 246, .10);
            }

        .reports-search-button {
            min-height: 42px;
            padding: 0 16px;
            border: none;
            border-radius: 9px;
            background: linear-gradient(135deg, #8b5cf6, #a855f7);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            white-space: nowrap;
            box-shadow: 0 6px 15px rgba(139, 92, 246, .18);
            transition: .2s ease;
            text-decoration: none;
        }

            .reports-search-button:hover {
                background: linear-gradient(135deg, #7c3aed, #a855f7);
                color: #fff;
                transform: translateY(-1px);
            }


        /* =====================================================
                   REPORT CARD
                ====================================================== */

        .reports-card {
            background: #fff;
            border: 1px solid #e8e5ef;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(30, 20, 50, .04);
        }

        .reports-card-header {
            padding: 20px 22px;
            border-bottom: 1px solid #eeeaf3;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .reports-card-header-left h5 {
            margin: 0;
            color: #000;
            font-size: 18px;
            font-weight: 700;
        }

        .reports-card-header-left p {
            margin: 5px 0 0;
            color: #9993a8;
            font-size: 12px;
        }

        .reports-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 7px 12px;
            border-radius: 20px;
            background: #f1eaff;
            color: #7c3aed;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }


        /* =====================================================
                   TABLE
                ====================================================== */

        .reports-table-wrapper {
            overflow-x: auto;
        }

        .reports-table {
            width: 100%;
            min-width: 1050px;
            border-collapse: collapse;
        }

            .reports-table th {
                padding: 14px 16px;
                background: #faf9fc;
                border-bottom: 1px solid #ebe8f0;
                color: #000;
                text-align: left;
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
            }

            .reports-table td {
                padding: 16px;
                border-bottom: 1px solid #f0edf4;
                color: #000;
                font-size: 13px;
                vertical-align: middle;
            }

            .reports-table tbody tr {
                transition: .2s ease;
            }

                .reports-table tbody tr:hover {
                    background: #fcfbff;
                }

                .reports-table tbody tr:last-child td {
                    border-bottom: none;
                }


        /* =====================================================
                   TABLE CONTENT
                ====================================================== */

        .report-serial {
            color: #8b5cf6;
            font-weight: 700;
        }

        .appointment-code {
            color: #7c3aed;
            font-weight: 700;
            font-size: 13px;
        }

        .patient-name {
            color: #29243a;
            font-weight: 700;
            font-size: 13px;
        }

        .patient-code {
            display: inline-block;
            margin-top: 4px;
            color: #9993a8;
            font-size: 11px;
        }


        /* =====================================================
                   STATUS BADGES
                ====================================================== */

        .approved-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 11px;
            border-radius: 8px;
            background: #eaf8ef;
            color: #159447;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .pending-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 11px;
            border-radius: 8px;
            background: #fff7e6;
            color: #b7791f;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .approved-date {
            color: #514b61;
            font-size: 12px;
            font-weight: 600;
        }

        .approved-time {
            display: block;
            margin-top: 3px;
            color: #9993a8;
            font-size: 11px;
        }

        .delivery-date {
            display: block;
            margin-top: 4px;
            color: #9993a8;
            font-size: 11px;
        }


        /* =====================================================
                   VIEW REPORT BUTTON
                ====================================================== */

        .view-button {
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #f1eaff;
            color: #7c3aed;
            text-decoration: none;
            font-size: 17px;
            transition: .2s ease;
        }

            .view-button:hover {
                background: #7c3aed;
                color: #fff;
            }


        /* =====================================================
                   EMPTY STATE
                ====================================================== */

        .reports-empty {
            padding: 70px 25px;
            text-align: center;
        }

        .reports-empty-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 15px;
            border-radius: 16px;
            background: #f1eaff;
            color: #8b5cf6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 29px;
        }

        .reports-empty h5 {
            margin: 0 0 7px;
            color: #000;
            font-size: 16px;
            font-weight: 700;
        }

        .reports-empty p {
            margin: 0;
            color: #666;
            font-size: 13px;
        }


        /* =====================================================
                   ALERT
                ====================================================== */

        .reports-page .alert {
            border-radius: 10px;
            font-size: 14px;
        }


        /* =====================================================
                   MOBILE
                ====================================================== */

        @@media (max-width: 700px) {

            .reports-header {
                align-items: flex-start;
            }

            .reports-title {
                font-size: 26px;
            }

            .reports-header-icon {
                width: 46px;
                height: 46px;
                font-size: 20px;
            }

            .reports-search-form {
                flex-direction: column;
                align-items: stretch;
            }

            .reports-search-button {
                width: 100%;
            }

            .reports-card-header {
                align-items: flex-start;
                gap: 10px;
            }
        }

    </style>
}


<!-- =====================================================
     REPORTS PAGE
====================================================== -->

<div class="reports-page">

    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="reports-header">

        <div>
            <small>
                Receptionist Panel
            </small>
            <h1 class="reports-title">
                Reports
            </h1>

            <p class="reports-subtitle">
                Approved laboratory report status.
            </p>
        </div>

        

    </div>


    <!-- =================================================
         TEMP DATA MESSAGES
    ================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-circle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show"
             role="alert">

            <i class="bi bi-info-circle-fill me-2"></i>

            @TempData["Info"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =================================================
         SEARCH CARD
    ================================================== -->

    <div class="reports-search-card">

        <div class="reports-search-title">

            <i class="bi bi-search"></i>

            <h5>
                Search Reports
            </h5>

        </div>


        <form method="get"
              asp-area="Receptionist"
              asp-controller="Reports"
              asp-action="Index">

            <div class="reports-search-form">

                <div class="reports-search-area">

                    <label for="appointmentId"
                           class="reports-label">

                        Appointment ID

                    </label>


                    <input type="text"
                           id="appointmentId"
                           name="appointmentId"
                           value="@appointmentId"
                           class="reports-input"
                           placeholder="Enter Appointment ID..." />

                </div>


                <button type="submit"
                        class="reports-search-button">

                    <i class="bi bi-search"></i>

                    Search

                </button>

            </div>

        </form>

    </div>


    <!-- =================================================
         REPORT CARD
    ================================================== -->

    <div class="reports-card">

        <!-- CARD HEADER -->

        <div class="reports-card-header">

            <div class="reports-card-header-left">

                <h5>
                    Approved Reports
                </h5>

                <p>
                    Reports approved by Admin will appear here.
                </p>

            </div>


            <div class="reports-count">

                @(Model?.Count ?? 0) Reports

            </div>

        </div>


        <!-- =================================================
             REPORT TABLE
        ================================================== -->
        @if (Model != null && Model.Count > 0)
        {
            <div class="reports-table-wrapper">

                <table class="reports-table">

                    <thead>

                        <tr>

                            <th>
                                Report Number
                            </th>

                            <th>
                                Appointment ID
                            </th>

                            <th>
                                Patient
                            </th>

                            <th>
                                Approval Status
                            </th>

                            <th>
                                Approved Date
                            </th>

                            <th>
                                Delivery Status
                            </th>

                            <th>
                                View Report
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            var serial = 1;
                        }


                        @foreach (var report in Model)
                        {
                            <tr>

                                <!-- SERIAL -->

                                <td>

                                    <span class="report-serial">
                                        @serial
                                    </span>

                                </td>


                                <!-- APPOINTMENT -->

                                <td>

                                    <div class="appointment-code">
                                        @report.AppointmentCode
                                    </div>

                                </td>


                                <!-- PATIENT -->

                                <td>

                                    <div class="patient-name">
                                        @report.PatientName
                                    </div>

                                    <span class="patient-code">

                                        @(string.IsNullOrWhiteSpace(report.PatientCode)
                                            ? "N/A"
                                            : report.PatientCode)

                                    </span>

                                </td>


                                <!-- APPROVAL STATUS -->

                                <td>

                                    <span class="approved-badge">

                                        <i class="bi bi-check-circle-fill"></i>

                                        @(report.ApprovalStatusName ?? "Approved")

                                    </span>

                                </td>


                                <!-- APPROVED DATE -->

                                <td>

                                    @if (report.ApprovalDate.HasValue)
                                    {
                                        <div class="approved-date">

                                            @report.ApprovalDate.Value.ToString("dd/MM/yyyy")

                                        </div>

                                        <span class="approved-time">

                                            @report.ApprovalDate.Value.ToString("hh\\:mm tt")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="patient-code">
                                            N/A
                                        </span>
                                    }

                                </td>


                                <!-- DELIVERY STATUS -->

                                <td>

                                    @if (report.IsDelivered)
                                    {
                                        <span class="approved-badge">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Delivered

                                        </span>


                                        @if (report.DeliveredAt.HasValue)
                                        {
                                            <span class="delivery-date">

                                                @report.DeliveredAt.Value.ToString("dd/MM/yyyy hh\\:mm tt")

                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <form asp-area="Receptionist"
                                              asp-controller="Reports"
                                              asp-action="MarkDelivered"
                                              method="post"
                                              style="margin:0;">

                                            @Html.AntiForgeryToken()


                                            <input type="hidden"
                                                   name="appointmentId"
                                                   value="@report.AppointmentId" />


                                            <button type="submit"
                                                    class="reports-search-button"
                                                    onclick="return confirm('Have you handed over this report to the patient?');">

                                                <i class="bi bi-box-arrow-up-right"></i>

                                                Delivered

                                            </button>

                                        </form>
                                    }

                                </td>


                                <!-- VIEW REPORT -->

                                <td>

                                    <a asp-area="Receptionist"
                                       asp-controller="Reports"
                                       asp-action="ViewPdf"
                                       asp-route-id="@report.Id"
                                       class="view-button"
                                       title="View PDF"
                                       target="_blank">

                                        <i class="bi bi-eye-fill"></i>

                                    </a>

                                </td>

                            </tr>


                            serial++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <div class="reports-empty">

                <div class="reports-empty-icon">

                    <i class="bi bi-file-earmark-check"></i>

                </div>


                <h5>
                    No Approved Reports
                </h5>


                <p>
                    Reports approved by Admin will appear here.
                </p>

            </div>
        }

    </div>

</div>