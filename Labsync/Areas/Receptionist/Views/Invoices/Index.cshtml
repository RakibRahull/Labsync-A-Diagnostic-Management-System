@model IEnumerable<LabSync.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
    Layout = "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";

    var invoiceId =
        ViewBag.InvoiceId?.ToString() ?? "";

    var invoiceDate =
        ViewBag.InvoiceDate?.ToString() ?? "";
}


<style>

    /* =====================================================
           PAGE HEADER
        ====================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }

    .page-header-left p {
        margin: 8px 0 0;
        color: #9296aa;
        font-size: 14px;
    }


    /* =====================================================
           ADD INVOICE BUTTON
        ====================================================== */

    .add-invoice-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 10px;
        background: linear-gradient(135deg, #8b5cf6, #a855f7);
        color: #ffffff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 5px 14px rgba(139, 92, 246, .18);
        transition: .2s ease;
    }

        .add-invoice-btn:hover {
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            color: #ffffff;
            transform: translateY(-1px);
        }


    /* =====================================================
           SUCCESS ALERT
        ====================================================== */

    .success-alert {
        background: #eaf8f0;
        color: #198754;
        border: 1px solid #ccefdc;
        border-radius: 11px;
        padding: 13px 16px;
        margin-bottom: 20px;
        font-size: 13px;
    }


    /* =====================================================
           SEARCH CARD
        ====================================================== */

    .search-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
    }

    .search-form {
        display: grid;
        grid-template-columns: 1.2fr 1fr auto auto;
        gap: 12px;
        align-items: end;
    }

    .search-field {
        min-width: 0;
    }

    .search-label {
        display: block;
        margin-bottom: 7px;
        color: #000000;
        font-size: 12px;
        font-weight: 700;
    }

    .search-input {
        width: 100%;
        height: 42px;
        padding: 0 12px;
        background: #ffffff;
        border: 1px solid #e1ddea;
        border-radius: 9px;
        color: #000000;
        font-size: 13px;
        outline: none;
        transition: .2s ease;
    }

        .search-input:focus {
            border-color: #a78bfa;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, .10);
        }

        .search-input::placeholder {
            color: #999999;
        }

    .search-btn {
        height: 42px;
        padding: 0 18px;
        border: none;
        border-radius: 9px;
        background: linear-gradient(135deg, #8b5cf6, #a855f7);
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: .2s ease;
    }

        .search-btn:hover {
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            color: #ffffff;
        }

    .clear-btn {
        height: 42px;
        padding: 0 17px;
        border-radius: 9px;
        background: #ffffff;
        border: 1px solid #ded8e8;
        color: #000000;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: .2s ease;
    }

        .clear-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #000000;
        }


    /* =====================================================
           INVOICE CARD
        ====================================================== */

    .invoice-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
    }

    .invoice-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 19px 20px;
        border-bottom: 1px solid #eeeaf5;
    }

        .invoice-card-header h2 {
            margin: 0;
            color: #000000;
            font-size: 18px;
            font-weight: 700;
        }

    .invoice-total-count {
        color: #000000;
        font-size: 12px;
    }

        .invoice-total-count strong {
            color: #000000;
        }


    /* =====================================================
           TABLE
        ====================================================== */

    .table-responsive {
        overflow-x: auto;
    }

    .invoice-table {
        width: 100%;
        min-width: 1200px;
        border-collapse: collapse;
    }

        .invoice-table thead th {
            background: #faf9fd;
            color: #000000;
            font-size: 12px;
            font-weight: 700;
            padding: 15px 18px;
            text-align: left;
            border-bottom: 1px solid #e8e5ef;
            white-space: nowrap;
        }

        .invoice-table tbody td {
            padding: 17px 18px;
            color: #000000;
            font-size: 13px;
            border-bottom: 1px solid #eeeaf5;
            vertical-align: middle;
        }

        .invoice-table tbody tr:last-child td {
            border-bottom: none;
        }

        .invoice-table tbody tr:hover {
            background: #fcfbfe;
        }


    /* =====================================================
           INVOICE NUMBER
        ====================================================== */

    .invoice-number {
        color: #000000;
        font-weight: 700;
    }


    /* =====================================================
           PATIENT ID
        ====================================================== */

    .patient-id {
        color: #000000;
        font-weight: 700;
    }


    /* =====================================================
           PATIENT NAME
        ====================================================== */

    .patient-name {
        color: #000000;
        font-weight: 600;
    }


    /* =====================================================
           APPOINTMENT
        ====================================================== */

    .appointment-id {
        color: #000000;
        font-weight: 600;
    }


    /* =====================================================
           AMOUNTS
        ====================================================== */

    .amount {
        color: #000000;
        font-weight: 600;
    }

    .paid-amount {
        color: #000000;
        font-weight: 700;
    }

    .due-amount {
        color: #000000;
        font-weight: 700;
    }


    /* =====================================================
           STATUS BADGES
        ====================================================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 0 11px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-paid {
        background: #eaf8f0;
        color: #198754;
        border: 1px solid #ccefdc;
    }

    .status-partial {
        background: #fff7e6;
        color: #b7791f;
        border: 1px solid #f6dfad;
    }

    .status-unpaid {
        background: #fff1f2;
        color: #dc2626;
        border: 1px solid #ffd9de;
    }


    /* =====================================================
           ACTIONS
        ====================================================== */

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .action-btn {
        width: 40px;
        height: 40px;
        border-radius: 9px;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s ease;
    }

    .view-btn {
        border: 1px solid #3b82f6;
        color: #2563eb;
    }

        .view-btn:hover {
            background: #eff6ff;
            color: #1d4ed8;
        }

    .edit-btn {
        border: 1px solid #f59e0b;
        color: #d97706;
    }

        .edit-btn:hover {
            background: #fff7ed;
            color: #b45309;
        }

    .delete-btn {
        border: 1px solid #ef4444;
        color: #dc2626;
    }

        .delete-btn:hover {
            background: #fff1f2;
            color: #b91c1c;
        }


    /* =====================================================
           EMPTY STATE
        ====================================================== */

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 13px;
        border-radius: 13px;
        background: #f1eaff;
        color: #8b5cf6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .empty-state h4 {
        margin: 0;
        color: #000000;
        font-size: 16px;
        font-weight: 700;
    }

    .empty-state p {
        margin: 6px 0 0;
        color: #000000;
        font-size: 12px;
    }


    /* =====================================================
           RESPONSIVE
        ====================================================== */

    @@media (max-width: 900px) {

        .search-form {
            grid-template-columns: 1fr 1fr;
        }

        .search-btn,
        .clear-btn {
            width: 100%;
        }
    }


    @@media (max-width: 600px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .add-invoice-btn {
            width: 100%;
        }

        .search-form {
            grid-template-columns: 1fr;
        }

        .invoice-card-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 6px;
        }
    }

</style>


<!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Invoices
        </h1>

        <p>
            Manage patient invoices and billing information.
        </p>

    </div>


    <a asp-area="Receptionist"
       asp-controller="Invoices"
       asp-action="Create"
       class="add-invoice-btn">

        <i class="bi bi-plus-lg"></i>

        Add Invoice

    </a>

</div>


<!-- =====================================================
     SUCCESS MESSAGE
====================================================== -->
@if (TempData["Success"] != null)
{
    <div class="success-alert">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["Success"]

    </div>
}


<!-- =====================================================
     SEARCH CARD
====================================================== -->

<div class="search-card">

    <form asp-area="Receptionist"
          asp-controller="Invoices"
          asp-action="Index"
          method="get"
          class="search-form">


        <!-- =================================================
             INVOICE SEARCH
        ================================================== -->

        <div class="search-field">

            <label for="invoiceId"
                   class="search-label">

                Invoice ID / Invoice No.

            </label>

            <input type="text"
                   id="invoiceId"
                   name="invoiceId"
                   value="@invoiceId"
                   class="search-input"
                   autocomplete="off" />

        </div>


        <!-- =================================================
             INVOICE DATE
        ================================================== -->

        <div class="search-field">

            <label for="invoiceDate"
                   class="search-label">

                Invoice Date

            </label>

            <input type="date"
                   id="invoiceDate"
                   name="invoiceDate"
                   value="@invoiceDate"
                   class="search-input" />

        </div>


        <!-- =================================================
             SEARCH BUTTON
        ================================================== -->

        <button type="submit"
                class="search-btn">

            <i class="bi bi-search"></i>

            Search

        </button>


        <!-- =================================================
             CLEAR BUTTON
        ================================================== -->
        @if (!string.IsNullOrWhiteSpace(invoiceId) ||
                     !string.IsNullOrWhiteSpace(invoiceDate))
        {
            <a asp-area="Receptionist"
               asp-controller="Invoices"
               asp-action="Index"
               class="clear-btn">

                <i class="bi bi-x-lg"></i>

                Clear

            </a>
        }

    </form>

</div>


<!-- =====================================================
     INVOICE LIST
====================================================== -->

<div class="invoice-card">


    <!-- =================================================
         CARD HEADER
    ================================================== -->

    <div class="invoice-card-header">

        <h2>
            Invoice List
        </h2>

        <div class="invoice-total-count">

            Total:
            <strong>
                @Model.Count()
            </strong>

        </div>

    </div>


    <!-- =================================================
         TABLE
    ================================================== -->

    <div class="table-responsive">

        @if (Model != null && Model.Any())
        {

            <table class="invoice-table">

                <thead>

                    <tr>

                        <th>
                            Invoice No.
                        </th>

                        <th>
                            Patient ID
                        </th>

                        <th>
                            Patient Name
                        </th>

                        <th>
                            Appointment ID
                        </th>

                        <th>
                            Invoice Date
                        </th>

                        <th>
                            Net Amount
                        </th>

                        <th>
                            Paid Amount
                        </th>

                        <th>
                            Due Amount
                        </th>

                        <th>
                            Payment Status
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var invoice in Model)
                    {

                        <tr>


                            <!-- =================================
                                 INVOICE NUMBER
                            ================================== -->

                            <td>

                                <span class="invoice-number">

                                    @(string.IsNullOrWhiteSpace(
                                        invoice.InvoiceNumber)
                                        ? "N/A"
                                        : invoice.InvoiceNumber)

                                </span>

                            </td>


                            <!-- =================================
                                 PATIENT ID
                            ================================== -->

                            <td>

                                <span class="patient-id">

                                    @(invoice.Patient?.PatientCode
                                        ?? invoice.PatientId.ToString())

                                </span>

                            </td>


                            <!-- =================================
                                 PATIENT NAME
                            ================================== -->

                            <td>

                                <span class="patient-name">

                                    @(invoice.Patient != null
                                        ? $"{invoice.Patient.FirstName} {invoice.Patient.LastName}"
                                        : "N/A")

                                </span>

                            </td>


                            <!-- =================================
                                 APPOINTMENT ID
                            ================================== -->

                            <td>

                                <span class="appointment-id">

                                    @(invoice.Appointment?.AppointmentCode
                                        ?? invoice.AppointmentId.ToString())

                                </span>

                            </td>


                            <!-- =================================
                                 INVOICE DATE
                            ================================== -->

                            <td>

                                @(invoice.InvoiceDate.HasValue
                                    ? invoice.InvoiceDate.Value
                                        .ToString("dd MMM yyyy")
                                    : "N/A")

                            </td>


                            <!-- =================================
                                 NET AMOUNT
                            ================================== -->

                            <td>

                                <span class="amount">

                                    BDT @invoice.NetAmount.ToString("N2")

                                </span>

                            </td>


                            <!-- =================================
                                 PAID AMOUNT
                            ================================== -->

                            <td>

                                <span class="paid-amount">

                                    BDT @((invoice.PaidAmount ?? 0)
                                                                            .ToString("N2"))

                                </span>

                            </td>


                            <!-- =================================
                                 DUE AMOUNT
                            ================================== -->

                            <td>

                                <span class="due-amount">

                                    BDT @invoice.DueAmount.ToString("N2")

                                </span>

                            </td>


                            <!-- =================================
                                 PAYMENT STATUS
                            ================================== -->

                            <td>

                                @if (invoice.DueAmount <= 0)
                                {
                                    <span class="status-badge status-paid">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Paid

                                    </span>
                                }
                                else if (
                                    (invoice.PaidAmount ?? 0) > 0)
                                {
                                    <span class="status-badge status-partial">

                                        <i class="bi bi-circle-half me-1"></i>

                                        Partially Paid

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-unpaid">

                                        <i class="bi bi-exclamation-circle me-1"></i>

                                        Unpaid

                                    </span>
                                }

                            </td>


                            <!-- =================================
                                 ACTIONS
                            ================================== -->

                            <td>

                                <div class="action-buttons">


                                    <!-- DETAILS -->

                                    <a asp-area="Receptionist"
                                       asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@invoice.Id"
                                       class="action-btn view-btn"
                                       title="View Details">

                                        <i class="bi bi-eye"></i>

                                    </a>


                                    <!-- EDIT -->

                                    <a asp-area="Receptionist"
                                       asp-controller="Invoices"
                                       asp-action="Edit"
                                       asp-route-id="@invoice.Id"
                                       class="action-btn edit-btn"
                                       title="Edit Invoice">

                                        <i class="bi bi-pencil"></i>

                                    </a>
                                </div>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        }
        else
        {

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-receipt"></i>

                </div>

                <h4>
                    No Invoices Found
                </h4>

                <p>
                    No invoice matches the selected search criteria.
                </p>

            </div>

        }

    </div>

</div>
