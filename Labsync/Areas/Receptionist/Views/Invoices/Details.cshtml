@model LabSync.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
    Layout = "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";
}

<style>

    /* =====================================================
           PAGE HEADER
        ====================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }

    .page-header-left p {
        margin: 8px 0 0;
        color: #9296aa;
        font-size: 14px;
    }


    /* =====================================================
           BACK BUTTON
        ====================================================== */

    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 17px;
        border-radius: 10px;
        background: #ffffff;
        color: #514b61;
        border: 1px solid #ded8e8;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

        .back-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #29243a;
        }


    /* =====================================================
           MAIN CARD
        ====================================================== */

    .invoice-details-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
    }


    /* =====================================================
           SECTION
        ====================================================== */

    .invoice-section {
        margin-bottom: 28px;
    }

        .invoice-section:last-child {
            margin-bottom: 0;
        }

    .section-header {
        margin-bottom: 18px;
    }

        .section-header h2 {
            margin: 0;
            color: #29243a;
            font-size: 19px;
            font-weight: 700;
        }

        .section-header span {
            display: block;
            margin-top: 5px;
            color: #9993a8;
            font-size: 12px;
        }


    /* =====================================================
           INFORMATION BOX
        ====================================================== */

    .information-box {
        background: #faf9fd;
        border: 1px solid #e8e5ef;
        border-radius: 12px;
        padding: 18px;
    }

    .information-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .information-item {
        min-width: 0;
        background: #ffffff;
        border: 1px solid #ece9f3;
        border-radius: 10px;
        padding: 15px 16px;
    }

    .information-label {
        display: block;
        margin-bottom: 6px;
        color: #9993a8;
        font-size: 11px;
        font-weight: 600;
    }

    .information-value {
        color: #29243a;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.45;
        word-break: break-word;
    }


    /* =====================================================
           INVOICE NUMBER
        ====================================================== */

    .invoice-number {
        color: #29243a;
        font-weight: 800;
    }


    /* =====================================================
           AMOUNT BOX
        ====================================================== */

    .amount-box {
        background: linear-gradient(135deg, #8b5cf6, #a855f7);
        border: none;
    }

        .amount-box .information-label {
            color: rgba(255, 255, 255, .78);
        }

        .amount-box .information-value {
            color: #ffffff;
            font-size: 17px;
            font-weight: 800;
        }


    /* =====================================================
           PAYMENT STATUS
        ====================================================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 0 12px;
        border-radius: 999px;
        background: #f3edff;
        color: #7c3aed;
        border: 1px solid #e5d8ff;
        font-size: 11px;
        font-weight: 700;
    }


    /* =====================================================
           PDF SECTION
        ====================================================== */

    .pdf-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 20px;
        padding: 20px;
        background: #faf9fd;
        border: 1px solid #e8e5ef;
        border-radius: 12px;
    }

    .pdf-info {
        min-width: 0;
    }

        .pdf-info h3 {
            margin: 0;
            color: #29243a;
            font-size: 15px;
            font-weight: 700;
        }

        .pdf-info p {
            margin: 6px 0 0;
            color: #9993a8;
            font-size: 12px;
        }

    .pdf-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 0 18px;
        border-radius: 9px;
        background: linear-gradient(135deg, #8b5cf6, #a855f7);
        color: #ffffff;
        border: none;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 5px 14px rgba(139, 92, 246, .18);
        transition: .2s ease;
    }

        .pdf-btn:hover {
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            color: #ffffff;
        }


    /* =====================================================
           ACTIONS
        ====================================================== */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-top: 27px;
        padding-top: 22px;
        border-top: 1px solid #eeeaf5;
    }

    .edit-btn {
        min-height: 43px;
        padding: 0 19px;
        border: none;
        border-radius: 9px;
        background: linear-gradient(135deg, #8b5cf6, #a855f7);
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 5px 14px rgba(139, 92, 246, .18);
        transition: .2s ease;
    }

        .edit-btn:hover {
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            color: #ffffff;
        }

    .delete-btn {
        min-height: 43px;
        padding: 0 19px;
        border: 1px solid #ffd9de;
        border-radius: 9px;
        background: #fff1f2;
        color: #dc2626;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: .2s ease;
    }

        .delete-btn:hover {
            background: #ffe4e8;
            border-color: #ffc5cd;
            color: #b91c1c;
        }


    /* =====================================================
           RESPONSIVE
        ====================================================== */

    @@media (max-width: 800px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .invoice-details-card {
            padding: 20px;
        }

        .information-grid {
            grid-template-columns: 1fr;
        }

        .pdf-section {
            align-items: flex-start;
            flex-direction: column;
        }

        .pdf-btn {
            width: 100%;
        }

        .form-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .edit-btn,
        .delete-btn {
            width: 100%;
        }
    }

</style>


<!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Invoice Details
        </h1>

        <p>
            View invoice and billing information.
        </p>

    </div>


    <a asp-area="Receptionist"
       asp-controller="Invoices"
       asp-action="Index"
       class="back-btn">

        <i class="bi bi-arrow-left"></i>

        Back to Invoices

    </a>

</div>


<!-- =====================================================
     MAIN CARD
====================================================== -->

<div class="invoice-details-card">


    <!-- =================================================
         INVOICE INFORMATION
    ================================================== -->

    <div class="invoice-section">

        <div class="section-header">

            <h2>
                Invoice Information
            </h2>

        </div>


        <div class="information-box">

            <div class="information-grid">


                <!-- Invoice Number -->

                <div class="information-item">

                    <span class="information-label">
                        Invoice Number
                    </span>

                    <div class="information-value invoice-number">

                        @(Model.InvoiceNumber ?? "N/A")

                    </div>

                </div>


                <!-- Invoice Date -->

                <div class="information-item">

                    <span class="information-label">
                        Invoice Date
                    </span>

                    <div class="information-value">

                        @(Model.InvoiceDate.HasValue
                            ? Model.InvoiceDate.Value.ToString(
                                "dd MMM yyyy hh:mm tt")
                            : "N/A")

                    </div>

                </div>


                <!-- Patient ID -->

                <div class="information-item">

                    <span class="information-label">
                        Patient ID
                    </span>

                    <div class="information-value">

                        @Model.PatientId

                    </div>

                </div>


                <!-- Patient Name -->

                <div class="information-item">

                    <span class="information-label">
                        Patient Name
                    </span>

                    <div class="information-value">

                        @(Model.Patient != null
                            ? $"{Model.Patient.FirstName} {Model.Patient.LastName}"
                            : "N/A")

                    </div>

                </div>


                <!-- Appointment ID -->

                <div class="information-item">

                    <span class="information-label">
                        Appointment ID
                    </span>

                    <div class="information-value">

                        @Model.AppointmentId

                    </div>

                </div>


                <!-- Patient Phone -->

                <div class="information-item">

                    <span class="information-label">
                        Patient Phone
                    </span>

                    <div class="information-value">

                        @(Model.Patient?.Phone ?? "N/A")

                    </div>

                </div>


                <!-- Patient Email -->

                <div class="information-item">

                    <span class="information-label">
                        Patient Email
                    </span>

                    <div class="information-value">

                        @(Model.Patient?.Email ?? "N/A")

                    </div>

                </div>


                <!-- Subtotal -->

                <div class="information-item">

                    <span class="information-label">
                        Subtotal
                    </span>

                    <div class="information-value">

                        BDT @Model.Subtotal.ToString("N2")

                    </div>

                </div>


                <!-- Discount -->

                <div class="information-item">

                    <span class="information-label">
                        Discount
                    </span>

                    <div class="information-value">

                        BDT @((Model.Discount ?? 0m).ToString("N2"))

                    </div>

                </div>


                <!-- Tax -->

                <div class="information-item">

                    <span class="information-label">
                        Tax
                    </span>

                    <div class="information-value">

                        BDT @((Model.Tax ?? 0m).ToString("N2"))

                    </div>

                </div>


                <!-- Paid Amount -->

                <div class="information-item">

                    <span class="information-label">
                        Paid Amount
                    </span>

                    <div class="information-value">

                        BDT @((Model.PaidAmount ?? 0m).ToString("N2"))

                    </div>

                </div>


                <!-- Due Amount -->

                <div class="information-item">

                    <span class="information-label">
                        Due Amount
                    </span>

                    <div class="information-value">

                        BDT @Model.DueAmount.ToString("N2")

                    </div>

                </div>


                <!-- Net Amount -->

                <div class="information-item amount-box">

                    <span class="information-label">
                        Net Amount
                    </span>

                    <div class="information-value">

                        BDT @Model.NetAmount.ToString("N2")

                    </div>

                </div>


                <!-- Payment Status -->

                <div class="information-item">

                    <span class="information-label">
                        Payment Status
                    </span>

                    <div class="information-value">

                        <span class="status-badge">

                            @(ViewBag.PaymentStatusName ?? "N/A")

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =================================================
         PDF SECTION
    ================================================== -->

    <div class="invoice-section">

        <div class="section-header">

            <h2>
                Invoice PDF
            </h2>

        </div>


        <div class="pdf-section">

            <div class="pdf-info">

                <h3>

                    <i class="bi bi-file-earmark-pdf"></i>

                    View Invoice PDF

                </h3>

                <p>
                    The PDF will open in a new browser tab.
                    Use the browser PDF viewer's Print option to print.
                </p>

            </div>


            <a asp-area="Receptionist"
               asp-controller="Invoices"
               asp-action="GeneratePdf"
               asp-route-id="@Model.Id"
               target="_blank"
               rel="noopener noreferrer"
               class="pdf-btn">

                <i class="bi bi-file-earmark-pdf-fill"></i>

                Open PDF &amp; Print

            </a>

        </div>

    </div>


    <!-- =================================================
         ACTIONS
    ================================================== -->

    <div class="form-actions">


        <a asp-area="Receptionist"
           asp-controller="Invoices"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="edit-btn">

            <i class="bi bi-pencil"></i>

            Edit Invoice

        </a>
    </div>

</div>
