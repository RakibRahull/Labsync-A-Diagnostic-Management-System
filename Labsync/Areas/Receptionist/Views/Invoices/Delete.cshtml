@model LabSync.Models.Invoice

@{
    ViewData["Title"] = "Delete Invoice";
    Layout = "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";
}

<style>

    /* =====================================================
           PAGE HEADER
        ====================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }

    .page-header-left p {
        margin: 8px 0 0;
        color: #9296aa;
        font-size: 14px;
    }


    /* =====================================================
           BACK BUTTON
        ====================================================== */

    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 17px;
        border-radius: 10px;
        background: #ffffff;
        color: #514b61;
        border: 1px solid #ded8e8;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

        .back-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #29243a;
        }


    /* =====================================================
           MAIN CARD
        ====================================================== */

    .delete-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
    }


    /* =====================================================
           WARNING
        ====================================================== */

    .warning-box {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-bottom: 25px;
        padding: 17px 18px;
        background: #fff7e6;
        border: 1px solid #f6dfad;
        border-radius: 11px;
        color: #8a5a00;
    }

    .warning-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #fff1c7;
        color: #b7791f;
        font-size: 16px;
    }

    .warning-content strong {
        display: block;
        color: #7a5200;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .warning-content p {
        margin: 0;
        color: #9b6b1f;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =====================================================
           SECTION
        ====================================================== */

    .invoice-section {
        margin-bottom: 28px;
    }

        .invoice-section:last-child {
            margin-bottom: 0;
        }

    .section-header {
        margin-bottom: 18px;
    }

        .section-header h2 {
            margin: 0;
            color: #29243a;
            font-size: 19px;
            font-weight: 700;
        }

        .section-header span {
            display: block;
            margin-top: 5px;
            color: #9993a8;
            font-size: 12px;
        }


    /* =====================================================
           INFORMATION BOX
        ====================================================== */

    .information-box {
        background: #faf9fd;
        border: 1px solid #e8e5ef;
        border-radius: 12px;
        padding: 18px;
    }

    .information-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .information-item {
        min-width: 0;
        background: #ffffff;
        border: 1px solid #ece9f3;
        border-radius: 10px;
        padding: 15px 16px;
    }

    .information-label {
        display: block;
        margin-bottom: 6px;
        color: #9993a8;
        font-size: 11px;
        font-weight: 600;
    }

    .information-value {
        color: #29243a;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.45;
        word-break: break-word;
    }

    .invoice-number {
        color: #7c3aed;
        font-weight: 800;
    }


    /* =====================================================
           AMOUNT
        ====================================================== */

    .amount-box {
        background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
        border: none;
    }

        .amount-box .information-label {
            color: rgba(255, 255, 255, .78);
        }

        .amount-box .information-value {
            color: #ffffff;
            font-size: 17px;
            font-weight: 800;
        }


    /* =====================================================
           DANGER AMOUNT
        ====================================================== */

    .due-box {
        background: #fff7f8;
        border-color: #ffd9de;
    }

        .due-box .information-value {
            color: #dc2626;
            font-weight: 800;
        }


    /* =====================================================
           STATUS
        ====================================================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 31px;
        padding: 0 12px;
        border-radius: 999px;
        background: #f3edff;
        border: 1px solid #e5d8ff;
        color: #7c3aed;
        font-size: 11px;
        font-weight: 700;
    }


    /* =====================================================
           DELETE NOTE
        ====================================================== */

    .delete-note {
        margin-top: 18px;
        padding: 12px 14px;
        background: #faf9fd;
        border: 1px solid #e8e5ef;
        border-radius: 9px;
        color: #9296aa;
        font-size: 11px;
        line-height: 1.5;
    }


    /* =====================================================
           ACTIONS
        ====================================================== */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-top: 27px;
        padding-top: 22px;
        border-top: 1px solid #eeeaf5;
    }

    .cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 43px;
        padding: 0 18px;
        border-radius: 9px;
        background: #ffffff;
        color: #514b61;
        border: 1px solid #ded8e8;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

        .cancel-btn:hover {
            background: #f8f6fc;
            color: #29243a;
        }

    .delete-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 0 20px;
        border-radius: 9px;
        background: #dc2626;
        color: #ffffff;
        border: 1px solid #dc2626;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
    }

        .delete-btn:hover {
            background: #b91c1c;
            border-color: #b91c1c;
            color: #ffffff;
        }


    /* =====================================================
           RESPONSIVE
        ====================================================== */

    @@media (max-width: 800px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .delete-card {
            padding: 20px;
        }

        .information-grid {
            grid-template-columns: 1fr;
        }

        .warning-box {
            align-items: flex-start;
        }

        .form-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .cancel-btn,
        .delete-btn {
            width: 100%;
        }
    }

</style>


<!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Delete Invoice
        </h1>

        <p>
            Remove this invoice from the system.
        </p>

    </div>


    <a asp-area="Receptionist"
       asp-controller="Invoices"
       asp-action="Index"
       class="back-btn">

        <i class="bi bi-arrow-left"></i>

        Back to Invoices

    </a>

</div>


<!-- =====================================================
     MAIN CARD
====================================================== -->

<div class="delete-card">


    <!-- =================================================
         WARNING
    ================================================== -->

    <div class="warning-box">

        <div class="warning-icon">

            <i class="bi bi-exclamation-triangle-fill"></i>

        </div>


        <div class="warning-content">

            <strong>
                Are you sure you want to delete this invoice?
            </strong>

            <p>
                This action cannot be undone. The invoice and its
                associated invoice items will be removed from the system.
            </p>

        </div>

    </div>


    <!-- =================================================
         INVOICE INFORMATION
    ================================================== -->

    <div class="invoice-section">

        <div class="section-header">

            <h2>
                Invoice Information
            </h2>

            <span>
                Review the invoice details before deleting.
            </span>

        </div>


        <div class="information-box">

            <div class="information-grid">


                <!-- Invoice Number -->

                <div class="information-item">

                    <span class="information-label">
                        Invoice Number
                    </span>

                    <div class="information-value invoice-number">

                        @(Model.InvoiceNumber ?? "N/A")

                    </div>

                </div>


                <!-- Invoice Date -->

                <div class="information-item">

                    <span class="information-label">
                        Invoice Date
                    </span>

                    <div class="information-value">

                        @(Model.InvoiceDate.HasValue
                            ? Model.InvoiceDate.Value.ToString(
                                "dd MMM yyyy hh:mm tt")
                            : "N/A")

                    </div>

                </div>


                <!-- Patient ID -->

                <div class="information-item">

                    <span class="information-label">
                        Patient ID
                    </span>

                    <div class="information-value">

                        @(
                            Model.Patient?.PatientCode
                            ?? Model.PatientId.ToString()
                        )

                    </div>

                </div>


                <!-- Patient Name -->

                <div class="information-item">

                    <span class="information-label">
                        Patient Name
                    </span>

                    <div class="information-value">

                        @(Model.Patient != null
                            ? $"{Model.Patient.FirstName} {Model.Patient.LastName}"
                            : "N/A")

                    </div>

                </div>


                <!-- Appointment ID -->

                <div class="information-item">

                    <span class="information-label">
                        Appointment ID
                    </span>

                    <div class="information-value">

                        @(Model.Appointment?.AppointmentCode
                            ?? Model.AppointmentId.ToString())

                    </div>

                </div>


                <!-- Payment Status -->

                <div class="information-item">

                    <span class="information-label">
                        Payment Status
                    </span>

                    <div class="information-value">

                        <span class="status-badge">

                            @Model.PaymentStatusId

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =================================================
         BILLING INFORMATION
    ================================================== -->

    <div class="invoice-section">

        <div class="section-header">

            <h2>
                Billing Information
            </h2>

            <span>
                Current invoice amount summary.
            </span>

        </div>


        <div class="information-box">

            <div class="information-grid">


                <!-- Subtotal -->

                <div class="information-item">

                    <span class="information-label">
                        Subtotal
                    </span>

                    <div class="information-value">

                        BDT @Model.Subtotal.ToString("N2")

                    </div>

                </div>


                <!-- Discount -->

                <div class="information-item">

                    <span class="information-label">
                        Discount
                    </span>

                    <div class="information-value">

                        BDT @((Model.Discount ?? 0m).ToString("N2"))

                    </div>

                </div>


                <!-- Tax -->

                <div class="information-item">

                    <span class="information-label">
                        Tax
                    </span>

                    <div class="information-value">

                        BDT @((Model.Tax ?? 0m).ToString("N2"))

                    </div>

                </div>


                <!-- Paid Amount -->

                <div class="information-item">

                    <span class="information-label">
                        Paid Amount
                    </span>

                    <div class="information-value">

                        BDT @((Model.PaidAmount ?? 0m).ToString("N2"))

                    </div>

                </div>


                <!-- Net Amount -->

                <div class="information-item amount-box">

                    <span class="information-label">
                        Net Amount
                    </span>

                    <div class="information-value">

                        BDT @Model.NetAmount.ToString("N2")

                    </div>

                </div>


                <!-- Due Amount -->

                <div class="information-item due-box">

                    <span class="information-label">
                        Due Amount
                    </span>

                    <div class="information-value">

                        BDT @Model.DueAmount.ToString("N2")

                    </div>

                </div>

            </div>


            <div class="delete-note">

                <i class="bi bi-info-circle me-1"></i>

                Deleting this invoice will also remove the
                invoice items associated with it.

            </div>

        </div>

    </div>


    <!-- =================================================
         DELETE FORM
    ================================================== -->

    <form asp-area="Receptionist"
          asp-controller="Invoices"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()


        <div class="form-actions">


            <a asp-area="Receptionist"
               asp-controller="Invoices"
               asp-action="Index"
               class="cancel-btn">

                <i class="bi bi-x-lg"></i>

                Cancel

            </a>


            <button type="submit"
                    class="delete-btn">

                <i class="bi bi-trash"></i>

                Yes, Delete Invoice

            </button>

        </div>

    </form>

</div>
