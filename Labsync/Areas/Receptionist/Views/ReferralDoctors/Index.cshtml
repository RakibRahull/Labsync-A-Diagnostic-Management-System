@model IEnumerable<LabSync.Models.ReferralDoctor>

@{
    ViewData["Title"] = "Referral Doctors";
    Layout = "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";

    var search = ViewBag.Search?.ToString() ?? "";
}


<style>

    /* =====================================================
           PAGE HEADER
        ====================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }

    .page-header-left p {
        margin: 8px 0 0;
        color: #9296aa;
        font-size: 14px;
    }


    /* =====================================================
           SEARCH CARD
        ====================================================== */

    .search-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
    }

    .search-form {
        display: flex;
        align-items: flex-end;
        gap: 12px;
    }

    .search-field {
        flex: 1;
    }

    .search-label {
        display: block;
        margin-bottom: 7px;
        color: #514b61;
        font-size: 12px;
        font-weight: 700;
    }

    .search-input {
        width: 100%;
        height: 42px;
        padding: 0 13px;
        border: 1px solid #e1ddea;
        border-radius: 9px;
        background: #ffffff;
        color: #29243a;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        outline: none;
        transition: .2s ease;
    }

        .search-input:focus {
            border-color: #a78bfa;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, .10);
        }

        .search-input::placeholder {
            color: #aaa4b5;
        }

    .search-btn {
        height: 42px;
        min-width: 100px;
        padding: 0 17px;
        border: none;
        border-radius: 9px;
        background: linear-gradient(135deg, #8b5cf6, #a855f7);
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        box-shadow: 0 5px 14px rgba(139, 92, 246, .18);
        transition: .2s ease;
    }

        .search-btn:hover {
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            color: #ffffff;
        }

    .clear-btn {
        height: 42px;
        padding: 0 17px;
        border-radius: 9px;
        background: #ffffff;
        color: #514b61;
        border: 1px solid #ded8e8;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        transition: .2s ease;
    }

        .clear-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #29243a;
        }


    /* =====================================================
           TABLE CARD
        ====================================================== */

    .table-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
    }

    .table-responsive {
        overflow-x: auto;
    }

    .doctor-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
    }

        .doctor-table thead th {
            background: #faf9fd;
            color: #514b61;
            font-size: 12px;
            font-weight: 700;
            padding: 16px 20px;
            text-align: left;
            border-bottom: 1px solid #e8e5ef;
            white-space: nowrap;
        }

        .doctor-table tbody td {
            padding: 18px 20px;
            color: #29243a;
            font-size: 13px;
            border-bottom: 1px solid #eeeaf5;
            vertical-align: middle;
        }

        .doctor-table tbody tr:last-child td {
            border-bottom: none;
        }

        .doctor-table tbody tr:hover {
            background: #fcfbfe;
        }


    /* =====================================================
           DOCTOR NAME
        ====================================================== */

    .doctor-name {
        color: #29243a;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.4;
    }

    .doctor-id {
        margin-top: 4px;
        color: #9993a8;
        font-size: 11px;
    }


    /* =====================================================
           SPECIALIZATION BADGE
        ====================================================== */

    .specialization-badge {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        padding: 0 12px;
        border-radius: 9px;
        background: #f1eaff;
        color: #7c3aed;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =====================================================
           ACTION BUTTON
        ====================================================== */

    .actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .action-btn {
        width: 48px;
        height: 48px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        font-size: 17px;
        text-decoration: none;
        transition: .2s ease;
    }

        .action-btn.view {
            border: 1px solid #3b82f6;
            color: #2563eb;
        }

            .action-btn.view:hover {
                background: #eff6ff;
                color: #1d4ed8;
            }


    /* =====================================================
           EMPTY STATE
        ====================================================== */

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 54px;
        height: 54px;
        margin: 0 auto 13px;
        border-radius: 13px;
        background: #f1eaff;
        color: #8b5cf6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .empty-state h4 {
        margin: 0;
        color: #29243a;
        font-size: 16px;
        font-weight: 700;
    }

    .empty-state p {
        margin: 6px 0 0;
        color: #9993a8;
        font-size: 12px;
    }


    /* =====================================================
           RESPONSIVE
        ====================================================== */

    @@media (max-width: 700px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .search-form {
            align-items: stretch;
            flex-direction: column;
        }

        .search-btn,
        .clear-btn {
            width: 100%;
        }
    }

</style>


<!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Referral Doctors
        </h1>

        <p>
            View referral doctors and their information.
        </p>

    </div>

</div>


<!-- =====================================================
     SEARCH
====================================================== -->

<div class="search-card">

    <form asp-area="Receptionist"
          asp-controller="ReferralDoctors"
          asp-action="Index"
          method="get"
          class="search-form">

        <div class="search-field">

            <label class="search-label"
                   for="search">

                Doctor Name

            </label>

            <input type="text"
                   id="search"
                   name="search"
                   value="@search"
                   class="search-input"
                   placeholder="Search by doctor name..."
                   autocomplete="off" />

        </div>


        <button type="submit"
                class="search-btn">

            <i class="bi bi-search"></i>

            Search

        </button>


        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-area="Receptionist"
               asp-controller="ReferralDoctors"
               asp-action="Index"
               class="clear-btn">

                <i class="bi bi-x-lg"></i>

                Clear

            </a>
        }

    </form>

</div>


<!-- =====================================================
     TABLE
====================================================== -->

<div class="table-card">

    <div class="table-responsive">

        @if (Model != null && Model.Any())
        {

            <table class="doctor-table">

                <thead>

                    <tr>

                        <th style="width:70px;">
                            #
                        </th>

                        <th>
                            Doctor Name
                        </th>

                        <th>
                            Specialization
                        </th>

                        <th>
                            Hospital
                        </th>

                        <th>
                            Phone
                        </th>

                        <th>
                            Email
                        </th>

                        <th style="width:100px;">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @{
                        var serial = 1;
                    }

                    @foreach (var doctor in Model)
                    {

                        <tr>

                            <!-- =========================
                                 SERIAL
                            ========================== -->

                            <td>
                                @serial
                            </td>


                            <!-- =========================
                                 DOCTOR NAME
                            ========================== -->

                            <td>

                                <div class="doctor-name">

                                    @(string.IsNullOrWhiteSpace(doctor.DoctorName)
                                        ? "N/A"
                                        : doctor.DoctorName)

                                </div>

                                <div class="doctor-id">

                                    Doctor ID:
                                    @doctor.Id

                                </div>

                            </td>


                            <!-- =========================
                                 SPECIALIZATION
                            ========================== -->

                            <td>

                                <span class="specialization-badge">

                                    @(string.IsNullOrWhiteSpace(
                                        doctor.Specialization)
                                        ? "N/A"
                                        : doctor.Specialization)

                                </span>

                            </td>


                            <!-- =========================
                                 HOSPITAL
                            ========================== -->

                            <td>

                                @(string.IsNullOrWhiteSpace(
                                    doctor.HospitalName)
                                    ? "N/A"
                                    : doctor.HospitalName)

                            </td>


                            <!-- =========================
                                 PHONE
                            ========================== -->

                            <td>

                                @(string.IsNullOrWhiteSpace(
                                    doctor.Phone)
                                    ? "N/A"
                                    : doctor.Phone)

                            </td>


                            <!-- =========================
                                 EMAIL
                            ========================== -->

                            <td>

                                @(string.IsNullOrWhiteSpace(
                                    doctor.Email)
                                    ? "N/A"
                                    : doctor.Email)

                            </td>


                            <!-- =========================
                                 ACTION
                            ========================== -->

                            <td>

                                <div class="actions">

                                    <a asp-area="Receptionist"
                                       asp-controller="ReferralDoctors"
                                       asp-action="Details"
                                       asp-route-id="@doctor.Id"
                                       class="action-btn view"
                                       title="View Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>

                        serial++;
                    }

                </tbody>

            </table>

        }
        else
        {

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-person-badge"></i>

                </div>

                <h4>
                    No Referral Doctors Found
                </h4>

                <p>
                    No referral doctor matches your search.
                </p>

            </div>

        }

    </div>

</div>
