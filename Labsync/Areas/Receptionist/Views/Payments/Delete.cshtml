@model LabSync.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
    Layout = "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";


    // =========================================================
    // PAYMENT AMOUNT
    // Safe for decimal / decimal?
    // =========================================================

    decimal paymentAmount =
        Convert.ToDecimal(Model.Amount);


    // =========================================================
    // PAYMENT METHOD
    // =========================================================

    string paymentMethodName =
        Model.PaymentMethodId.ToString();

    if (Model.PaymentMethod != null)
    {
        paymentMethodName =
            Model.PaymentMethod.MethodName;
    }


    // =========================================================
    // TRANSACTION NUMBER
    // =========================================================

    string transactionNumber =
        "N/A";

    if (!string.IsNullOrWhiteSpace(
        Model.TransactionNumber))
    {
        transactionNumber =
            Model.TransactionNumber;
    }


    // =========================================================
    // PAYMENT DATE
    // =========================================================

    string paymentDate =
        "N/A";

    if (Model.PaymentDate.HasValue)
    {
        paymentDate =
            Model.PaymentDate.Value
                .ToString("dd MMM yyyy hh:mm tt");
    }


    // =========================================================
    // PATIENT
    // =========================================================

    string patientName =
        "N/A";

    string patientCode =
        "N/A";

    string patientPhone =
        "N/A";


    if (Model.Invoice != null &&
        Model.Invoice.Patient != null)
    {
        patientName =
            Model.Invoice.Patient.FirstName +
            " " +
            Model.Invoice.Patient.LastName;

        patientCode =
            Model.Invoice.Patient.PatientCode
            ?? "N/A";

        patientPhone =
            Model.Invoice.Patient.Phone
            ?? "N/A";
    }


    // =========================================================
    // INVOICE
    // =========================================================

    string invoiceNumber =
        "N/A";

    string invoiceDate =
        "N/A";


    if (Model.Invoice != null)
    {
        if (!string.IsNullOrWhiteSpace(
            Model.Invoice.InvoiceNumber))
        {
            invoiceNumber =
                Model.Invoice.InvoiceNumber;
        }


        if (Model.Invoice.InvoiceDate.HasValue)
        {
            invoiceDate =
                Model.Invoice.InvoiceDate.Value
                    .ToString("dd MMM yyyy");
        }
    }
}


<style>

    /* =========================================================
           GLOBAL
        ========================================================== */

    * {
        box-sizing: border-box;
    }

    body {
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f7fc;
        color: #000000;
    }


    /* =========================================================
           PAGE HEADER
        ========================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }


    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }


    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }


    .page-header-left p {
        margin: 8px 0 0;
        color: #000000;
        font-size: 14px;
    }


    /* =========================================================
           MAIN CARD
        ========================================================== */

    .delete-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
    }


    /* =========================================================
           WARNING
        ========================================================== */

    .warning-box {
        padding: 16px 18px;
        margin-bottom: 28px;
        background: #fff8f8;
        border: 1px solid #f0d7d7;
        border-left: 4px solid #dc2626;
        border-radius: 10px;
    }


    .warning-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #b91c1c;
        font-size: 14px;
        font-weight: 700;
    }


        .warning-title i {
            font-size: 15px;
        }


    .warning-box p {
        margin: 7px 0 0;
        color: #777080;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================================
           SECTION HEADER
        ========================================================== */

    .section-header {
        margin-bottom: 10px;
    }


        .section-header h2 {
            margin: 0;
            color: #18213a;
            font-size: 19px;
            font-weight: 700;
        }


        .section-header p {
            margin: 5px 0 0;
            color: #9296aa;
            font-size: 13px;
        }


    .section-line {
        width: 100%;
        height: 1px;
        background: #ece9f2;
        margin-bottom: 20px;
    }


    .section-space {
        margin-top: 30px;
    }


    /* =========================================================
           INFORMATION GRID
        ========================================================== */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }


    .info-box {
        min-height: 76px;
        padding: 14px;
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 10px;
    }


        .info-box span {
            display: block;
            margin-bottom: 7px;
            color: #9296aa;
            font-size: 11px;
            font-weight: 500;
        }


        .info-box strong {
            display: block;
            color: #000000;
            font-size: 14px;
            font-weight: 600;
            word-break: break-word;
        }


    /* =========================================================
           PAYMENT AMOUNT
        ========================================================== */

    .amount-highlight {
        background: #faf7ff;
        border-color: #d9cdf6;
    }


        .amount-highlight strong {
            color: #8b5cf6;
            font-size: 17px;
        }


    /* =========================================================
           TRANSACTION
        ========================================================== */

    .transaction-value {
        font-family: Consolas, "Courier New", monospace;
        font-size: 13px !important;
    }


    /* =========================================================
           ACTIONS
        ========================================================== */

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #ece9f2;
        flex-wrap: wrap;
    }


    /* =========================================================
           SECONDARY
        ========================================================== */

    .btn-secondary {
        min-height: 43px;
        padding: 0 18px;
        border: 1px solid #ddd9e7;
        border-radius: 9px;
        background: #ffffff;
        color: #000000;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: .2s ease;
    }


        .btn-secondary:hover {
            background: #f8f6fb;
            color: #000000;
        }


    /* =========================================================
           DELETE BUTTON
        ========================================================== */

    .btn-danger {
        min-height: 43px;
        padding: 0 18px;
        border: 1px solid #ffd9de;
        border-radius: 9px;
        background: #fff1f2;
        color: #dc2626;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        cursor: pointer;
        transition: .2s ease;
    }


        .btn-danger:hover {
            background: #ffe4e8;
            color: #b91c1c;
        }


    /* =========================================================
           PDF BUTTON
        ========================================================== */

    .btn-purple {
        min-height: 43px;
        padding: 0 17px;
        border: none;
        border-radius: 9px;
        background: linear-gradient( 135deg, #8b5cf6, #a855f7 );
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: .2s ease;
    }


        .btn-purple:hover {
            background: linear-gradient( 135deg, #7c3aed, #9333ea );
            color: #ffffff;
            transform: translateY(-1px);
        }


    /* =========================================================
           RESPONSIVE
        ========================================================== */

    @@media (max-width: 950px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .info-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 700px) {

        .delete-card {
            padding: 20px;
        }


        .page-header-left h1 {
            font-size: 26px;
        }


        .info-grid {
            grid-template-columns: 1fr;
        }


        .form-actions {
            flex-direction: column;
        }


            .form-actions a,
            .form-actions button {
                width: 100%;
            }
    }

</style>


<!-- =========================================================
     PAGE HEADER
========================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Delete Payment
        </h1>

        <p>
            Remove this payment from the system.
        </p>

    </div>


    <a asp-area="Receptionist"
       asp-controller="Payments"
       asp-action="Index"
       class="btn-secondary">

        <i class="bi bi-arrow-left"></i>

        Back to Payments

    </a>

</div>


<!-- =========================================================
     MAIN CARD
========================================================== -->

<div class="delete-card">


    <!-- =====================================================
         WARNING
    ====================================================== -->

    <div class="warning-box">

        <div class="warning-title">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <span>
                Are you sure you want to delete this payment?
            </span>

        </div>


        <p>
            This action cannot be undone. Deleting this payment
            will also recalculate the related invoice payment
            status, paid amount and due amount.
        </p>

    </div>


    <!-- =====================================================
         PAYMENT INFORMATION
    ====================================================== -->

    <div class="section-header">

        <h2>
            Payment Information
        </h2>

        <p>
            Payment details that will be permanently removed.
        </p>

    </div>

    <div class="section-line"></div>


    <div class="info-grid">


        <!-- Payment ID -->

        <div class="info-box">

            <span>
                Payment ID
            </span>

            <strong>
                PAT@(Model.Id)
            </strong>

        </div>


        <!-- Invoice ID -->

        <div class="info-box">

            <span>
                Invoice ID
            </span>

            <strong>
                @Model.InvoiceId
            </strong>

        </div>


        <!-- Payment Date -->

        <div class="info-box">

            <span>
                Payment Date
            </span>

            <strong>
                @paymentDate
            </strong>

        </div>


        <!-- Payment Method -->

        <div class="info-box">

            <span>
                Payment Method
            </span>

            <strong>
                @paymentMethodName
            </strong>

        </div>


        <!-- Payment Amount -->

        <div class="info-box amount-highlight">

            <span>
                Payment Amount
            </span>

            <strong>
                BDT @paymentAmount.ToString("N2")
            </strong>

        </div>


        <!-- Transaction Number -->

        <div class="info-box">

            <span>
                Transaction Number
            </span>

            <strong class="transaction-value">
                @transactionNumber
            </strong>

        </div>

    </div>


    <!-- =====================================================
         INVOICE INFORMATION
    ====================================================== -->

    <div class="section-header section-space">

        <h2>
            Invoice Information
        </h2>

        <p>
            Invoice connected to this payment.
        </p>

    </div>

    <div class="section-line"></div>


    <div class="info-grid">


        <!-- Invoice Number -->

        <div class="info-box">

            <span>
                Invoice Number
            </span>

            <strong>
                @invoiceNumber
            </strong>

        </div>


        <!-- Invoice Date -->

        <div class="info-box">

            <span>
                Invoice Date
            </span>

            <strong>
                @invoiceDate
            </strong>

        </div>


        <!-- Patient Name -->

        <div class="info-box">

            <span>
                Patient Name
            </span>

            <strong>
                @patientName
            </strong>

        </div>


        <!-- Patient Code -->

        <div class="info-box">

            <span>
                Patient Code
            </span>

            <strong>
                @patientCode
            </strong>

        </div>


        <!-- Patient Phone -->

        <div class="info-box">

            <span>
                Patient Phone
            </span>

            <strong>
                @patientPhone
            </strong>

        </div>

    </div>


    <!-- =====================================================
         ACTIONS
    ====================================================== -->

    <form asp-area="Receptionist"
          asp-controller="Payments"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()


        <div class="form-actions">


            <!-- Cancel -->

            <a asp-area="Receptionist"
               asp-controller="Payments"
               asp-action="Index"
               class="btn-secondary">

                Cancel

            </a>


            <!-- View PDF -->

            <a asp-area="Receptionist"
               asp-controller="Payments"
               asp-action="GeneratePdf"
               asp-route-id="@Model.Id"
               target="_blank"
               class="btn-purple">

                <i class="bi bi-file-earmark-pdf"></i>

                View PDF

            </a>


            <!-- Delete -->

            <button type="submit"
                    class="btn-danger">

                <i class="bi bi-trash"></i>

                Yes, Delete Payment

            </button>

        </div>

    </form>

</div>