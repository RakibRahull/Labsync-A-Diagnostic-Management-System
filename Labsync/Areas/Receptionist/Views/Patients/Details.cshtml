@model LabSync.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
    Layout = "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";
}


<style>

    /* =====================================================
           PAGE HEADER
        ====================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }

    .page-header-left p {
        margin: 8px 0 0;
        color: #9296aa;
        font-size: 14px;
    }


    /* =====================================================
           BACK BUTTON
        ====================================================== */

    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 17px;
        border-radius: 10px;
        background: #ffffff;
        color: #514b61;
        border: 1px solid #ded8e8;
        font-size: 14px;
        font-weight: 600;
        transition: 0.2s ease;
        text-decoration: none;
    }

        .back-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #29243a;
        }


    /* =====================================================
           DETAILS CARD
        ====================================================== */

    .details-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(30, 20, 50, 0.04);
    }


    /* =====================================================
           DETAILS HEADER
        ====================================================== */

    .details-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eeeaf5;
    }

    .patient-title {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .patient-avatar-large {
        width: 50px;
        height: 50px;
        border-radius: 13px;
        background: #f1eaff;
        color: #8b5cf6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .patient-title h2 {
        margin: 0;
        color: #29243a;
        font-size: 22px;
        font-weight: 700;
    }

    .patient-title span {
        display: block;
        margin-top: 5px;
        color: #29243a;
        font-size: 12px;
        font-weight: 500;
    }


    /* =====================================================
           EDIT BUTTON
        ====================================================== */

    .edit-patient-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 17px;
        border-radius: 9px;
        border: none;
        background: linear-gradient(135deg, #8b5cf6, #a855f7);
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 5px 14px rgba(139, 92, 246, 0.18);
        transition: 0.2s ease;
        text-decoration: none;
    }

        .edit-patient-btn:hover {
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            color: #ffffff;
            transform: translateY(-1px);
        }


    /* =====================================================
           INFORMATION GRID
        ====================================================== */

    .patient-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }


    /* =====================================================
           INFORMATION FIELD
        ====================================================== */

    .detail-field {
        min-width: 0;
    }

    .detail-field-full {
        grid-column: 1 / -1;
    }

    .detail-label {
        display: block;
        margin-bottom: 7px;
        color: #514b61;
        font-size: 12px;
        font-weight: 700;
    }


    /* =====================================================
           INFORMATION VALUE
        ====================================================== */

    .detail-value {
        min-height: 42px;
        display: flex;
        align-items: center;
        width: 100%;
        padding: 0 12px;
        background: #ffffff;
        color: #29243a;
        border: 1px solid #e1ddea;
        border-radius: 9px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        font-weight: 500;
    }

        .detail-value.multiline {
            min-height: 90px;
            align-items: flex-start;
            padding-top: 11px;
            padding-bottom: 11px;
            line-height: 1.5;
            white-space: pre-wrap;
        }


    /* =====================================================
           PATIENT ID VALUE
        ====================================================== */

    .patient-code-value {
        color: #29243a;
        font-weight: 700;
    }


    /* =====================================================
           RESPONSIVE
        ====================================================== */

    @@media (max-width: 800px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .details-card {
            padding: 20px;
        }

        .details-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .patient-details-grid {
            grid-template-columns: 1fr;
        }

        .detail-field-full {
            grid-column: auto;
        }

        .edit-patient-btn {
            width: 100%;
        }
    }

</style>


<!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Patient Details
        </h1>

        <p>
            View complete patient information.
        </p>

    </div>


    <!-- BACK -->

    <a asp-area="Receptionist"
       asp-controller="Patients"
       asp-action="Index"
       class="back-btn">

        <i class="bi bi-arrow-left"></i>

        Back to Patients

    </a>

</div>


<!-- =====================================================
     DETAILS CARD
====================================================== -->

<div class="details-card">


    <!-- =================================================
         CARD HEADER
    ================================================== -->

    <div class="details-card-header">

        <div class="patient-title">

            <div class="patient-avatar-large">

                <i class="bi bi-person-fill"></i>

            </div>

            <div>

                <h2>
                    @Model.FirstName @Model.LastName
                </h2>

                <span>
                    Patient ID:
                    @(string.IsNullOrWhiteSpace(Model.PatientCode)
                        ? "N/A"
                        : Model.PatientCode)
                </span>

            </div>

        </div>


        <!-- EDIT -->

        <a asp-area="Receptionist"
           asp-controller="Patients"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="edit-patient-btn">

            <i class="bi bi-pencil"></i>

            Edit Patient

        </a>

    </div>


    <!-- =================================================
         PATIENT INFORMATION
    ================================================== -->

    <div class="patient-details-grid">


        <!-- PATIENT ID -->

        <div class="detail-field">

            <label class="detail-label">
                Patient ID
            </label>

            <div class="detail-value patient-code-value">

                @(string.IsNullOrWhiteSpace(Model.PatientCode)
                    ? "Not provided"
                    : Model.PatientCode)

            </div>

        </div>


        <!-- FULL NAME -->

        <div class="detail-field">

            <label class="detail-label">
                Full Name
            </label>

            <div class="detail-value">

                @Model.FirstName @Model.LastName

            </div>

        </div>


        <!-- PHONE -->

        <div class="detail-field">

            <label class="detail-label">
                Phone Number
            </label>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.Phone)
                    ? "Not provided"
                    : Model.Phone)

            </div>

        </div>


        <!-- EMAIL -->

        <div class="detail-field">

            <label class="detail-label">
                Email
            </label>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.Email)
                    ? "Not provided"
                    : Model.Email)

            </div>

        </div>


        <!-- DATE OF BIRTH -->

        <div class="detail-field">

            <label class="detail-label">
                Date of Birth
            </label>

            <div class="detail-value">

                @if (Model.DateOfBirth.HasValue)
                {
                    @Model.DateOfBirth.Value.ToString("dd MMM yyyy")
                }
                else
                {
                    @:Not provided
                }

            </div>

        </div>


        <!-- GENDER -->

        <div class="detail-field">

            <label class="detail-label">
                Gender
            </label>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.Gender)
                    ? "Not provided"
                    : Model.Gender)

            </div>

        </div>


        <!-- BLOOD GROUP -->

        <div class="detail-field">

            <label class="detail-label">
                Blood Group
            </label>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.BloodGroup)
                    ? "Not provided"
                    : Model.BloodGroup)

            </div>

        </div>


        <!-- RELIGION -->

        <div class="detail-field">

            <label class="detail-label">
                Religion
            </label>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.Religion)
                    ? "Not provided"
                    : Model.Religion)

            </div>

        </div>


        <!-- MARITAL STATUS -->

        <div class="detail-field">

            <label class="detail-label">
                Marital Status
            </label>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.MaritalStatus)
                    ? "Not provided"
                    : Model.MaritalStatus)

            </div>

        </div>


        <!-- NID -->

        <div class="detail-field">

            <label class="detail-label">
                NID Number
            </label>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.NID)
                    ? "Not provided"
                    : Model.NID)

            </div>

        </div>


        <!-- FATHER NAME -->

        <div class="detail-field">

            <label class="detail-label">
                Father's Name
            </label>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.FatherName)
                    ? "Not provided"
                    : Model.FatherName)

            </div>

        </div>


        <!-- MOTHER NAME -->

        <div class="detail-field">

            <label class="detail-label">
                Mother's Name
            </label>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.MotherName)
                    ? "Not provided"
                    : Model.MotherName)

            </div>

        </div>


        <!-- OCCUPATION -->

        <div class="detail-field">

            <label class="detail-label">
                Occupation
            </label>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.Occupation)
                    ? "Not provided"
                    : Model.Occupation)

            </div>

        </div>


        <!-- CREATED AT -->

        <div class="detail-field">

            <label class="detail-label">
                Date of Registration
            </label>

            <div class="detail-value">

                @if (Model.CreatedAt.HasValue)
                {
                    @Model.CreatedAt.Value.ToString("dd MMM yyyy hh:mm tt")
                }
                else
                {
                    @:Not provided
                }

            </div>

        </div>


        <!-- ADDRESS -->

        <div class="detail-field detail-field-full">

            <label class="detail-label">
                Address
            </label>

            <div class="detail-value multiline">

                @(string.IsNullOrWhiteSpace(Model.Address)
                    ? "Not provided"
                    : Model.Address)

            </div>

        </div>

    </div>

</div>