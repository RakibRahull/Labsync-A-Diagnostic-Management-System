@model LabSync.Models.Patient

@{
    ViewData["Title"] = "Delete Patient";
    Layout = "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";

    string patientName =
        (Model.FirstName ?? "") + " " + (Model.LastName ?? "");

    patientName = patientName.Trim();

    if (string.IsNullOrWhiteSpace(patientName))
    {
        patientName = "N/A";
    }

    string patientCode = Model.PatientCode ?? "N/A";
    string patientPhone = Model.Phone ?? "N/A";
    string patientEmail = Model.Email ?? "N/A";
    string patientAddress = Model.Address ?? "N/A";

    string cityId = Convert.ToString(Model.CityId) ?? "N/A";

    string dateOfBirth = "N/A";
    if (Model.DateOfBirth.HasValue)
    {
        dateOfBirth = Model.DateOfBirth.Value
            .ToString("dd MMM yyyy");
    }

    string gender = Model.Gender ?? "N/A";
    string religion = Model.Religion ?? "N/A";
    string maritalStatus = Model.MaritalStatus ?? "N/A";
    string bloodGroup = Model.BloodGroup ?? "N/A";
    string fatherName = Model.FatherName ?? "N/A";
    string motherName = Model.MotherName ?? "N/A";
    string nid = Model.NID ?? "N/A";
    string occupation = Model.Occupation ?? "N/A";

    string createdDate = "N/A";
    if (Model.CreatedAt.HasValue)
    {
        createdDate = Model.CreatedAt.Value
            .ToString("dd MMM yyyy hh:mm tt");
    }
}

<style>

    /* =========================================================
           GLOBAL
        ========================================================== */

    * {
        box-sizing: border-box;
    }

    body {
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f7fc;
        color: #000000;
    }


    /* =========================================================
           PAGE HEADER
        ========================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }

    .page-header-left p {
        margin: 8px 0 0;
        color: #000000;
        font-size: 14px;
    }


    /* =========================================================
           MAIN CARD
        ========================================================== */

    .delete-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(30, 20, 50, .04);
    }


    /* =========================================================
           WARNING
        ========================================================== */

    .warning-box {
        padding: 16px 18px;
        margin-bottom: 28px;
        background: #fff8f8;
        border: 1px solid #f0d7d7;
        border-left: 4px solid #dc2626;
        border-radius: 10px;
    }

    .warning-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #b91c1c;
        font-size: 14px;
        font-weight: 700;
    }

        .warning-title i {
            font-size: 15px;
        }

    .warning-box p {
        margin: 7px 0 0;
        color: #777080;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================================
           SECTION HEADER
        ========================================================== */

    .section-header {
        margin-bottom: 10px;
    }

        .section-header h2 {
            margin: 0;
            color: #18213a;
            font-size: 19px;
            font-weight: 700;
        }

        .section-header p {
            margin: 5px 0 0;
            color: #9296aa;
            font-size: 13px;
        }

    .section-line {
        width: 100%;
        height: 1px;
        background: #ece9f2;
        margin-bottom: 20px;
    }

    .section-space {
        margin-top: 30px;
    }


    /* =========================================================
           INFORMATION GRID
        ========================================================== */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .info-box {
        min-height: 76px;
        padding: 14px;
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 10px;
    }

        .info-box span {
            display: block;
            margin-bottom: 7px;
            color: #9296aa;
            font-size: 11px;
            font-weight: 500;
        }

        .info-box strong {
            display: block;
            color: #000000;
            font-size: 14px;
            font-weight: 600;
            word-break: break-word;
        }


    /* =========================================================
           PATIENT CODE HIGHLIGHT
        ========================================================== */

    .patient-code-highlight {
        background: #faf7ff;
        border-color: #d9cdf6;
    }

        .patient-code-highlight strong {
            color: #8b5cf6;
            font-size: 17px;
        }


    /* =========================================================
           NID
        ========================================================== */

    .nid-value {
        font-family: Consolas, "Courier New", monospace;
        font-size: 13px !important;
    }


    /* =========================================================
           ACTIONS
        ========================================================== */

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #ece9f2;
        flex-wrap: wrap;
    }


    /* =========================================================
           SECONDARY BUTTON
        ========================================================== */

    .btn-secondary {
        min-height: 43px;
        padding: 0 18px;
        border: 1px solid #ddd9e7;
        border-radius: 9px;
        background: #ffffff;
        color: #000000;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: .2s ease;
    }

        .btn-secondary:hover {
            background: #f8f6fb;
            color: #000000;
        }


    /* =========================================================
           DELETE BUTTON
        ========================================================== */

    .btn-danger {
        min-height: 43px;
        padding: 0 18px;
        border: 1px solid #ffd9de;
        border-radius: 9px;
        background: #fff1f2;
        color: #dc2626;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        cursor: pointer;
        transition: .2s ease;
    }

        .btn-danger:hover {
            background: #ffe4e8;
            color: #b91c1c;
        }


    /* =========================================================
           RESPONSIVE
        ========================================================== */

    @@media (max-width: 950px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .info-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {

        .delete-card {
            padding: 20px;
        }

        .page-header-left h1 {
            font-size: 26px;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }

            .form-actions a,
            .form-actions button {
                width: 100%;
            }
    }

</style>


<!-- =========================================================
     PAGE HEADER
========================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Delete Patient
        </h1>

        <p>
            Remove this patient from the system.
        </p>

    </div>

    <a asp-area="Receptionist"
       asp-controller="Patients"
       asp-action="Index"
       class="btn-secondary">

        <i class="bi bi-arrow-left"></i>

        Back to Patients

    </a>

</div>


<!-- =========================================================
     MAIN CARD
========================================================== -->

<div class="delete-card">


    <!-- =====================================================
         WARNING
    ====================================================== -->

    <div class="warning-box">

        <div class="warning-title">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <span>
                Are you sure you want to delete this patient?
            </span>

        </div>

        <p>
            This action cannot be undone. The patient's information
            will be permanently removed from the system. Make sure
            this patient has no related records that prevent deletion.
        </p>

    </div>


    <!-- =====================================================
         PATIENT INFORMATION
    ====================================================== -->

    <div class="section-header">

        <h2>
            Patient Information
        </h2>

        <p>
            Patient details that will be permanently removed.
        </p>

    </div>

    <div class="section-line"></div>


    <div class="info-grid">

        <div class="info-box">
            <span>Patient ID</span>
            <strong>@Model.Id</strong>
        </div>

        <div class="info-box patient-code-highlight">
            <span>Patient Code</span>
            <strong>@patientCode</strong>
        </div>

        <div class="info-box">
            <span>Patient Name</span>
            <strong>@patientName</strong>
        </div>

        <div class="info-box">
            <span>Phone</span>
            <strong>@patientPhone</strong>
        </div>

        <div class="info-box">
            <span>Email</span>
            <strong>@patientEmail</strong>
        </div>

        <div class="info-box">
            <span>Date of Birth</span>
            <strong>@dateOfBirth</strong>
        </div>

        <div class="info-box">
            <span>Gender</span>
            <strong>@gender</strong>
        </div>

        <div class="info-box">
            <span>Blood Group</span>
            <strong>@bloodGroup</strong>
        </div>

        <div class="info-box">
            <span>Marital Status</span>
            <strong>@maritalStatus</strong>
        </div>

        <div class="info-box">
            <span>Religion</span>
            <strong>@religion</strong>
        </div>

        <div class="info-box">
            <span>Address</span>
            <strong>@patientAddress</strong>
        </div>

    </div>


    <!-- =====================================================
         ADDITIONAL INFORMATION
    ====================================================== -->

    <div class="section-header section-space">

        <h2>
            Additional Information
        </h2>

        <p>
            Other personal details associated with this patient.
        </p>

    </div>

    <div class="section-line"></div>


    <div class="info-grid">

        <div class="info-box">
            <span>Father's Name</span>
            <strong>@fatherName</strong>
        </div>

        <div class="info-box">
            <span>Mother's Name</span>
            <strong>@motherName</strong>
        </div>

        <div class="info-box">
            <span>NID</span>
            <strong class="nid-value">@nid</strong>
        </div>

        <div class="info-box">
            <span>Occupation</span>
            <strong>@occupation</strong>
        </div>

        <div class="info-box">
            <span>Created Date</span>
            <strong>@createdDate</strong>
        </div>

    </div>


    <!-- =====================================================
         ACTIONS
    ====================================================== -->

    <form asp-area="Receptionist"
          asp-controller="Patients"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.Id" />

        <div class="form-actions">

            <!-- CANCEL -->

            <a asp-area="Receptionist"
               asp-controller="Patients"
               asp-action="Index"
               class="btn-secondary">

                Cancel

            </a>


            <!-- DELETE -->

            <button type="submit"
                    class="btn-danger">

                <i class="bi bi-trash"></i>

                Yes, Delete Patient

            </button>

        </div>

    </form>

</div>