@model IEnumerable<LabSync.Models.Patient>

@{
    ViewData["Title"] = "Patients";
    Layout = "~/Areas/Receptionist/Views/Shared/_ReceptionistLayout.cshtml";

    var selectedPatientId =
        ViewBag.PatientId?.ToString() ?? "";

    var selectedRegistrationDate =
        ViewBag.RegistrationDate?.ToString() ?? "";
}

<style>

    /* =====================================================
           PAGE HEADER
        ====================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left small {
        display: block;
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .page-header-left h1 {
        margin: 0;
        color: #18213a;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;
    }

    .page-header-left p {
        margin: 8px 0 0;
        color: #9296aa;
        font-size: 14px;
    }


    /* =====================================================
           ADD PATIENT BUTTON
        ====================================================== */

    .add-patient-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 10px;
        background: linear-gradient(135deg, #8b5cf6, #a855f7);
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        border: none;
        box-shadow: 0 7px 18px rgba(139, 92, 246, 0.22);
        transition: 0.2s ease;
        text-decoration: none;
    }

        .add-patient-btn:hover {
            color: #ffffff;
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            transform: translateY(-1px);
        }


    /* =====================================================
           SUCCESS MESSAGE
        ====================================================== */

    .success-message {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #eaf8f0;
        border: 1px solid #ccefdc;
        color: #198754;
        padding: 13px 16px;
        border-radius: 11px;
        margin-bottom: 22px;
        font-size: 14px;
        font-weight: 500;
    }

        .success-message i {
            font-size: 17px;
        }


    /* =====================================================
           FILTER CARD
        ====================================================== */

    .filter-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 20px 22px;
        margin-bottom: 22px;
        box-shadow: 0 5px 18px rgba(30, 20, 50, 0.04);
    }

    .filter-header {
        margin-bottom: 16px;
    }

        .filter-header h5 {
            margin: 0;
            color: #29243a;
            font-size: 16px;
            font-weight: 700;
        }


    /* =====================================================
           FILTER FORM
        ====================================================== */

    .patient-filter-form {
        display: flex;
        align-items: end;
        gap: 14px;
        flex-wrap: wrap;
    }

    .filter-field {
        flex: 1;
        min-width: 220px;
    }

    .filter-label {
        display: block;
        margin-bottom: 7px;
        color: #514b61;
        font-size: 12px;
        font-weight: 700;
    }

    .filter-input {
        width: 100%;
        height: 42px;
        padding: 0 12px;
        background: #ffffff;
        color: #29243a;
        border: 1px solid #e1ddea;
        border-radius: 9px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        outline: none;
        transition: 0.2s ease;
    }

        .filter-input:focus {
            border-color: #a78bfa;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.10);
        }

        .filter-input::placeholder {
            color: #aaa4b5;
        }

    input[type="date"].filter-input {
        cursor: pointer;
    }

        input[type="date"].filter-input::-webkit-calendar-picker-indicator {
            cursor: pointer;
            opacity: 0.75;
        }


    /* =====================================================
           FILTER BUTTONS
        ====================================================== */

    .filter-buttons {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .search-btn {
        height: 42px;
        padding: 0 17px;
        border: none;
        border-radius: 9px;
        background: linear-gradient(135deg, #8b5cf6, #a855f7);
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        box-shadow: 0 5px 14px rgba(139, 92, 246, 0.18);
        transition: 0.2s ease;
    }

        .search-btn:hover {
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            color: #ffffff;
        }

    .clear-btn {
        height: 42px;
        padding: 0 16px;
        border: 1px solid #ded8e8;
        border-radius: 9px;
        background: #ffffff;
        color: #514b61;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: 0.2s ease;
        text-decoration: none;
    }

        .clear-btn:hover {
            background: #f8f6fc;
            border-color: #cfc7dc;
            color: #29243a;
        }


    /* =====================================================
           PATIENT CARD
        ====================================================== */

    .patients-card {
        background: #ffffff;
        border: 1px solid #e8e5ef;
        border-radius: 15px;
        padding: 24px;
        box-shadow: 0 5px 18px rgba(30, 20, 50, 0.04);
    }


    /* =====================================================
           CARD HEADER
        ====================================================== */

    .patients-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

    .patients-card-header-left h2 {
        margin: 0;
        color: #29243a;
        font-size: 20px;
        font-weight: 700;
    }

    .patients-card-header-left span {
        display: block;
        margin-top: 5px;
        color: #9993a8;
        font-size: 12px;
    }

    .total-patients {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 0 13px;
        background: #f5efff;
        color: #7c3aed;
        border: 1px solid #eadcff;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =====================================================
           TABLE
        ====================================================== */

    .patients-table-wrapper {
        overflow-x: auto;
    }

    .patients-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .patients-table thead th {
            background: #faf9fd;
            color: #29243a;
            border-top: 1px solid #eeeaf5;
            border-bottom: 1px solid #eeeaf5;
            padding: 13px 14px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

            .patients-table thead th:first-child {
                border-top-left-radius: 10px;
                border-left: 1px solid #eeeaf5;
            }

            .patients-table thead th:last-child {
                border-top-right-radius: 10px;
                border-right: 1px solid #eeeaf5;
            }

        .patients-table tbody td {
            color: #29243a;
            border-bottom: 1px solid #f0edf5;
            padding: 15px 14px;
            font-size: 13px;
            vertical-align: middle;
            white-space: nowrap;
        }

        .patients-table tbody tr:last-child td {
            border-bottom: none;
        }

        .patients-table tbody tr {
            transition: background 0.2s ease;
        }

            .patients-table tbody tr:hover {
                background: #fbfaff;
            }


    /* =====================================================
           PATIENT ID
        ====================================================== */

    .patient-id {
        color: #29243a !important;
        font-size: 13px;
        font-weight: 700;
    }


    /* =====================================================
           PATIENT NAME
        ====================================================== */

    .patient-name {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .patient-name strong {
            color: #29243a !important;
            font-size: 13px;
            font-weight: 700;
        }


    /* =====================================================
           PATIENT DATA
        ====================================================== */

    .patient-data {
        color: #29243a !important;
        font-size: 13px;
        font-weight: 500;
    }

    .muted-text {
        color: #29243a !important;
        font-size: 13px;
        font-weight: 500;
    }


    /* =====================================================
           ACTIONS
        ====================================================== */

    .patient-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        transition: 0.2s ease;
        font-size: 14px;
        text-decoration: none;
    }


    /* DETAILS */

    .action-view {
        background: #f1eaff;
        color: #7c3aed;
        border-color: #e5d9ff;
    }

        .action-view:hover {
            background: #e4d7ff;
            color: #6d28d9;
        }


    /* EDIT */

    .action-edit {
        background: #eef5ff;
        color: #4f46e5;
        border-color: #dce8ff;
    }

        .action-edit:hover {
            background: #dfeaff;
            color: #4338ca;
        }


    /* =====================================================
           APPOINTMENT BUTTON
        ====================================================== */

    .action-appointment {
        background: #ecfdf5;
        color: #059669;
        border-color: #d1fae5;
    }

        .action-appointment:hover {
            background: #d1fae5;
            color: #047857;
            transform: translateY(-1px);
        }


    /* =====================================================
           EMPTY STATE
        ====================================================== */

    .empty-state {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 14px;
        border-radius: 14px;
        background: #f5efff;
        color: #8b5cf6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .empty-state h5 {
        margin: 0;
        color: #29243a;
        font-size: 16px;
        font-weight: 700;
    }

    .empty-state p {
        margin: 6px 0 0;
        color: #29243a;
        font-size: 13px;
    }


    /* =====================================================
           RESPONSIVE
        ====================================================== */

    @@media (max-width: 900px) {

        .patient-filter-form {
            align-items: stretch;
            flex-direction: column;
        }

        .filter-field {
            min-width: 100%;
        }

        .filter-buttons {
            width: 100%;
        }

        .search-btn,
        .clear-btn {
            flex: 1;
        }
    }


    @@media (max-width: 800px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .patients-card {
            padding: 18px;
        }

        .patients-card-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }

</style>


<!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="page-header">

    <div class="page-header-left">

        <small>
            Receptionist Panel
        </small>

        <h1>
            Patients
        </h1>

        <p>
            Manage all registered patients.
        </p>

    </div>


    <a asp-area="Receptionist"
       asp-controller="Patients"
       asp-action="Create"
       class="add-patient-btn">

        <i class="bi bi-person-plus-fill"></i>

        Add Patient

    </a>

</div>


<!-- =====================================================
     SUCCESS MESSAGE
====================================================== -->
@if (TempData["Success"] != null)
{
    <div class="success-message">

        <i class="bi bi-check-circle-fill"></i>

        <span>
            @TempData["Success"]
        </span>

    </div>
}


<!-- =====================================================
     ERROR MESSAGE
====================================================== -->
@if (TempData["Error"] != null)
{
    <div class="success-message"
         style="background:#fff1f2;border-color:#ffe0e3;color:#dc2626;">

        <i class="bi bi-exclamation-circle-fill"></i>

        <span>
            @TempData["Error"]
        </span>

    </div>
}


<!-- =====================================================
     SEARCH / FILTER
====================================================== -->

<div class="filter-card">

    <div class="filter-header">

        <h5>
            Search Patients
        </h5>

    </div>


    <form asp-area="Receptionist"
          asp-controller="Patients"
          asp-action="Index"
          method="get"
          class="patient-filter-form">

        <!-- PATIENT ID -->

        <div class="filter-field">

            <label class="filter-label"
                   for="patientId">

                Patient ID

            </label>

            <input type="text"
                   id="patientId"
                   name="patientId"
                   class="filter-input"
                   value="@selectedPatientId"
                   placeholder="Example: PAT13"
                   autocomplete="off" />

        </div>


        <!-- REGISTRATION DATE -->

        <div class="filter-field">

            <label class="filter-label"
                   for="registrationDate">

                Date of Registration

            </label>

            <input type="date"
                   id="registrationDate"
                   name="registrationDate"
                   class="filter-input"
                   value="@selectedRegistrationDate" />

        </div>


        <!-- BUTTONS -->

        <div class="filter-buttons">

            <button type="submit"
                    class="search-btn">

                <i class="bi bi-search"></i>

                Search

            </button>


            <a asp-area="Receptionist"
               asp-controller="Patients"
               asp-action="Index"
               class="clear-btn">

                <i class="bi bi-arrow-counterclockwise"></i>

                Clear

            </a>

        </div>

    </form>

</div>


<!-- =====================================================
     PATIENT LIST
====================================================== -->

<div class="patients-card">

    <div class="patients-card-header">

        <div class="patients-card-header-left">

            <h2>
                Patient List
            </h2>

            <span>
                All registered patients
            </span>

        </div>


        <div class="total-patients">

            Total: @Model.Count()

        </div>

    </div>


    <div class="patients-table-wrapper">

        <table class="patients-table">

            <thead>

                <tr>

                    <th>
                        Patient ID
                    </th>

                    <th>
                        Patient Name
                    </th>

                    <th>
                        Phone
                    </th>

                    <th>
                        Gender
                    </th>

                    <th>
                        Date of Birth
                    </th>

                    <th>
                        Date of Registration
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Any())
                {

                    foreach (var patient in Model)
                    {

                        <tr>

                            <!-- PATIENT CODE -->

                            <td>

                                <span class="patient-id">

                                    @patient.PatientCode

                                </span>

                            </td>


                            <!-- PATIENT NAME -->

                            <td>

                                <div class="patient-name">

                                    <strong>

                                        @patient.FirstName
                                        @patient.LastName

                                    </strong>

                                </div>

                            </td>


                            <!-- PHONE -->

                            <td>

                                @if (string.IsNullOrWhiteSpace(patient.Phone))
                                {
                                    <span class="muted-text">
                                        N/A
                                    </span>
                                }
                                else
                                {
                                    <span class="patient-data">
                                        @patient.Phone
                                    </span>
                                }

                            </td>


                            <!-- GENDER -->

                            <td>

                                @if (string.IsNullOrWhiteSpace(patient.Gender))
                                {
                                    <span class="muted-text">
                                        N/A
                                    </span>
                                }
                                else
                                {
                                    <span class="patient-data">
                                        @patient.Gender
                                    </span>
                                }

                            </td>


                            <!-- DATE OF BIRTH -->

                            <td>

                                @if (patient.DateOfBirth.HasValue)
                                {
                                    <span class="patient-data">

                                        @patient.DateOfBirth.Value.ToString("dd MMM yyyy")

                                    </span>
                                }
                                else
                                {
                                    <span class="muted-text">
                                        N/A
                                    </span>
                                }

                            </td>


                            <!-- DATE OF REGISTRATION -->

                            <td>

                                @if (patient.CreatedAt.HasValue)
                                {
                                    <span class="patient-data">

                                        @patient.CreatedAt.Value.ToString("dd MMM yyyy")

                                    </span>
                                }
                                else
                                {
                                    <span class="muted-text">
                                        N/A
                                    </span>
                                }

                            </td>


                            <!-- =================================================
                                 ACTIONS
                            ================================================== -->

                            <td>

                                <div class="patient-actions">


                                    <!-- DETAILS -->

                                    <a asp-area="Receptionist"
                                       asp-controller="Patients"
                                       asp-action="Details"
                                       asp-route-id="@patient.Id"
                                       class="action-btn action-view"
                                       title="Details">

                                        <i class="bi bi-eye"></i>

                                    </a>


                                    <!-- EDIT -->

                                    <a asp-area="Receptionist"
                                       asp-controller="Patients"
                                       asp-action="Edit"
                                       asp-route-id="@patient.Id"
                                       class="action-btn action-edit"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>


                                    <!-- =================================================
                                         APPOINTMENT
                                         PatientCode automatically sent
                                    ================================================== -->

                                    <a asp-area="Receptionist"
                                       asp-controller="Appointments"
                                       asp-action="Create"
                                       asp-route-patientCode="@patient.PatientCode"
                                       class="action-btn action-appointment"
                                       title="Create Appointment">

                                        <i class="bi bi-calendar-plus"></i>

                                    </a>


                                </div>

                            </td>

                        </tr>

                    }

                }
                else
                {

                    <tr>

                        <td colspan="7">

                            <div class="empty-state">

                                <div class="empty-icon">

                                    <i class="bi bi-person-x"></i>

                                </div>

                                <h5>
                                    No patients found
                                </h5>

                                <p>
                                    No patient matches the selected search criteria.
                                </p>

                            </div>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

</div>